diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
new file mode 100644
index 00000000..c0f66eeb
--- /dev/null
+++ b/.github/workflows/post-merge.yml
@@ -0,0 +1,24 @@
+---
+# Post-merge settlement for the hot merge tier: the shared workflow re-runs
+# the gate on HEAD over the commits the green ref has not settled,
+# fast-forwards green when everything is verified, and reverts deferred pull
+# requests whose post-merge checks went red. Queue and pull request runs
+# report through ci-gate.yml; this workflow owns the develop-branch pushes.
+name: Post Merge
+on:
+  push:
+    branches: [develop]
+permissions: {}
+jobs:
+  post-merge:
+    permissions:
+      contents: write    # green ref moves, post-merge-red dispatches
+      pull-requests: write
+      checks: read       # AI Merge Gate verdicts on the head commits
+      actions: read      # the gate's run report reads this run's jobs
+    uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+    with:
+      profile: ansible   # the caller's gate stack, forwarded verbatim
+    secrets:
+      GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+      slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
