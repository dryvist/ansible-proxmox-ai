{# Extracted from add_lxc_host_inventory.yml to keep the tag projection focused. #}
{{ (
        ['lxc_containers', 'all'] +
        (
          ['managed_secrets_group']
          if 'managed-secrets' in (item.value.tags | default([]))
             or 'llm-gpu-classify' in (item.value.tags | default([]))
             or (item.key | default('')) in _ai_agent_by_container
          else []
        ) +
        (['nvidia_gpu_group'] if 'nvidia-gpu' in (item.value.tags | default([]))
         or 'llm-gpu-small-router' in (item.value.tags | default([])) else []) +
        (
          ['qdrant_group']
          if 'vectordb' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['hindsight_group']
          if 'hindsight' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llamaindex_group']
          if 'rag' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['ollama_group']
          if 'ollama' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['open_webui_group']
          if 'open-webui' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['hermes_agent_group']
          if (item.key | default('')) in _ai_agent_by_container
             or (item.value.tags | default([])) | intersect(['hermes-agent', 'hermes-donna'])
          else []
        ) +
        (
          ['llm_fast_group']
          if 'llm-fast' in (item.value.tags | default([]))
          and (item.value.tags | default([])) | intersect(['llm-vllm', 'llm-gpu-small']) | length == 0
          and 'llm-gpu' not in (item.value.tags | default([]))
          and (item.value.tags | default([])) | intersect(_llm_cpu_pool_tags | default([])) | length == 0
          else []
        ) +
        (
          ['llm_cpu_pool_group']
          if (item.value.tags | default([]))
             | intersect(_llm_cpu_pool_tags | default([]))
             | length > 0
          else []
        ) +
        (
          ['llm_cpu_moe_group']
          if _llm_cpu_moe_tag is defined
          and _llm_cpu_moe_tag in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_cpu_9b_group']
          if _llm_cpu_9b_tag is defined
          and _llm_cpu_9b_tag in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_vllm_group']
          if 'llm-vllm' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_classify']
          if 'llm-gpu-classify' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_gpu_legacy_group', 'llm_gpu_group']
          if 'llm-gpu' in (item.value.tags | default([]))
             and not load_tofu_gpu_engine_set_present | bool
          else []
        ) +
        (
          ['llm_gpu_legacy_group']
          if 'llm-gpu-small' in (item.value.tags | default([]))
             and not load_tofu_gpu_engine_set_present | bool
          else []
        ) +
        (
          ['llm_gpu_legacy_group', 'llm_gpu_group']
          if 'llm-gpu-small-router' in (item.value.tags | default([]))
             and not load_tofu_gpu_engine_set_present | bool
          else []
        ) +
        (
          ['llm_gpu_engine_llama_cpp_group']
          if item.value.llm_gpu_engine_identity | default('') == 'llama_cpp'
          else []
        ) +
        (
          ['llm_gpu_engine_vllm_group']
          if item.value.llm_gpu_engine_identity | default('') == 'vllm'
          else []
        ) +
        (
          ['llm_gpu_engine_sglang_group']
          if item.value.llm_gpu_engine_identity | default('') == 'sglang'
          else []
        ) +
        (
          ['llm_gpu_engine_strata_group']
          if item.value.llm_gpu_engine_identity | default('') == 'strata'
          else []
        ) +
        (
          ['llm_gpu_serving_llama_cpp_group', 'llm_gpu_engine_llama_cpp_group', 'llm_gpu_group']
          if load_tofu_gpu_engine_set_present | bool
             and load_tofu_gpu_engine_selector == 'llama_cpp'
             and item.value.llm_gpu_engine_identity | default('') == 'llama_cpp'
          else []
        ) +
        (
          ['llm_gpu_serving_vllm_group', 'llm_gpu_engine_vllm_group', 'llm_gpu_group']
          if load_tofu_gpu_engine_set_present | bool
             and load_tofu_gpu_engine_selector == 'vllm'
             and item.value.llm_gpu_engine_identity | default('') == 'vllm'
          else []
        ) +
        (
          ['llm_gpu_serving_sglang_group', 'llm_gpu_engine_sglang_group', 'llm_gpu_group']
          if load_tofu_gpu_engine_set_present | bool
             and load_tofu_gpu_engine_selector == 'sglang'
             and item.value.llm_gpu_engine_identity | default('') == 'sglang'
          else []
        ) +
        (
          ['llm_gpu_serving_strata_group']
          if load_tofu_gpu_engine_set_present | bool
             and load_tofu_gpu_engine_selector == 'strata'
             and item.value.llm_gpu_engine_identity | default('') == 'strata'
          else []
        ) +
        (
          ['llm_model_store_writer_group']
          if (item.value.tags | default([])) | intersect(['llm-vllm', 'llm-gpu']) | length > 0
             and item.value.models_origin_mount_path | default('', true) | length > 0
             and not (item.value.models_origin_mount_read_only | default(true) | bool)
          else []
        ) +
        (
          ['llm_router_group']
          if 'llm-router' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_redis_group']
          if 'llm-redis' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['dify_group']
          if 'dify' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['langflow_group']
          if 'langflow' in (item.value.tags | default([]))
          else []
        ) +
        (
          (item.value.tags | default([]))
          | intersect(['sim-eval'])
          | map('regex_replace', '-eval$', '_eval_group') | list
        ) +
        (
          ['langgraph_group']
          if 'langgraph' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['agent_exec_group']
          if 'agent-exec' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['langfuse_group']
          if 'langfuse' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['phoenix_group']
          if 'phoenix' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['clickhouse_group']
          if 'clickhouse' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['agentgateway_group']
          if 'agentgateway' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['docling_serve_group']
          if 'docling-serve' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['crawl4ai_group']
          if 'crawl4ai' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['ai_orchestration_group']
          if 'ai-orchestration' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['ai_runner_group']
          if 'ai-runner' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['ai_agent_pool_group']
          if 'ai-proxied' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['squid_group']
          if 'squid' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['hermes_ui_group']
          if 'hermes-ui' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['herdr_group']
          if 'herdr' in (item.value.tags | default([]))
          and not (item.value.tags | default([]))
              | intersect(['herdr-ui'])
          else []
        ) +
        (
          ['herdr_ui_group']
          if 'herdr-ui' in (item.value.tags | default([]))
          else []
        ) +
        (
          ['llm_gpu_container_trial_group']
          if 'llm-container-trial' in (item.value.tags | default([]))
          else []
        )
) }}
