{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent platform role parameters",
  "description": "Role parameters keep prompt and system_prompt strings within five logical lines.",
  "$ref": "#/$defs/value",
  "$defs": {
    "value": {
      "properties": {
        "prompt": {
          "$ref": "#/$defs/shortPrompt"
        },
        "system_prompt": {
          "$ref": "#/$defs/shortPrompt"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "shortPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "not": {
          "pattern": "(?:[^\\n]*\\n){5}[^\\n]+|(?:[^\\n]*\\n){6}"
        }
      }
    }
  }
}
