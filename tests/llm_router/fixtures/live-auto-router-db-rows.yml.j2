---
# Sanitized /v2/model/info primary-capability row. Its route and upstream are
# rendered from the registry; database ids and connection metadata are omitted.
{% set _primary = llm_router_registry_enabled
   | selectattr('serving_role', 'defined')
   | selectattr('serving_role', 'equalto', 'primary') | first %}
llm_router_live_role_model_info_fixture:
  - model_name: {{ llm_router_primary_model | to_json }}
    litellm_params:
      model: {{ (_primary.provider ~ '/' ~ _primary.upstream_model_id) | to_json }}
