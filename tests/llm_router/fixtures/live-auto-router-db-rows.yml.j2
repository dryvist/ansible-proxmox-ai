---
# Sanitized /v2/model/info rows captured from a live router. The deployment
# names and tuning fields are retained; model ids are rendered from the
# registry, while database ids and connection metadata are omitted.
{% set _gpu_medium_a = llm_router_model_registry
  | selectattr('tier', 'equalto', 'gpu')
  | selectattr('profile', 'equalto', 'medium-a')
  | map(attribute='client_model_id') | first %}
llm_router_live_role_model_info_fixture:
  - model_name: cheap
    litellm_params:
      model: {{ (llm_router_hermes_virtual_models | map(attribute='litellm_model_name') | first) | to_json }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ llm_router_primary_model | to_json }}
          MEDIUM: {{ llm_router_primary_model | to_json }}
          COMPLEX: {{ _gpu_medium_a | to_json }}
          REASONING: {{ _gpu_medium_a | to_json }}
        default_model: {{ _gpu_medium_a | to_json }}
  - model_name: fast
    litellm_params:
      model: {{ (llm_router_hermes_virtual_models | map(attribute='litellm_model_name') | first) | to_json }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ llm_router_primary_model | to_json }}
          MEDIUM: {{ llm_router_primary_model | to_json }}
          COMPLEX: {{ _gpu_medium_a | to_json }}
          REASONING: {{ _gpu_medium_a | to_json }}
        default_model: {{ _gpu_medium_a | to_json }}
