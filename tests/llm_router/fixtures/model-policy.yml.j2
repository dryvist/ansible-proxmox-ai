{# Synthetic admission evidence for router rendering tests only. #}
version: 1
as_of: "{{ now(utc=true, fmt='%Y-%m-%d') }}"
max_age_days: 365
deny: []
_dossier_root: {{ ((template_fullpath | dirname) ~ '/../../llm_model_trial/fixtures/ansible') | to_json }}
models:
{% for model in llm_router_model_registry | unique(attribute='upstream_model_id') %}
  - id: {{ model.upstream_model_id | to_json }}
    upstream_id: {{ model.upstream_model_id | to_json }}
    upstream_created: "{{ now(utc=true, fmt='%Y-%m-%d') }}"
    dossier: ansible/roles/llm_model_catalog/files/dossiers/fixture.md
{% endfor %}
