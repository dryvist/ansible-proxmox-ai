#!/usr/bin/env bash
# Stands in for `docker` on PATH: only understands the one invocation
# login_with_reset.yml makes (`compose exec -T api flask reset-password`).
# Reads its stdin (email/new-password/confirm) without inspecting it, and
# touches RESET_INVOKED_MARKER plus (if set) LOGIN_OK_MARKER, so the test can
# tell the reset ran and the fake login server starts accepting the account.
set -euo pipefail
: "${RESET_INVOKED_MARKER:?RESET_INVOKED_MARKER unset}"
case "$*" in
  "compose exec -T api flask reset-password")
    cat >/dev/null
    touch "$RESET_INVOKED_MARKER"
    [ -z "${LOGIN_OK_MARKER:-}" ] || touch "$LOGIN_OK_MARKER"
    exit 0
    ;;
  *)
    echo "fixtures/docker (fake): unsupported invocation: $*" >&2
    exit 1
    ;;
esac
