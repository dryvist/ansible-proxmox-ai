# /etc/systemd/system/llm-gpu-serving-medium-a.service
#
# Ansible managed
#
[Unit]
Description=GPU model serving profile medium-a
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llm-gpu-serving
Group=llm-gpu-serving
WorkingDirectory=/var/lib/llm-gpu-serving
Environment=HF_HOME=/var/lib/llm-gpu-serving/.cache/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=CUDA_HOME=/usr/local/cuda-13.2
Environment=PATH=/usr/local/cuda-13.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
ExecStart=/opt/llm-gpu-serving/venv/bin/vllm serve {{ llm_gpu_serving_model_cache_path }}/nvidia/Qwen3.8-27B-NVFP4 \
  --host LISTEN_ADDRESS \
  --port 10434 \
  --served-model-name nvidia/Qwen3.8-27B-NVFP4 \
  --max-model-len 196608 \
  --max-num-seqs 8 \
  --gpu-memory-utilization 0.88 \
  --linear-backend b12x \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_xml \
  --reasoning-parser qwen3

[Install]
WantedBy=multi-user.target
