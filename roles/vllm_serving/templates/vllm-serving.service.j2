{{ ansible_managed | comment }}
[Unit]
Description=vLLM serving profile {{ vllm_serving_profile_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ nvidia_gpu_guest_user }}
Group={{ nvidia_gpu_guest_group }}
WorkingDirectory={{ nvidia_gpu_guest_data_dir }}
Environment=HF_HOME={{ nvidia_gpu_guest_hf_home }}
Environment=PYTHONPATH={{ vllm_serving_request_timing_dir }}
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=CUDA_HOME={{ nvidia_gpu_guest_cuda_home }}
{% if vllm_serving_profile.allow_long_max_model_len | default(false) %}
Environment=VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
{% endif %}
Environment=PATH={{ nvidia_gpu_guest_cuda_home }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
ExecStart={{ nvidia_gpu_guest_venv }}/bin/vllm serve {{ vllm_serving_profile_model_dir }} \
  --host {{ nvidia_gpu_guest_listen_host | default(ansible_facts.default_ipv4.address) }} \
  --port {{ vllm_serving_profile.port }} \
  --served-model-name {{ vllm_serving_profile_registry_model.upstream_model_id }} \
  --enable-request-id-headers \
  --middleware request_timing:RequestTimingMiddleware \
  --max-model-len {{ vllm_serving_profile.max_model_len }} \
  --max-num-seqs {{ vllm_serving_profile.max_num_seqs }} \
  --gpu-memory-utilization {{ vllm_serving_profile.gpu_memory_utilization }} \
{% if vllm_serving_profile.kv_cache_dtype is defined %}
  --kv-cache-dtype {{ vllm_serving_profile.kv_cache_dtype }} \
{% endif %}
{% if vllm_serving_profile.quantization is defined %}
  --quantization {{ vllm_serving_profile.quantization }} \
{% endif %}
{% if vllm_serving_profile.speculative_config is defined %}
{% set vllm_speculative_config = vllm_serving_profile.speculative_config %}
{% set vllm_profile_required_artifact_ids = vllm_serving_profile_registry_model.required_artifact_ids | default([]) %}
{% if vllm_profile_required_artifact_ids | length > 0 %}
{% set vllm_draft_artifact = nvidia_gpu_guest_artifacts_by_id[vllm_profile_required_artifact_ids[0]] %}
{% set vllm_draft_model_dir = nvidia_gpu_guest_model_cache_path ~ '/' ~ vllm_draft_artifact.hf_repo %}
{% set vllm_speculative_config = vllm_speculative_config | combine({'model': vllm_draft_model_dir}) %}
{% endif %}
  --speculative-config '{{ vllm_speculative_config | to_json }}' \
{% endif %}
{% if vllm_serving_profile.hf_overrides is defined %}
  --hf-overrides '{{ vllm_serving_profile.hf_overrides | to_json }}' \
{% endif %}
{% if vllm_serving_profile.kv_offloading_size is defined %}
  --kv-offloading-size {{ vllm_serving_profile.kv_offloading_size }} \
  --kv-offloading-backend {{ vllm_serving_profile.kv_offloading_backend | default('native') }} \
{% endif %}
{% if vllm_serving_profile.generation_config is defined %}
  --generation-config {{ vllm_serving_profile.generation_config }} \
{% endif %}
{% if vllm_serving_profile.sampling_params is defined %}
  --override-generation-config '{{ vllm_serving_profile.sampling_params | to_json }}' \
{% endif %}
{% if vllm_serving_profile.engram_config is defined %}
  --engram-config '{{ vllm_serving_profile.engram_config | to_json }}' \
{% endif %}
{% if vllm_serving_profile.enable_flashinfer_autotune is defined and not vllm_serving_profile.enable_flashinfer_autotune %}
  --no-enable-flashinfer-autotune \
{% endif %}
{% if vllm_serving_profile_registry_model.artifact.trust_remote_code | default(false) %}
  --trust-remote-code \
{% endif %}
{% if vllm_serving_profile.linear_backend == 'b12x' %}
  --linear-backend b12x \
{% endif %}
{% if vllm_serving_profile.moe_backend == 'b12x' %}
  --moe-backend b12x \
{% endif %}
{% if vllm_serving_profile_registry_model.artifact.quantization == 'BF16' %}
  --dtype bfloat16 \
{% endif %}
{% if vllm_serving_profile.enable_auto_tool_choice %}
  --enable-auto-tool-choice \
{% endif %}
{% set vllm_reasoning_parser_plugin = vllm_serving_profile_registry_model.artifact.reasoning_parser_plugin | default('') %}
{% if vllm_reasoning_parser_plugin | length > 0 %}
  --reasoning-parser-plugin {{ vllm_serving_profile_model_dir }}/{{ vllm_reasoning_parser_plugin }} \
{% endif %}
{% set vllm_tool_call_parser = vllm_serving_profile_registry_model.artifact.tool_call_parser | default(vllm_serving_profile.tool_call_parser) %}
{% if vllm_tool_call_parser | length > 0 %}
  --tool-call-parser {{ vllm_tool_call_parser }} \
{% endif %}
  --reasoning-parser {{ vllm_serving_profile_registry_model.artifact.reasoning_parser | default(vllm_serving_profile.reasoning_parser) | mandatory('reasoning_parser is required for vLLM profiles') }}

[Install]
WantedBy=multi-user.target
