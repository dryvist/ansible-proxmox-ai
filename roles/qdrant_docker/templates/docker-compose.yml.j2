---
# Ship stdout/stderr to journald with tag `qdrant` instead of the default
# json-file driver, which stays on local disk and never reaches the SIEM.
# Tag is a bare identifier (no ':' or whitespace) so rsyslog's syslog-header
# regex extracts it as $programname. The host's rsyslog forwarder
# (ansible-proxmox-apps) matches on that tag and forwards it, on this
# service's own port (tofu-proxmox constants), to this service's own
# dedicated Splunk index — one index per service, not a shared one.
x-logging: &qdrant_docker_logging
  driver: journald
  options:
    tag: qdrant

services:
  qdrant:
    image: {{ qdrant_docker_image }}
    container_name: {{ qdrant_docker_container_name }}
    restart: unless-stopped
    logging: *qdrant_docker_logging
    ports:
      - "{{ qdrant_docker_http_port }}:6333"
      - "{{ qdrant_docker_grpc_port }}:6334"
    volumes:
      - {{ qdrant_docker_data_dir }}/storage:/qdrant/storage
      - {{ qdrant_docker_data_dir }}/snapshots:/qdrant/snapshots
      - {{ qdrant_docker_data_dir }}/config/config.yaml:/qdrant/config/production.yaml:ro
    environment:
      QDRANT__SERVICE__API_KEY: "{{ qdrant_docker_api_key }}"
