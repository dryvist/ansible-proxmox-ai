[Unit]
Description=Queue model release trial proposals
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ (playbook_dir | dirname) | to_json }}
EnvironmentFile={{ llm_model_watch_environment_file }}
ExecStart={{ llm_model_watch_playbook_bin | to_json }} {{ (playbook_dir ~ '/llm-model-watch.yml') | to_json }} -e llm_model_watch_run=true -e @/etc/llm-model-watch.yml
TimeoutStartSec=3600
UMask=0077
