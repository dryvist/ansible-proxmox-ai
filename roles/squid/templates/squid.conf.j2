{{ ansible_managed | comment }}
# Minimal forward proxy for the AI agent plane — deliberately NOT the stock
# Debian squid.conf. Everything here is either a rule or a value the rule needs;
# there is no cache_dir, so squid caches in memory only and nothing an agent
# fetched survives a restart.

http_port {{ squid_port }}
visible_hostname {{ inventory_hostname }}

# Do not leak the internal client address to the external services below.
forwarded_for delete
via off

acl CONNECT method CONNECT
{% for port in squid_safe_ports %}
acl Safe_ports port {{ port }}
{% endfor %}
{% for port in squid_ssl_ports %}
acl SSL_ports port {{ port }}
{% endfor %}

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny manager

# --- Egress profiles ---------------------------------------------------------
# One ACL group per Proxmox firewall egress profile, keyed off the client's
# MAC address as the tofu inventory declares it for each member of that
# profile's inventory group — never hand-written here. Squid and its clients
# share one layer-2 segment, and the guest firewall's MAC filter keeps a guest
# from changing its MAC. A profile with no members in inventory emits no rule
# at all, so it falls through to the deny below.
{# Per-host profiles first: each isolated host gets its own ACL pair and is denied
   everything else before any shared profile can grant access. #}
{% for per_host in [true, false] %}
{% for profile, spec in squid_egress_profiles | dictsort if (spec.per_host | default(false)) == per_host %}
{% set member_sets = [] %}
{% if per_host %}
{% for host in groups[spec.group] | default([]) if host in hermes_agent_isolated_hosts %}
{% set _ = member_sets.append({'name': profile ~ '_' ~ (host | regex_replace('[^A-Za-z0-9]', '_')), 'hosts': [host],
     'domains': spec.domains | list + (lookup('vars', spec.domains_by_host)[host]
       | mandatory('Isolated host domains must be resolved by the squid role before rendering'))}) %}
{% endfor %}
{% else %}
{% set _ = member_sets.append({'name': profile, 'hosts': groups[spec.group] | default([]), 'domains': spec.domains | list}) %}
{% endif %}
{% for members in member_sets %}
{% set clients = members.hosts | map('extract', hostvars, 'container_mac') | reject('equalto', '') | list %}
{% if clients %}

acl {{ members.name }}_clients arp {{ clients | join(' ') }}
acl {{ members.name }}_domains dstdomain {{ members.domains | unique | join(' ') }}
http_access allow {{ members.name }}_clients {{ members.name }}_domains
{% if per_host %}
http_access deny {{ members.name }}_clients
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}

# Anything not matched above — unknown client, or a known client reaching for a
# hostname outside its allowlist.
http_access deny all
