# {{ ansible_managed }}
# herdr-hail environment. Mode 0600, owned by {{ herdr_hail_user }}.
#
# A Slack bot token is a live credential for a workspace; it never goes into
# the Nix store, which is world-readable, and never into a 0640 config file.
{% if herdr_hail_slack_bot_token | length > 0 %}
SLACK_BOT_TOKEN={{ herdr_hail_slack_bot_token }}
{% endif %}
{% if herdr_hail_slack_app_token | length > 0 %}
SLACK_APP_TOKEN={{ herdr_hail_slack_app_token }}
{% endif %}
{% if herdr_hail_slack_channel | length > 0 %}
SLACK_CHANNEL={{ herdr_hail_slack_channel }}
{% endif %}
{% if herdr_hail_slack_allowed_users | length > 0 %}
SLACK_ALLOWED_USERS={{ herdr_hail_slack_allowed_users }}
{% endif %}
HERDR_SOCKET={{ herdr_hail_socket_path }}
{% for key, value in (herdr_hail_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
