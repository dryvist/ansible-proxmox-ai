{{ ansible_managed | comment }}
[Unit]
Description=Laya System One classifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ laya_systemone_user }}
Group={{ laya_systemone_group }}
WorkingDirectory={{ nvidia_gpu_guest_data_dir }}
Environment=HF_HOME={{ nvidia_gpu_guest_hf_home }}
Environment=LAYA_HOST={{ laya_systemone_listen_host }}
Environment=LAYA_PORT={{ laya_systemone_port }}
Environment=LAYA_DEVICE=cuda
Environment=LAYA_PRELOAD=1
Environment=LAYA_MODELS=english
Environment=LAYA_DEFAULT_MODEL=english
Environment=LAYA_REVISION={{ laya_systemone_revision }}
Environment=LAYA_MAX_LOADED={{ laya_systemone_max_loaded }}
Environment=LAYA_MAX_TOKEN_BUDGET={{ laya_systemone_max_token_budget }}
EnvironmentFile={{ laya_systemone_env_file }}
ExecStart={{ laya_systemone_venv }}/bin/laya-serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
