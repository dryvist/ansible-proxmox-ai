# {{ ansible_managed }}
# agentgateway static config — regenerated on every converge (config as code).
# Schema: https://agentgateway.dev/schema/config
#
# One route PER target (path-scoped, e.g. /splunk) instead of one
# multiplexed route: auth is passthrough, and a shared route would forward a
# caller's Authorization header to EVERY backend a tool resolves to — leaking
# the Splunk token to external targets. Path isolation keeps each credential
# on its own backend; clients configure one MCP server entry per path.
#
# Route naming: the vhost is already mcp.<sub>, so the path is just the
# capability name (/splunk, /context7, /memory, /docs) — the
# /mcp suffix carried no protocol meaning (Streamable HTTP POSTs to whatever
# URL the client is given). The transitional /<name>/mcp aliases were
# removed once Hermes and the workstation client configs migrated (#22).
{%- set agentgateway_docker_api_key_block %}
          keys:
{% for agent_name, agent_key in agentgateway_docker_roster_keys | dictsort %}
            - key: {{ agent_key | to_json }}
              metadata:
                agent: {{ agent_name | to_json }}
{% if agentgateway_docker_hindsight_roster_tiers is defined and agent_name in agentgateway_docker_hindsight_roster_tiers %}
                tier: {{ agentgateway_docker_hindsight_roster_tiers[agent_name] | to_json }}
{% endif %}
{% endfor %}
{%- endset %}

config:
  # Bind the admin UI (Traefik-fronted) and the stats server (Prometheus
  # /metrics) on all interfaces so the LXC can publish them; the guest
  # firewall scopes both internal-only. Ports are DRY from pipeline_constants.
  adminAddr: "0.0.0.0:{{ agentgateway_docker_admin_port }}"
  statsAddr: "0.0.0.0:{{ agentgateway_docker_metrics_port }}"
  tracing:
    # OTLP/HTTP to the shared Cribl Stream receiver; traces go to
    # Langfuse + Phoenix (no direct exporters — telemetry always via Cribl).
    otlpEndpoint: "{{ agentgateway_docker_otlp_endpoint }}"
    otlpProtocol: http
    randomSampling: {{ agentgateway_docker_trace_sampling }}

binds:
- port: {{ agentgateway_docker_proxy_port }}
  listeners:
  - routes:
{% for target in agentgateway_docker_mcp_targets %}
    - matches:
      - path:
          exact: /{{ target.name }}
{% if target.name in ai_agent_owner %}
      policies:
        apiKey:
          mode: strict
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
        authorization:
          rules:
            - allow: {{ ("apiKey.agent == '" ~ ai_agent_owner[target.name] ~ "'") | to_json }}
{% endif %}
      backends:
      - mcp:
          targets:
          - name: {{ target.name }}
            mcp:
              host: {{ target.host }}
{% if target.tls_insecure | default(false) %}
            policies:
              backendTLS:
                insecure: true
{% endif %}
{% endfor %}
{% if (agentgateway_docker_qdrant_mcp_enabled | bool
       and agentgateway_docker_qdrant_memory_mcp_api_key | length > 0)
      or (agentgateway_docker_docs_mcp_enabled | bool
          and agentgateway_docker_qdrant_api_key | length > 0) %}
{% if agentgateway_docker_qdrant_mcp_enabled | bool
      and agentgateway_docker_qdrant_memory_mcp_api_key | length > 0 %}
{# Vector-memory MCP (capability route /memory) — backend is the
   mcp-server-qdrant sidecar in this compose stack (service name on the
   compose network, no host port). Trailing slash on the backend path is
   REQUIRED: FastMCP 307-redirects /mcp -> /mcp/, and the redirect escaped
   the route (the live /qdrant/mcp dead-end in #22). #}
    - matches:
      - path:
          exact: /memory
      policies:
        apiKey:
          mode: {{ agentgateway_docker_mcp_route_auth_mode }}
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
      backends:
      - mcp:
          targets:
          - name: memory
            mcp:
              host: http://mcp-qdrant:{{ agentgateway_docker_qdrant_mcp_port }}/mcp/
{% endif %}
{% if agentgateway_docker_docs_mcp_enabled | bool
      and agentgateway_docker_qdrant_api_key | length > 0 %}
{# Docs-search MCP (capability route /docs) — read-only sidecar over the
   llamaindex homelab_docs collection. Same trailing-slash rule as /memory. #}
    - matches:
      - path:
          exact: /docs
      policies:
        apiKey:
          mode: {{ agentgateway_docker_mcp_route_auth_mode }}
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
      backends:
      - mcp:
          targets:
          - name: docs
            mcp:
              host: http://mcp-docs:{{ agentgateway_docker_docs_mcp_port }}/mcp/
{% endif %}
{% endif %}
{% if agentgateway_docker_vikunja_mcp_enabled | bool
      and agentgateway_docker_vikunja_read_token | length > 0 %}
{# Vikunja task-board MCP (capability route /vikunja) — the supergateway
   sidecar on the compose network. supergateway serves Streamable HTTP at
   /mcp (its default streamableHttpPath). If a converge finds the route
   dead-ends on a 307 (as FastMCP does above), add the trailing slash. #}
    - matches:
      - path:
          exact: /vikunja
      policies:
        apiKey:
          mode: {{ agentgateway_docker_mcp_route_auth_mode }}
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
      backends:
      - mcp:
          targets:
          - name: vikunja
            mcp:
              host: http://mcp-vikunja:{{ agentgateway_docker_vikunja_mcp_port }}/mcp
{% endif %}
{% if agentgateway_docker_nautobot_openapi_enabled | bool
      and agentgateway_docker_nautobot_read_token | length > 0 %}
{# Read-only Nautobot REST tools from the reviewed OpenAPI schema projection. #}
    - matches:
      - path:
          exact: /nautobot
      policies:
        apiKey:
          mode: {{ agentgateway_docker_mcp_route_auth_mode }}
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
      backends:
      - mcp:
          targets:
          - name: nautobot
            openapi:
              schema:
                file: {{ agentgateway_docker_nautobot_openapi_schema_path }}
              host: "{{ agentgateway_docker_nautobot_url }}"
            policies:
              backendAuth:
                key:
                  value:
                    file: {{ agentgateway_docker_nautobot_openapi_token_path }}
                  location:
                    header:
                      name: authorization
                      prefix: "Token "
{% elif agentgateway_docker_nautobot_mcp_enabled | bool
        and agentgateway_docker_nautobot_read_token | length > 0 %}
{# Nautobot IPAM/DCIM MCP (capability route /nautobot) — the
   mcp_nautobot_server.py FastMCP sidecar. Same trailing-slash rule as
   /memory and /docs. #}
    - matches:
      - path:
          exact: /nautobot
      policies:
        apiKey:
          mode: {{ agentgateway_docker_mcp_route_auth_mode }}
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
      backends:
      - mcp:
          targets:
          - name: nautobot
            mcp:
              host: http://mcp-nautobot:{{ agentgateway_docker_nautobot_mcp_port }}/mcp/
{% endif %}
{% for target in agentgateway_docker_a2a_targets | default([]) %}
    - matches:
      - path:
          pathPrefix: {{ target.path_prefix }}
      policies:
        a2a: {}
      backends:
      - host: {{ target.host }}
{% endfor %}
{% if agentgateway_docker_hindsight_enabled is defined
      and agentgateway_docker_hindsight_enabled | bool
      and agentgateway_docker_hindsight_api_key | length > 0
      and agentgateway_docker_hindsight_agent_banks | length > 0 %}
{#- Hindsight bank ACL (route /hindsight). ALLOW and REQUIRE rules only: with any
    allow rule configured the gateway denies everything unmatched, and an allow
    expression that errors does not match — so every failure path is a denial.
    A deny rule that errors would NOT deny, so none is used. The caller's tier
    comes from the apiKey metadata; the Hindsight tenant key is injected by
    backendAuth and never reaches callers.
    Rules evaluate the path with the route prefix stripped (stripPrefix is a
    no-op when a rewrite already ran), reject dot-segments, percent-encoding and
    empty segments outright, and require any X-Bank-Id header to name the same
    bank as the path. #}
{% set hs_banks = agentgateway_docker_hindsight_agent_banks %}
{% set hs_tiers = agentgateway_docker_hindsight_roster_tiers %}
{% set hs_api = agentgateway_docker_hindsight_api_root %}
{% set hs_mcp = agentgateway_docker_hindsight_mcp_root %}
{% set hs_path = 'request.path.stripPrefix("' ~ agentgateway_docker_hindsight_route_prefix ~ '")' %}
{% set hs_guard = '!' ~ hs_path ~ '.contains("..") && !' ~ hs_path ~ '.contains("%") && !' ~ hs_path ~ '.contains("//")' %}
{# Per-bank request surface, keyed bank|class (read or write). #}
{% set hs_by = {} %}
{% for agent, bank in hs_banks.items() %}
{% for cls, methods in agentgateway_docker_hindsight_routes.items() %}
{% for method, patterns in methods.items() %}
{% set conds = [] %}
{% for pattern in patterns %}
{% if '{' in pattern %}
{% set _ = conds.append(hs_path ~ '.matches("^' ~ ((hs_api ~ bank ~ pattern) | replace('{path}', '.+') | replace('{id}', '[^/]+')) ~ '$")') %}
{% else %}
{% set _ = conds.append(hs_path ~ ' == "' ~ hs_api ~ bank ~ pattern ~ '"') %}
{% endif %}
{% endfor %}
{% set _ = hs_by.setdefault(bank ~ '|' ~ cls, []).append('(request.method == "' ~ method ~ '" && (' ~ (conds | join(' || ')) ~ '))') %}
{% endfor %}
{% endfor %}
{% endfor %}
{% set hs_rules = [] %}
{% set _ = hs_rules.append(['require', 'apiKey.tier in ' ~ (hs_tiers.values() | unique | list | to_json)]) %}
{% set _ = hs_rules.append(['allow', 'request.method == "GET" && (' ~ hs_path ~ ' == "/health" || ' ~ hs_path ~ ' == "/version")']) %}
{# Per bank, from the roster alone:
   - read: ANY caller of the bank owner's tier (own bank and same-tier peers);
   - write and the single-bank MCP mount: ONLY the bank owner, by agent name.
   A caller of the other tier matches neither, so cross-tier access is refused.
   Every rule pins X-Bank-Id (when sent) to the bank in the path. #}
{% for agent, bank in hs_banks.items() | sort %}
{% set _ = hs_rules.append(['allow', 'apiKey.tier == "' ~ hs_tiers[agent] ~ '" && ' ~ hs_guard
     ~ ' && default(request.headers["x-bank-id"], "' ~ bank ~ '") == "' ~ bank ~ '"'
     ~ ' && (' ~ (hs_by[bank ~ '|read'] | join(' || ')) ~ ')']) %}
{% set _ = hs_rules.append(['allow', 'apiKey.agent == "' ~ agent ~ '" && ' ~ hs_guard
     ~ ' && default(request.headers["x-bank-id"], "' ~ bank ~ '") == "' ~ bank ~ '"'
     ~ ' && (' ~ (hs_by[bank ~ '|write'] | join(' || ')) ~ ')']) %}
{# Single-bank MCP mount: the bank is the first path segment, so a bank_id tool
   argument or X-Bank-Id header cannot redirect the call. The multi-bank mount
   (bank-less path) is never allowed. The mount can write, so it is owner-only. #}
{% set _ = hs_rules.append(['allow', 'apiKey.agent == "' ~ agent ~ '" && ' ~ hs_guard
     ~ ' && default(request.headers["x-bank-id"], "' ~ bank ~ '") == "' ~ bank ~ '"'
     ~ ' && request.method in ["GET", "POST", "DELETE"]'
     ~ ' && (' ~ hs_path ~ ' == "' ~ hs_mcp ~ bank ~ '" || ' ~ hs_path ~ '.startsWith("' ~ hs_mcp ~ bank ~ '/"))']) %}
{% endfor %}
{% set hs_shared_route_policy %}
        urlRewrite:
          authority: auto
          path:
            prefix: /
        authorization:
          rules:
{% for kind, expression in hs_rules %}
            - {{ kind }}: {{ expression | to_json }}
{% endfor %}
      backends:
      - host: {{ (agentgateway_docker_hindsight_host ~ ':' ~ agentgateway_docker_hindsight_port) | to_json }}
        policies:
          backendTLS:
            hostname: {{ agentgateway_docker_hindsight_host | to_json }}
          backendAuth:
            key:
              value: {{ agentgateway_docker_hindsight_api_key | to_json }}
{%- endset %}
    - matches:
      - path:
          pathPrefix: {{ agentgateway_docker_hindsight_route_prefix }}
        headers:
        - name: authorization
          value:
            regex: '^Bearer .+'
      policies:
        apiKey:
          mode: strict
          location:
            header:
              name: authorization
              prefix: 'Bearer '
{{ agentgateway_docker_api_key_block }}
{{ hs_shared_route_policy }}
    - matches:
      - path:
          pathPrefix: {{ agentgateway_docker_hindsight_route_prefix }}
      policies:
        apiKey:
          mode: strict
          location:
            header:
              name: X-Agent-Key
{{ agentgateway_docker_api_key_block }}
{{ hs_shared_route_policy }}
{% endif %}
