# {{ ansible_managed }}
# Ship stdout/stderr to journald with tag `agentgateway` instead of the
# default json-file driver, which stays on local disk and never reaches the
# SIEM. Tag is a bare identifier (no ':' or whitespace) so rsyslog's
# syslog-header regex extracts it as $programname. The host's rsyslog
# forwarder (ansible-proxmox-apps) matches on that tag and forwards it, on
# this stack's own port (tofu-proxmox constants), to this stack's own
# dedicated Splunk index — one index per service, not a shared one. Shared by
# every service in this stack (gateway + MCP sidecars) — one tag, one index,
# for the whole stack.
x-logging: &agentgateway_docker_logging
  driver: journald
  options:
    tag: agentgateway

services:
  agentgateway:
    image: {{ agentgateway_docker_image }}
    container_name: {{ agentgateway_docker_container_name }}
    restart: {{ agentgateway_docker_restart_policy }}
    logging: *agentgateway_docker_logging
    command: ["-f", "/config.yaml"]
    ports:
      - "{{ agentgateway_docker_proxy_port }}:{{ agentgateway_docker_proxy_port }}"
      - "{{ agentgateway_docker_admin_port }}:{{ agentgateway_docker_admin_port }}"
      - "{{ agentgateway_docker_metrics_port }}:{{ agentgateway_docker_metrics_port }}"
    volumes:
      - "{{ agentgateway_docker_data_dir }}/config.yaml:/config.yaml:ro"
{% if agentgateway_docker_qdrant_mcp_enabled | bool
      and agentgateway_docker_qdrant_api_key | length > 0 %}
    # Start after the memory sidecar answers MCP so the gateway's first /memory
    # request does not land in the sidecar's startup window (uvx resolve +
    # embedding-model load). required: false keeps the gateway (every other
    # route) starting even if the sidecar never becomes healthy.
    depends_on:
      mcp-qdrant:
        condition: service_healthy
        required: false
{% endif %}
{% if agentgateway_docker_vikunja_mcp_enabled | bool
      and agentgateway_docker_vikunja_read_token | length > 0 %}

  # Vikunja MCP sidecar (see defaults). supergateway wraps the stdio-only
  # vikunja-mcp into Streamable HTTP; reached only by the gateway over the
  # compose network — no host port. This sidecar holds the read-scoped token.
  mcp-vikunja:
    image: {{ agentgateway_docker_vikunja_mcp_image }}
    container_name: mcp-vikunja
    restart: {{ agentgateway_docker_restart_policy }}
    logging: *agentgateway_docker_logging
    command:
      - "--stdio"
      - "npx -y @democratize-technology/vikunja-mcp@{{ agentgateway_docker_vikunja_mcp_version }}"
      - "--outputTransport"
      - "streamableHttp"
      - "--port"
      - "{{ agentgateway_docker_vikunja_mcp_port }}"
      - "--stateful"
      - "--sessionTimeout"
      - "{{ agentgateway_docker_vikunja_mcp_session_timeout_ms }}"
    environment:
      VIKUNJA_URL: "{{ agentgateway_docker_vikunja_url }}"
      VIKUNJA_API_TOKEN: "{{ agentgateway_docker_vikunja_read_token }}"
{% endif %}
{% if agentgateway_docker_nautobot_mcp_enabled | bool
      and agentgateway_docker_nautobot_read_token | length > 0 %}

  # Nautobot IPAM/DCIM MCP sidecar (see defaults) — FastMCP GraphQL
  # passthrough over Nautobot's own /graphql/ endpoint. Reached only by the
  # gateway over the compose network — no host port. This sidecar holds the
  # read-scoped token.
  mcp-nautobot:
    image: {{ agentgateway_docker_qdrant_mcp_image }}
    container_name: mcp-nautobot
    restart: {{ agentgateway_docker_restart_policy }}
    logging: *agentgateway_docker_logging
    entrypoint: ["uv"]
    command:
      - "run"
      - "--no-project"
      - "--with"
      - "fastmcp=={{ agentgateway_docker_nautobot_mcp_fastmcp_version }}"
      - "/app/mcp_nautobot_server.py"
    environment:
      FASTMCP_SERVER_HOST: "0.0.0.0"
      FASTMCP_SERVER_PORT: "{{ agentgateway_docker_nautobot_mcp_port }}"
      NAUTOBOT_URL: "{{ agentgateway_docker_nautobot_url }}"
      NAUTOBOT_READ_TOKEN: "{{ agentgateway_docker_nautobot_read_token }}"
    volumes:
      - "{{ agentgateway_docker_data_dir }}/mcp_nautobot_server.py:/app/mcp_nautobot_server.py:ro"
{% endif %}
{% if agentgateway_docker_qdrant_mcp_enabled | bool
      and agentgateway_docker_qdrant_api_key | length > 0 %}

  # Qdrant vector-memory MCP sidecar (see defaults). Reached only by the
  # gateway over the compose network — no host port published.
  mcp-qdrant:
    image: {{ agentgateway_docker_qdrant_mcp_image }}
    container_name: mcp-qdrant
    restart: {{ agentgateway_docker_restart_policy }}
    logging: *agentgateway_docker_logging
    entrypoint: ["uvx"]
    command:
      - "mcp-server-qdrant=={{ agentgateway_docker_qdrant_mcp_version }}"
      - "--transport"
      - "streamable-http"
    environment:
      FASTMCP_SERVER_HOST: "0.0.0.0"
      FASTMCP_SERVER_PORT: "{{ agentgateway_docker_qdrant_mcp_port }}"
      QDRANT_URL: "{{ agentgateway_docker_qdrant_url }}"
      QDRANT_API_KEY: "{{ agentgateway_docker_qdrant_api_key }}"
      COLLECTION_NAME: "{{ agentgateway_docker_qdrant_mcp_collection }}"
    # mcp-server-qdrant builds its embedding model in the server constructor,
    # before it listens, so the port opening means the model is loaded. Healthy
    # = a real MCP initialize round-trip succeeds, not just a TCP accept. The
    # long start_period covers the first uvx resolve + model download.
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - |
          import json, urllib.request as u
          u.urlopen(u.Request(
              "http://localhost:{{ agentgateway_docker_qdrant_mcp_port }}/mcp/",
              data=json.dumps(dict(jsonrpc="2.0", id=1, method="initialize", params=dict(
                  protocolVersion="2025-03-26", capabilities={},
                  clientInfo=dict(name="healthcheck", version="1")))).encode(),
              headers={"Content-Type": "application/json",
                       "Accept": "application/json, text/event-stream"}), timeout=5)
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s
    volumes:
      # Cache the uvx-resolved package + fastembed model across restarts.
      - mcp_qdrant_cache:/root/.cache
{% if agentgateway_docker_docs_mcp_enabled | bool %}

  # Docs-search MCP sidecar (see defaults) — FastMCP search_docs server that
  # embeds via the LLM router and searches Qdrant over REST (no local model).
  mcp-docs:
    image: {{ agentgateway_docker_qdrant_mcp_image }}
    container_name: mcp-docs
    restart: {{ agentgateway_docker_restart_policy }}
    logging: *agentgateway_docker_logging
    entrypoint: ["uv"]
    command:
      - "run"
      - "--no-project"
      - "--with"
      - "fastmcp=={{ agentgateway_docker_docs_mcp_fastmcp_version }}"
      - "/app/mcp_docs_server.py"
    environment:
      FASTMCP_SERVER_HOST: "0.0.0.0"
      FASTMCP_SERVER_PORT: "{{ agentgateway_docker_docs_mcp_port }}"
      ROUTER_BASE_URL: "{{ agentgateway_docker_docs_mcp_router_base_url }}"
      ROUTER_API_KEY: "{{ agentgateway_docker_docs_mcp_router_api_key }}"
      EMBED_MODEL: "{{ agentgateway_docker_docs_mcp_embed_model }}"
      QDRANT_URL: "{{ agentgateway_docker_qdrant_url }}"
      QDRANT_API_KEY: "{{ agentgateway_docker_qdrant_api_key }}"
      COLLECTION_NAME: "{{ agentgateway_docker_docs_mcp_collection }}"
    volumes:
      - "{{ agentgateway_docker_data_dir }}/mcp_docs_server.py:/app/mcp_docs_server.py:ro"
      - mcp_qdrant_cache:/root/.cache
{% endif %}

volumes:
  mcp_qdrant_cache:
{% endif %}
