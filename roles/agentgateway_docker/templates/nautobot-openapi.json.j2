{% set selected = namespace(paths={}) %}
{% for path, path_item in agentgateway_docker_nautobot_openapi_response.json.paths.items() %}
{% set methods = namespace(value={}) %}
{% for method, operation in path_item.items() %}
{% if method == 'get' and operation.get('operationId') in agentgateway_docker_nautobot_openapi_operations %}
{% set _ = methods.value.update({method: operation}) %}
{% elif method not in ['get', 'post', 'put', 'patch', 'delete', 'head', 'options', 'trace'] %}
{% set _ = methods.value.update({method: operation}) %}
{% endif %}
{% endfor %}
{% if methods.value %}
{% set _ = selected.paths.update({path: methods.value}) %}
{% endif %}
{% endfor %}
{{ agentgateway_docker_nautobot_openapi_response.json
   | combine({'paths': selected.paths})
   | to_nice_json }}
