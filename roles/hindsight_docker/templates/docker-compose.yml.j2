---
# Ship stdout/stderr to journald with tag `hindsight` instead of the default
# json-file driver, which stays on local disk and never reaches the SIEM.
# Tag is a bare identifier (no ':' or whitespace) so rsyslog's syslog-header
# regex extracts it as $programname. The host's rsyslog forwarder
# (ansible-proxmox-apps) matches on that tag and forwards it, on this
# service's own port (tofu-proxmox constants), to this service's own
# dedicated Splunk index — one index per service, not a shared one.
x-logging: &hindsight_docker_logging
  driver: journald
  options:
    tag: hindsight

services:
  hindsight:
    image: {{ hindsight_docker_image }}
    container_name: {{ hindsight_docker_container_name }}
    restart: unless-stopped
    logging: *hindsight_docker_logging
    ports:
      - "{{ hindsight_docker_api_port }}:8888"
      - "{{ hindsight_docker_cp_port }}:9999"
    volumes:
      # Rebuildable cache only (downloaded local embedding model) — all real
      # state lives in the ai-VLAN Postgres cluster. Named volume, not a bind
      # mount: the image runs as the non-root `hindsight` user and a
      # root-owned bind mount breaks its ~/.cache writes (PermissionError on
      # huggingface token).
      - hindsight-cache:/home/hindsight/.cache
    environment:
      HINDSIGHT_API_DATABASE_URL: "{{ hindsight_docker_db_url }}"
      HINDSIGHT_API_VECTOR_EXTENSION: "{{ hindsight_docker_vector_extension }}"
      HINDSIGHT_API_LLM_PROVIDER: openai
      HINDSIGHT_API_LLM_BASE_URL: "{{ hindsight_docker_llm_base_url }}"
      HINDSIGHT_API_LLM_MODEL: "{{ hindsight_docker_llm_model }}"
      HINDSIGHT_API_LLM_API_KEY: "{{ hindsight_docker_llm_api_key }}"
      # Retain (background fact extraction) is scoped off the global model
      # above — see the comment in defaults/main.yml. Same API key/base URL;
      # only the target model, concurrency and retry budget differ.
      HINDSIGHT_API_RETAIN_LLM_MODEL: "{{ hindsight_docker_retain_llm_model }}"
      HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT: "{{ hindsight_docker_retain_llm_max_concurrent }}"
      HINDSIGHT_API_RETAIN_LLM_MAX_RETRIES: "{{ hindsight_docker_retain_llm_max_retries }}"
      HINDSIGHT_API_RETAIN_LLM_INITIAL_BACKOFF: "{{ hindsight_docker_retain_llm_initial_backoff }}"
      HINDSIGHT_API_RETAIN_LLM_MAX_BACKOFF: "{{ hindsight_docker_retain_llm_max_backoff }}"
      HINDSIGHT_API_EMBEDDINGS_PROVIDER: "{{ hindsight_docker_embeddings_provider }}"
      # Stateless (POST-only) MCP: each request is self-contained, so the
      # Traefik-balanced two-replica pool needs no session affinity and a
      # replica can die mid-conversation without dropping a client's MCP
      # session. Stateful mode keeps per-replica in-memory sessions, which
      # round-robin across the pool and fail ~half of every session's calls
      # with "Session not found". POST-only drops server-initiated SSE, which
      # the retain/recall request/response tools do not use.
      HINDSIGHT_API_MCP_STATELESS: "{{ hindsight_docker_mcp_stateless | string | lower }}"
      HINDSIGHT_API_WORKER_ID: "{{ hindsight_docker_worker_id }}"
      HINDSIGHT_CP_ACCESS_KEY: "{{ hindsight_docker_cp_access_key }}"
      # Migrations run once, out of band, before any replica starts — see
      # tasks/run_db_migration.yml and the comment on the var below.
      HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP: "{{ hindsight_docker_run_migrations_on_startup | string | lower }}"
      # Explicit wall-clock ceilings below upstream's loose defaults — see the
      # comment on these vars in defaults/main.yml.
      HINDSIGHT_API_RETAIN_WALL_TIMEOUT: "{{ hindsight_docker_retain_wall_timeout }}"
      HINDSIGHT_API_CONSOLIDATION_WALL_TIMEOUT: "{{ hindsight_docker_consolidation_wall_timeout }}"
      HINDSIGHT_API_REFLECT_WALL_TIMEOUT: "{{ hindsight_docker_reflect_wall_timeout }}"
      HINDSIGHT_API_REFRESH_MENTAL_MODEL_WALL_TIMEOUT: "{{ hindsight_docker_refresh_mental_model_wall_timeout }}"

volumes:
  hindsight-cache:
