# Read by docker compose from the project directory. The vendor compose file interpolates these names
# and passes this file to the simstudio and realtime services as env_file. Contains secrets: mode 0600.
SIM_VERSION={{ sim_docker_version }}
SIM_CRON_VERSION={{ sim_docker_cron_version }}
POSTGRES_USER={{ sim_docker_db_user }}
POSTGRES_PASSWORD={{ sim_docker_db_password }}
POSTGRES_DB={{ sim_docker_db_name }}
BETTER_AUTH_SECRET={{ sim_docker_better_auth_secret }}
ENCRYPTION_KEY={{ sim_docker_encryption_key }}
INTERNAL_API_SECRET={{ sim_docker_internal_api_secret }}
API_ENCRYPTION_KEY={{ sim_docker_api_encryption_key }}
CRON_SECRET={{ sim_docker_cron_secret }}
NEXT_PUBLIC_APP_URL={{ sim_docker_public_url }}
# Hosted Chat calls the hosted Sim service (COPILOT_API_KEY, SIM_AGENT_API_URL), which this stack does
# not configure. Hiding the module is the explicit off switch. Those two keys are left unset.
NEXT_PUBLIC_CHAT_DISABLED=true
# Anonymous product telemetry posts to a Sim-operated collector unless this is exactly "1".
NEXT_TELEMETRY_DISABLED=1
{% if sim_docker_socket_url | length > 0 %}
NEXT_PUBLIC_SOCKET_URL={{ sim_docker_socket_url }}
{% endif %}
{% if sim_docker_llm_base_url | length > 0 %}
VLLM_BASE_URL={{ sim_docker_llm_base_url }}
VLLM_API_KEY={{ sim_docker_llm_api_key }}
{% endif %}
