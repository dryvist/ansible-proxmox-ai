# Local changes to the vendor production compose file (docker-compose.prod.yml, fetched unchanged and
# verified by SHA-256). Passed to compose after the vendor file, with both named explicitly:
#   docker compose -f docker-compose.prod.yml -f docker-compose.override.yml up -d
# Compose merges volumes by container path, so the bind mounts below replace the vendor named volume
# on db and add the uploads directory to simstudio. The db service publishes no ports, here or in the
# vendor file.
services:
  simstudio:
    image: "ghcr.io/simstudioai/simstudio:${SIM_VERSION}@{{ sim_docker_app_digest }}"
    volumes:
      - "{{ sim_docker_uploads_data_dir }}:{{ sim_docker_uploads_internal_data }}"
  realtime:
    image: "ghcr.io/simstudioai/realtime:${SIM_VERSION}@{{ sim_docker_realtime_digest }}"
  migrations:
    image: "ghcr.io/simstudioai/migrations:${SIM_VERSION}@{{ sim_docker_migrations_digest }}"
  redis:
    image: "{{ sim_docker_redis_image }}"
  db:
    image: "{{ sim_docker_db_image }}"
    volumes:
      - "{{ sim_docker_postgres_data_dir }}:{{ sim_docker_postgres_internal_data }}"
