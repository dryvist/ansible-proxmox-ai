{{ ansible_managed | comment }}
[Unit]
Description=audio.cpp speech server (API-only, CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ audiocpp_user }}
Group={{ audiocpp_group }}
WorkingDirectory={{ audiocpp_data_dir }}
Environment=LD_LIBRARY_PATH={{ audiocpp_install_dir }}
ExecStart={{ audiocpp_server_bin }} --config {{ audiocpp_config_file }} --no-ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
