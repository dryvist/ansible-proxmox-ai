{
  "host": {{ audiocpp_host | to_json }},
  "port": {{ audiocpp_api_port | int }},
  "backend": "cpu",
  "threads": {{ audiocpp_threads | int }},
  "lazy_load": true,
  "max_loaded_models": {{ audiocpp_max_loaded_models | int }},
  "log_request_body": false,
  "models": [
{% for m in audiocpp_models %}
    {"id": {{ m.id | to_json }}, "family": {{ m.family | to_json }}, "path": {{ (audiocpp_models_dir ~ '/' ~ m.file) | to_json }}, "task": {{ m.task | to_json }}, "mode": "offline"}{{ ',' if not loop.last }}
{% endfor %}
  ]
}
