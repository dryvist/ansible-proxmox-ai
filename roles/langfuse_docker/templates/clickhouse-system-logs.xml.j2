<?xml version="1.0"?>
<!-- Rendered by roles/langfuse_docker. Do not edit by hand.
     Merged over the image's stock config.xml from config.d. -->
<clickhouse>
    <logger>
        <level>{{ langfuse_docker_clickhouse_log_level }}</level>
    </logger>
    <text_log>
        <level>{{ langfuse_docker_clickhouse_log_level }}</level>
    </text_log>
{% for table in langfuse_docker_clickhouse_system_log_ttl_tables %}
    <{{ table }}>
        <ttl>event_date + INTERVAL {{ langfuse_docker_clickhouse_system_log_ttl_days }} DAY DELETE</ttl>
    </{{ table }}>
{% endfor %}
    <!-- Collection stops here. The existing table is kept, not dropped. -->
    <opentelemetry_span_log remove="1"/>
</clickhouse>
