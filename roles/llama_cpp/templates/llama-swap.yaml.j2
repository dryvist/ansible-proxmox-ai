{{ ansible_managed | comment }}
# llama-swap config (managed by the llama_cpp role). One OpenAI-compatible endpoint
# in front of llama.cpp's llama-server. The models below are kept co-resident (a
# group with swap:false), so there is no per-request reload churn.

healthCheckTimeout: {{ llama_cpp_health_check_timeout }}
startPort: {{ llama_cpp_start_port }}
logLevel: info

# Requests to a per-model /metrics scrape must not trigger a swap: the "chat"
# group holds more than one member (swap:true), and llama-swap treats ANY
# proxied request to an unloaded model's /upstream/<model>/... path as a load
# request. Without this, a Prometheus scrape of the currently-swapped-out
# model would load-thrash the pair every scrape interval. ignorePaths fully
# replaces llama-swap's default list, so the stock static-asset patterns are
# repeated here rather than lost.
upstream:
  ignorePaths:
    - '.*\.(js|json|css|png|gif|jpg|jpeg|ico|txt)$'
    - '.*/metrics$'

# Shared llama-server invocation. ${PORT} is assigned per model by llama-swap.
macros:
  "server-base": >-
    {{ llama_cpp_server_bin }}
    --host 127.0.0.1 --port ${PORT}
    -ngl {{ llama_cpp_ngl }}
    --metrics
    --parallel {{ llama_cpp_parallel }}

groups:
  # VRAM discipline (learned the hard way: full co-residency of the models
  # + their KV caches once included a 14B chat model and exceeded the 16 GB
  # card — the amdgpu eviction path hard-hangs the HOST. That 14B model was
  # removed; see the ABSOLUTE >=14B rule in roles/llama_cpp/defaults/main/00-core.yml).
  # Only the tiny embeddings model stays permanently resident; the chat models
  # swap against each other, so peak pressure is one chat model + embeddings +
  # KV. --no-mmap was also dropped from the shared invocation: mmap streaming
  # halves the load spike.
  "embeddings":
    swap: false
    exclusive: false
    members:
{% for m in llama_cpp_models_present if m.embeddings %}
      - "{{ m.name }}"
{% endfor %}
  "chat":
    swap: true
    exclusive: false
    members:
{% for m in llama_cpp_models_present if not m.embeddings %}
      - "{{ m.name }}"
{% endfor %}

models:
{% for m in llama_cpp_models_present %}
  "{{ m.name }}":
{% if m.aliases | length > 0 %}
    aliases:
{% for a in m.aliases %}
      - "{{ a }}"
{% endfor %}
{% endif %}
{# Pinned to the same llama_cpp_parallel value passed to --parallel below,
   so llama-swap rejects the (slots+1)th request immediately (HTTP 429)
   instead of admitting it into llama-server's own queue. mandatory():
   a group that leaves llama_cpp_parallel unset fails here, loud.
   NOTE: this comment tag must start at column 0 — Ansible's real Jinja
   environment sets trim_blocks but not lstrip_blocks, so an indented
   comment on its own line leaves its OWN leading whitespace as literal
   output, doubling the indentation of the line that follows it. That is
   what broke this exact line in production (2026-09-19): concurrencyLimit
   rendered at 8 spaces against cmd's 4, which is a YAML structural key at
   the wrong level, not survivable whitespace inside a block scalar. #}
    concurrencyLimit: {{ llama_cpp_parallel | mandatory("llama_cpp_parallel must be set for this group") }}
    cmd: |
      ${server-base}
      --model {{ llama_cpp_models_dir }}/{{ m.gguf }}
{# Per-model window, falling back to the group default. A second model on
   one card does not get to share one number: KV cost per token is a
   property of the model's attention shape, so two models at the same
   window can differ by a gigabyte of VRAM. The entry's own value must
   match what the registry advertises for that model — see the group_vars
   comment on llama_cpp_ctx_size for why those are one number. #}
      --ctx-size {{ m.ctx_size | default(llama_cpp_ctx_size) }}
{% if m.embeddings %}
      --embeddings
      --pooling mean
{# Non-causal embedding inputs must fit in ONE physical batch; the
   llama-server default (512) silently caps inputs far below ctx-size
   and 500s anything larger. Match the batch to the context window. #}
      --batch-size {{ m.ctx_size | default(llama_cpp_ctx_size) }}
      --ubatch-size {{ m.ctx_size | default(llama_cpp_ctx_size) }}
{% else %}
      --flash-attn on
      --jinja
{# Repeat requests from the same caller should land on a warm cache —
   see the rationale in roles/llama_cpp/defaults/main/10-cache-specdecode.yml. #}
      --cache-reuse {{ llama_cpp_cache_reuse }}
{% if llama_cpp_cache_ram is not none %}
      --cache-ram {{ llama_cpp_cache_ram }}
{% endif %}
{% if llama_cpp_cache_idle_slots | bool %}
      --cache-idle-slots
{% endif %}
{% if m.spec_draft_model is defined %}
{# TODO(benchmarking): draft/target model choice is a separate
   mlx-benchmarks sweep, a different repo/PR. Flag spellings here are
   UNVERIFIED against the resolved release — see defaults/main/10-cache-specdecode.yml. #}
      --spec-draft-model {{ llama_cpp_models_dir }}/{{ m.spec_draft_model }}
      --spec-draft-n-max {{ m.spec_draft_n_max | default(llama_cpp_spec_draft_n_max_default) }}
      --spec-draft-n-min {{ m.spec_draft_n_min | default(llama_cpp_spec_draft_n_min_default) }}
{% if m.spec_type is defined %}
      --spec-type {{ m.spec_type }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
