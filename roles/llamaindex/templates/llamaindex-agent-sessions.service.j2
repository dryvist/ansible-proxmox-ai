[Unit]
Description=Incrementally index agent session logs in Qdrant
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ llamaindex_data_dir }}/venv/bin/python {{ llamaindex_data_dir }}/index_agent_sessions.py --config {{ llamaindex_data_dir }}/config.yaml --agent-config {{ llamaindex_agent_sessions_config_path }}
