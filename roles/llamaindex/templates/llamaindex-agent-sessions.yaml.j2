splunk:
  url: {{ llamaindex_splunk_url | to_json }}
  token: {{ llamaindex_splunk_search_token | to_json }}

index:
  collection: {{ llamaindex_agent_sessions_collection | to_json }}
  watermark_file: {{ llamaindex_agent_sessions_watermark_path | to_json }}
  harnesses:
{% for harness in llamaindex_agent_sessions_harnesses %}
    - name: {{ harness.name | to_json }}
      index: {{ harness.index | to_json }}
      role_field: {{ harness.role_field | default('message.role') | to_json }}
      content_field: {{ harness.content_field | default('message.content') | to_json }}
      session_field: {{ harness.session_field | default('session_id') | to_json }}
      cwd_field: {{ harness.cwd_field | default('cwd') | to_json }}
{% endfor %}
