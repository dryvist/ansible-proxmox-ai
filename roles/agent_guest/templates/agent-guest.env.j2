{{ ansible_managed | comment }}
# Shared by agent-queue.service (root, poll+claim) and agent-task@.service
# (the agent user, one job). One file rather than two: the poller and the
# runner need the same queue coordinates, and duplicating them is how they
# drift apart. Rendered 0640 root:{{ agent_guest_user }}.
#
# The model-provider credentials are deliberately NOT here — they arrive in the
# job's environment from `bao agent` (see openbao-agent.hcl) and never touch
# disk. In particular there is no ANTHROPIC_API_KEY: it outranks
# CLAUDE_CODE_OAUTH_TOKEN in claude's auth precedence and would silently move
# billing off the subscription.

# --- Dispatch queue (Vikunja) ---
VIKUNJA_URL={{ agent_guest_vikunja_url }}
VIKUNJA_TOKEN={{ agent_guest_vikunja_token }}
AI_JOBS_PROJECT={{ agent_guest_vikunja_project }}
AGENT_PROFILE_LABEL={{ agent_guest_profile_label }}
AGENT_DEFAULT_BASE={{ agent_guest_task_default_base }}

# --- Result push (ntfy) ---
NTFY_URL={{ agent_guest_ntfy_url }}

# --- Agent CLIs ---
CLAUDE_BIN={{ agent_guest_claude_bin }}
CODEX_BIN={{ agent_guest_codex_bin }}
GEMINI_BIN={{ agent_guest_gemini_bin }}

# --- CLI trace telemetry (OTLP -> Cribl -> Langfuse + Splunk) ---
{% for key, value in agent_guest_task_env | dictsort -%}
{{ key }}={{ value }}
{% endfor %}
