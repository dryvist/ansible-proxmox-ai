# {{ ansible_managed }}
# Mirror of nix-ai renderAutonomous `.codex/config.toml`.
# danger-full-access is correct, not careless: bwrap cannot nest usefully in an
# unprivileged LXC, and the disposable guest is the sandbox.
approval_policy = "never"
sandbox_mode = "danger-full-access"
{% if agent_guest_codex_otel_enabled %}

# Codex trace export (config-file only; codex ignores OTEL_* env). Enable after
# verifying the [otel] schema against the installed codex — a parse error here
# kills every codex task.
[otel]
trace_exporter = { type = "otlp-http", endpoint = "{{ agent_guest_otel_endpoint }}" }
{% endif %}
