# {{ ansible_managed }}
# Mirror of nix-ai renderAutonomous `.gemini/policies/autonomous.toml`, rendered
# from agent_guest_residual_deny. Deny rules at priority 200 override the yolo
# approval mode, so the residual deny holds in fully-autonomous mode.
{% for prefix in agent_guest_residual_deny %}
[[rule]]
toolName = "run_shell_command"
commandPrefix = {{ prefix | to_json }}
decision = "deny"
priority = 200
denyMessage = "Command permanently blocked by security policy."
{% endfor %}
