[Unit]
# {{ ansible_managed }}
Description=Poll the AI Jobs queue every {{ agent_guest_poll_interval }}

[Timer]
OnBootSec={{ agent_guest_poll_interval }}
OnUnitInactiveSec={{ agent_guest_poll_interval }}
# Spread the poll so a pool of guests does not hit Vikunja in lockstep.
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
