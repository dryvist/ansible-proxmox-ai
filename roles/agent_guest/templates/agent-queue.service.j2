[Unit]
# {{ ansible_managed }}
# Queue poller: claims each open Vikunja job for this guest's profile label and
# starts one agent-task@<id> per claim. Runs as root because its only
# privileged action is `systemctl start` — it never runs an agent, never
# touches a job's working tree, and holds no credential beyond the queue token.
Description=Poll the Vikunja AI Jobs queue for this guest's profile
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ agent_guest_config_dir }}/agent-guest.env
ExecStart={{ agent_guest_worker_script }} --poll
