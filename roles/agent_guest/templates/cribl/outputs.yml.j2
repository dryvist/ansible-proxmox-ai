---
# {{ ansible_managed }}
# tcpjson outputs to the HAProxy-fronted Cribl Stream per-CLI frontends. One
# port per CLI so Stream keys routing/enrichment off the frontend rather than
# payload inspection; ports come from the tofu ai_log_routing constant, never a
# literal. The persistent queue buffers locally across HAProxy/Stream downtime.
outputs:
  cribl_claude:
    type: tcpjson
    host: {{ agent_guest_cribl_stream_host }}
    port: {{ agent_guest_cribl_ports.claude }}
    pqEnabled: true
  cribl_codex:
    type: tcpjson
    host: {{ agent_guest_cribl_stream_host }}
    port: {{ agent_guest_cribl_ports.codex }}
    pqEnabled: true
  cribl_agy:
    type: tcpjson
    host: {{ agent_guest_cribl_stream_host }}
    port: {{ agent_guest_cribl_ports.gemini }}
    pqEnabled: true
