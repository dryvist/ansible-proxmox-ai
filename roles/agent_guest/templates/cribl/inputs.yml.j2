---
# {{ ansible_managed }}
# Cribl Edge inputs — the agent user's CLI transcript trees on this guest.
#
# `filenames` globs match the FULL PATH and must lead with "*/" — a pattern
# without a leading wildcard silently matches nothing (nix-darwin #1623). Each
# CLI is selected by its distinctive filename (codex `rollout-*.jsonl`, gemini
# `session-*.json`) or by the `/.claude/` path segment, and pinned straight to
# its per-CLI output; Stream stamps index/sourcetype off the frontend port.
#
# The journal is NOT an input here: roles/syslog_forwarder already ships this
# guest's journal (index=os), and the agent-task units log there like everything
# else. One journal path, not two.
inputs:
  in_agent_codex:
    type: file
    disabled: false
    mode: manual
    interval: 30
    path: {{ agent_guest_home }}
    filenames:
      - "*/rollout-*.jsonl"
    recurse: true
    tailOnly: false
    sendToRoutes: false
    breakerRulesets:
      - AI CLI JSONL
    metadata:
      - name: datatype
        value: "'codex-cli-session'"
    connections:
      - output: cribl_codex
  in_agent_claude:
    type: file
    disabled: false
    mode: manual
    interval: 30
    path: {{ agent_guest_home }}
    filenames:
      - "*/.claude/*.jsonl"
    recurse: true
    tailOnly: false
    sendToRoutes: false
    breakerRulesets:
      - AI CLI JSONL
    connections:
      - output: cribl_claude
  in_agent_gemini:
    type: file
    disabled: false
    mode: manual
    interval: 30
    path: {{ agent_guest_home }}
    filenames:
      - "*/session-*.json"
      - "*/session-*.jsonl"
    recurse: true
    tailOnly: false
    sendToRoutes: false
    breakerRulesets:
      - AI CLI JSONL
    metadata:
      - name: datatype
        value: "'gemini-cli-session'"
    connections:
      - output: cribl_agy
