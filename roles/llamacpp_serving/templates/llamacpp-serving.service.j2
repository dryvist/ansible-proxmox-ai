{{ ansible_managed | comment }}
[Unit]
Description=llama.cpp serving profile {{ llamacpp_serving_profile_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ nvidia_gpu_guest_user }}
Group={{ nvidia_gpu_guest_group }}
WorkingDirectory={{ nvidia_gpu_guest_data_dir }}
Environment=HF_HOME={{ nvidia_gpu_guest_hf_home }}
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=LD_LIBRARY_PATH={{ llamacpp_serving_install_dir }}
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
{% set lc_profile = llamacpp_serving_profile %}
{% set lc_artifact = llamacpp_serving_profile_registry_model.artifact %}
{% set lc_alias = llamacpp_serving_profile_registry_model.upstream_model_id %}
{% set lc_model_dir = llamacpp_serving_profile_model_dir %}
{% set lc_host = nvidia_gpu_guest_listen_host | default(ansible_facts.default_ipv4.address) %}
ExecStart={{ llamacpp_serving_server_bin }} \
{% include 'llama-cpp-serve-args.j2' %}

[Install]
WantedBy=multi-user.target
