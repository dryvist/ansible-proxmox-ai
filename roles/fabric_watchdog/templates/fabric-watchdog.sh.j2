#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Fabric watchdog: probe each configured endpoint; on a DEBOUNCED up/down
# transition, post one Slack message.
#
# Transition-only alerting was NOT enough on its own. The original design
# assumed "a 2-min cadence with transition-only alerts is already quiet, and the
# endpoints sit behind health-checked Traefik pools that absorb single-node
# blips" — but with an 8s probe deadline and no debounce, any single slow
# response is a transition, and the recovery 2 minutes later is another. A
# 13-day audit found 86 messages in the work channel, several of them
# recoveries with no matching DOWN. One blip must not be able to speak.
#
# Hysteresis matches the brain watchdog: an edge needs DOWN_AFTER/UP_AFTER
# consecutive identical observations before it is committed and alerted.
# Secrets come from the systemd unit's EnvironmentFile.
set -uo pipefail

STATE_DIR="{{ fabric_watchdog_state_dir }}"
TIMEOUT="{{ fabric_watchdog_probe_timeout }}"
DOWN_AFTER="{{ fabric_watchdog_down_after }}"
UP_AFTER="{{ fabric_watchdog_up_after }}"
SLACK_TOKEN="${SLACK_BOT_TOKEN:-}"
SLACK_USER="${SLACK_ALLOWED_USERS:-}"
# Channel wins when provided; else DM the first allowed user (brain-watchdog
# convention — channel=<user id> DMs them).
SLACK_CHANNEL="${SLACK_ALERT_CHANNEL:-${SLACK_USER%%,*}}"

slack_post() {
  local text="$1"
  [[ -n "${SLACK_TOKEN}" && -n "${SLACK_CHANNEL}" ]] || return 0
  curl -fsS --max-time 10 -X POST https://slack.com/api/chat.postMessage \
    -H "Authorization: Bearer ${SLACK_TOKEN}" \
    -H "Content-Type: application/json; charset=utf-8" \
    --data "$(printf '{"channel":"%s","text":"%s"}' "${SLACK_CHANNEL}" "${text}")" \
    >/dev/null 2>&1 || true
}

mkdir -p "${STATE_DIR}"

{% for t in fabric_watchdog_targets %}
# --- {{ t.name }} ------------------------------------------------------------
{% if t.cmd is defined %}
# Command target. A URL probe can only ever answer "is that endpoint
# reachable", which is the wrong question whenever the fault is on this side of
# the boundary — a healthy service the agent has decided not to use looks
# identical to a healthy service it is using. For these targets the probe's
# EXIT STATUS is the code and ok_codes lists the statuses that count as UP.
#
# The probe's own output is carried into the alert, sanitised to one JSON-safe
# line, so the message states the verdict rather than merely that one occurred.
detail="$({{ t.cmd }} 2>&1)"; code=$?
# One JSON-safe line: octal \042 and \134 are the double quote and backslash,
# written that way because '"\\' reads ambiguously to both humans and linters.
detail="$(printf '%s' "${detail}" | tr '\n' ' ' | tr -d '\042\134' | cut -c1-200)"
{% else %}
# `|| echo 000` would DOUBLE the sentinel: curl prints %{http_code} as 000 on a
# connection failure AND exits non-zero, so the fallback appended a second 000
# and alerts read "returned HTTP 000000". Verified by reproduction. curl already
# supplies the sentinel; only a curl that produced no output at all needs one.
code="$(curl -sS -o /dev/null --max-time "${TIMEOUT}" -w '%{http_code}' '{{ t.url }}' 2>/dev/null)"
[[ -n "${code}" ]] || code=000
detail=""
{% endif %}
state="down"
# Substring membership: the padded ok_codes list is searched for the padded
# reading. Held in a variable so the matched word is not a constant.
ok_codes=" {{ t.ok_codes }} "
case "${ok_codes}" in *" ${code} "*) state="up" ;; esac
prev="$(cat "${STATE_DIR}/{{ t.name }}.state" 2>/dev/null || echo up)"
# Consecutive observations matching the CURRENT reading. Reset whenever the
# reading flips, so a flapping endpoint never accumulates its way to an edge.
last_obs="$(cat "${STATE_DIR}/{{ t.name }}.obs" 2>/dev/null || echo "${prev}")"
streak="$(cat "${STATE_DIR}/{{ t.name }}.streak" 2>/dev/null || echo 0)"
[[ "${streak}" =~ ^[0-9]+$ ]] || streak=0
if [[ "${state}" == "${last_obs}" ]]; then streak=$(( streak + 1 )); else streak=1; fi
printf '%s\n' "${state}" > "${STATE_DIR}/{{ t.name }}.obs"
printf '%s\n' "${streak}" > "${STATE_DIR}/{{ t.name }}.streak"

if [[ "${state}" != "${prev}" ]]; then
  if [[ "${state}" == "down" ]]; then needed="${DOWN_AFTER}"; else needed="${UP_AFTER}"; fi
  if (( streak >= needed )); then
    if [[ "${state}" == "down" ]]; then
{% if t.cmd is defined %}
      slack_post ":rotating_light: fabric watchdog: {{ t.name }} DOWN — probe exited ${code} (expected one of: {{ t.ok_codes }}) — ${detail}"
{% else %}
      slack_post ":rotating_light: fabric watchdog: {{ t.name }} DOWN — {{ t.url }} returned HTTP ${code} (expected one of: {{ t.ok_codes }})"
{% endif %}
    else
{% if t.cmd is defined %}
      slack_post ":white_check_mark: fabric watchdog: {{ t.name }} recovered — probe exited ${code} — ${detail}"
{% else %}
      slack_post ":white_check_mark: fabric watchdog: {{ t.name }} recovered — {{ t.url }} returned HTTP ${code}"
{% endif %}
    fi
    printf '%s\n' "${state}" > "${STATE_DIR}/{{ t.name }}.state"
  fi
fi
{% endfor %}

# --- Absence of success ------------------------------------------------------
# Everything above answers "is the fabric reachable", which stays green while
# every scheduled job fails or stops firing. This watches the other signal.
# Never allowed to fail the unit: a broken success watchdog must not take the
# reachability probes down with it.
python3 /usr/local/bin/cron-success-watchdog.py || \
  echo "cron-success-watchdog: FAILED (exit $?) — success absence is UNWATCHED this tick"

exit 0
