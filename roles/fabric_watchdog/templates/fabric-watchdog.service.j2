# {{ ansible_managed }}
[Unit]
Description=Fabric watchdog (MCP fabric + LLM front door probe, Slack on transition)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ fabric_watchdog_user }}
Group={{ fabric_watchdog_group }}
EnvironmentFile=-{{ fabric_watchdog_env_file }}
{% if fabric_watchdog_alert_channel | length > 0 %}
{# After the EnvironmentFile so it wins: systemd applies these in order. #}
Environment=SLACK_ALERT_CHANNEL={{ fabric_watchdog_alert_channel }}
{% endif %}
ExecStart=/usr/local/bin/fabric-watchdog.sh
