#!/usr/bin/env python3
{{ ansible_managed | comment }}
"""Alert on the ABSENCE OF SUCCESS in the scheduled-job fleet.

The endpoint probes in this role answer "is the fabric reachable". They say
nothing about whether scheduled work is still COMPLETING. A fleet whose jobs
all fail — or stop firing entirely — leaves every probe green, so the only
signal was an error per run, which is indistinguishable from ordinary noise and
identical in shape whether the fleet is dying or merely grumpy. Silence has to
page as loudly as failure.

The clock this watches is TIME SINCE THE LAST SUCCESSFUL RUN, per job. Never an
error count, never an error rate: a job that has stopped running at all emits no
errors, and a job erroring every tick emits them steadily forever.

Source of truth is the cron job store, read-only. Each record carries
`last_run_at`, `last_status` ("ok" on a clean run), `next_run_at` and the
`schedule` — the scheduler's own bookkeeping, so nothing here re-derives a
cron expression or needs a cron parser on the guest.

There is more than ONE such store: the scheduler runs a separate root per
profile, each with its own `cron/jobs.json`. Reading only the default root
leaves the guard blind to every profile-scoped job — and reports the fleet
healthy while doing it, which is worse than no guard at all. The roots are
therefore discovered from the filesystem on every tick, so a profile added or
removed needs no edit here. Job names are unique only WITHIN a store, so all
state and every message is keyed and labelled by (profile, job).

`last_run_at` records a RUN, not a SUCCESS: it advances on a failed run too.
So the success clock cannot be read straight off the store — a job failing every
tick keeps `last_run_at` fresh forever. Instead this keeps its own per-job memory
of the newest `last_run_at` it has ever OBSERVED carrying `last_status == "ok"`.
That memory is the last-success timestamp, and it stops advancing the moment a
job stops succeeding, however loudly it keeps failing.

Runs as a child of fabric-watchdog.sh, inheriting the same Slack environment.
"""

from __future__ import annotations

import glob
import json
import os
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

# --- Ansible-rendered configuration ------------------------------------------
JOBS_FILE = "{{ fabric_watchdog_cron_jobs_file }}"
# Every OTHER scheduler root, discovered rather than listed. A store lives at
# `<root>/cron/jobs.json`, so the profile roots sit beside the default one's.
# A glob means a profile appearing or disappearing needs no edit here, and a
# profile directory carrying no store yet simply does not match — that is a
# normal state, not an error, and it costs no log line every tick.
PROFILES_GLOB = os.path.join(
    os.path.dirname(os.path.dirname(JOBS_FILE)), "profiles", "*", "cron", "jobs.json"
)
STATE_PATH = "{{ fabric_watchdog_success_state_path }}"
# Multiple of a job's OWN cadence that may elapse with no success before it
# pages. A global fixed threshold cannot work across a fleet that mixes
# quarter-hourly and daily jobs: it either pages constantly on the daily ones or
# never on the frequent ones.
MISSED_CYCLES = {{ fabric_watchdog_success_missed_cycles }}
# Floor and ceiling on the derived threshold. The floor keeps a 1-minute job
# from paging over ordinary lateness; the ceiling keeps a daily job from being
# allowed to sit silent for most of a week.
FLOOR_MINUTES = {{ fabric_watchdog_success_floor_minutes }}
CEILING_MINUTES = {{ fabric_watchdog_success_ceiling_minutes }}
# Above this many jobs stale in one evaluation, post ONE fleet-wide message
# instead of one per job — a total fleet death must not arrive as a flood.
# Counted across ALL stores, not per store: this is a cap on messages in a
# channel, and a channel does not care which root a page came from. Per-store
# counting would let three stores at four stale jobs each post twelve separate
# pages while every store stayed under its own roll-up.
FLEET_ROLLUP_AT = {{ fabric_watchdog_success_fleet_rollup_at }}
# A paused store explains its own silence, so absence alerts are suppressed
# there. Past this long, the pause itself is the thing to report: an
# indefinitely stopped store is once again silence nobody has accounted for.
PAUSE_ALERT_MINUTES = {{ fabric_watchdog_success_pause_alert_minutes }}
# 2: state keys became (profile, job) — a schema-1 file's flat keys are
# ambiguous across profiles by construction. 3: added per-store pause records.
# Either way an older file is discarded rather than migrated.
STATE_SCHEMA = 3

SLACK_TOKEN = os.environ.get("SLACK_BOT_TOKEN", "")
SLACK_CHANNEL = (
    os.environ.get("SLACK_ALERT_CHANNEL")
    or os.environ.get("SLACK_ALLOWED_USERS", "").split(",")[0]
).strip()


def log(message: str) -> None:
    """Every evaluation, not just every firing.

    A prior watchdog in this estate exited 0 in silence for 28 consecutive ticks
    and hid a real halt for 14 minutes. Silent success is the failure mode this
    guard is designed against, so each job gets a decision line every tick and
    stdout is journald.
    """
    print(f"cron-success-watchdog: {message}", flush=True)


def slack_post(text: str) -> None:
    if not (SLACK_TOKEN and SLACK_CHANNEL):
        log(f"WOULD ALERT (no Slack token/channel configured): {text}")
        return
    body = json.dumps({"channel": SLACK_CHANNEL, "text": text}).encode()
    request = urllib.request.Request(
        "https://slack.com/api/chat.postMessage",
        data=body,
        headers={
            "Authorization": f"Bearer {SLACK_TOKEN}",
            "Content-Type": "application/json; charset=utf-8",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            response.read()
        log(f"alert posted: {text}")
    except (urllib.error.URLError, OSError, ValueError) as exc:
        # A watchdog that dies on its own notification path is worse than one
        # that reports it could not speak. The state write still happens, so
        # the episode is not re-announced on every subsequent tick either.
        log(f"ALERT DELIVERY FAILED ({exc}): {text}")


def parse_iso(value) -> float | None:
    """ISO-8601 to an epoch. Naive stamps are read as UTC, never local."""
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    return moment.timestamp()


def load_jobs(path: str) -> list:
    """Job records from one store. Never raises."""
    try:
        with open(path, encoding="utf-8-sig") as handle:
            store = json.load(handle)
    except (OSError, ValueError) as exc:
        log(f"cron store unreadable at {path} ({exc}) — nothing evaluated")
        return []
    jobs = store.get("jobs") if isinstance(store, dict) else store
    return jobs if isinstance(jobs, list) else []


def load_stores() -> list:
    """(profile, paused, jobs) for every scheduler root that carries a store.

    The default root is always read — a missing store there is a real defect and
    must say so. Profile roots come from the glob, so one without a store yet is
    absent from this list entirely and never produces an error or a log line.

    `paused` is the presence of the stop sentinel beside the store, nothing
    more. Anything that writes one — a converge draining in-flight work before a
    restart, or an operator by hand — means the same thing here: this store's
    silence is deliberate. The file's CONTENTS are never parsed. Whoever writes
    it may put an owner or timestamp inside for their own bookkeeping, and an
    empty or truncated one still means stopped; deciding engagement from a body
    this guard does not own would fail open exactly when a writer is interrupted.
    """
    found = [("default", JOBS_FILE)]
    for path in sorted(glob.glob(PROFILES_GLOB)):
        profile = os.path.basename(os.path.dirname(os.path.dirname(path)))
        found.append((profile, path))
    return [
        (profile, os.path.exists(os.path.join(os.path.dirname(os.path.dirname(path)), "ESTOP")), load_jobs(path))
        for profile, path in found
    ]


def cadence_seconds(job: dict) -> float | None:
    """The job's OWN interval, in seconds, or None when underivable.

    Preference order, both taken straight from the scheduler's bookkeeping:
      1. an interval schedule's declared `minutes`;
      2. `next_run_at - last_run_at`, which the scheduler computes from
         `last_run_at` for cron-expression jobs too — so one cadence falls out
         of the pair without parsing a cron expression here.

    The gap is only trustworthy when it was measured off a COMPLETED run. A job
    can be re-armed without running — `next_run_at` moves to a future time while
    `last_run_at` stays stale — and the gap then reads as the whole length of the
    outage rather than one cycle, inflating the threshold in the quiet direction
    exactly while the job is broken. `evaluate` therefore remembers the cadence
    it measured on a successful run and keeps using that; this live reading is
    only the bootstrap, before any success has been observed.
    """
    schedule = job.get("schedule")
    if isinstance(schedule, dict):
        if schedule.get("kind") == "once":
            return None  # a one-shot has no cadence and cannot be "overdue"
        minutes = schedule.get("minutes")
        if isinstance(minutes, (int, float)) and minutes > 0:
            return float(minutes) * 60
    last = parse_iso(job.get("last_run_at"))
    nxt = parse_iso(job.get("next_run_at"))
    if last is not None and nxt is not None and nxt > last:
        return nxt - last
    return None


def threshold_seconds(cadence: float) -> float:
    """Clamp MISSED_CYCLES of the job's own cadence into the sane band."""
    return min(max(cadence * MISSED_CYCLES, FLOOR_MINUTES * 60), CEILING_MINUTES * 60)


def load_state() -> dict:
    try:
        with open(STATE_PATH, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        return {"schema": STATE_SCHEMA, "jobs": {}, "stores": {}}
    if not isinstance(state, dict) or state.get("schema") != STATE_SCHEMA:
        return {"schema": STATE_SCHEMA, "jobs": {}, "stores": {}}
    state.setdefault("jobs", {})
    state.setdefault("stores", {})
    return state


def save_state(state: dict) -> None:
    tmp = f"{STATE_PATH}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(state, handle)
        os.replace(tmp, STATE_PATH)
    except OSError as exc:
        log(f"state write FAILED ({exc}) — this episode may re-announce")


def evaluate(stores: list, state: dict, now: float) -> tuple[list, list, list]:
    """Decide per job across every store. Returns (newly stale, newly
    recovered, stores newly paused too long) display names.

    Mutates `state` in place: advances each job's remembered last-success and
    flips its alerted latch. Every job gets a log line whatever is decided.
    Also stashes this tick's newly-triggered pool-wait alerts into
    `state["waited"]` (see the per-job loop below) rather than a fourth
    return value — every existing caller of evaluate()/run() already
    destructures a fixed-size tuple, and state is the channel this file
    already uses for anything that isn't itself part of the alerting
    contract those callers were written against.

    Both the state key and the display name carry the profile. A job name is
    unique only within its own store, so keying on the name alone would let two
    profiles that happen to share one share a single record — the healthy one
    would keep advancing the last-success clock and the stalled one could never
    page. The profile is a single path component, so `profile/job` is
    unambiguous.

    A paused store's jobs are reported as paused rather than stale. The pause
    does NOT reset the silence clock: the time a store spent stopped is banked
    per job and subtracted from its silence, so a job already stale going in is
    still stale coming out, while a healthy one is not charged for a maintenance
    window it could not have run in. Banking the interval rather than freezing
    the clock is what stops a repeated pause cycle from masking a job that has
    genuinely stopped succeeding.
    """
    memory = state["jobs"]
    store_memory = state["stores"]
    stale, recovered, paused_long, waited = [], [], [], []
    seen = set()

    # Read each store's previous pause state BEFORE the job loop; the loop banks
    # a closed interval per job, and the store records are rewritten after it.
    was_paused_since = {
        profile: store_memory.get(profile, {}).get("paused_since") for profile, _, _ in stores
    }

    for profile, paused, job in [(p, pa, j) for p, pa, jobs in stores for j in jobs]:
        if not isinstance(job, dict):
            continue
        job_id = str(job.get("id") or job.get("name") or "")
        if not job_id:
            continue
        key = f"{profile}/{job_id}"
        seen.add(key)
        name = f"{profile}/{job.get('name') or job_id}"
        record = memory.setdefault(key, {"last_ok": None, "alerted": False})

        if not job.get("enabled", True) or job.get("state") == "paused":
            # Deliberately off is not silence. Reset the latch so a resumed job
            # is judged from its resumption, not from a stale pre-pause clock.
            record["last_ok"] = None
            record["alerted"] = False
            log(f"{name}: SKIP (disabled or paused)")
            continue

        if paused:
            log(f"{name}: PAUSED (store stopped; absence alerts suppressed)")
            continue
        stopped_since = was_paused_since.get(profile)
        if stopped_since is not None:
            # First tick after a resume: bank what this store spent stopped, so
            # the interval is discounted from silence exactly once per job.
            banked = max(now - stopped_since, 0.0)
            record["paused"] = record.get("paused", 0.0) + banked
            log(f"{name}: RESUMED after {banked / 60:.0f}m stopped")

        last_run = parse_iso(job.get("last_run_at"))
        if job.get("last_status") == "ok" and last_run is not None:
            remembered = record.get("last_ok")
            if remembered is None or last_run > remembered:
                record["last_ok"] = last_run
                # A fresh success restarts the clock from that success, so any
                # pause banked before it is no longer being subtracted from
                # anything — drop it rather than let it accumulate forever.
                record["paused"] = 0.0
            # Pin the cadence to a reading taken off a completed run. A re-arm
            # without a run inflates the live gap, which would raise the
            # threshold the longer the job stays broken.
            measured = cadence_seconds(job)
            if measured is not None:
                record["cadence"] = measured

        if record.get("last_ok") is None:
            # No observed success yet: either a genuinely new job or one already
            # broken when this watchdog first saw it. Seeding the clock at now
            # gives it exactly one full threshold to prove itself, instead of
            # paging for a silence that predates any observation.
            record["last_ok"] = now
            record["alerted"] = False
            log(f"{name}: SEED (no observed success yet; clock starts now)")
            continue

        cadence = record.get("cadence") or cadence_seconds(job)
        if cadence is None:
            log(f"{name}: SKIP (no derivable cadence — one-shot or unscheduled)")
            continue

        # --- Pool-wait gauge --------------------------------------------
        # A different clock from the absence-of-success one below: this
        # watches time from a job's SCHEDULED slot to its run actually
        # starting, not time since a success — the signal that was missing
        # when a job held its store's single-threaded cron pool long enough
        # to starve its store-mates (they alerted nothing: no error, and
        # MISSED_CYCLES x their own cadence hadn't elapsed yet either).
        #
        # next_run_at can legitimately sit in the past while a job hasn't
        # fired yet for it — cadence_seconds()'s "re-armed without running"
        # case above documents the exact same fact — so that gap IS the
        # wait. Threshold is the job's OWN cadence: waiting at least one
        # full cycle is unambiguously notable on its own terms. Deriving a
        # job's tolerance from a DIFFERENT job's schedule (what an earlier
        # draft of this fix did, to derive a runtime ceiling instead of
        # measuring reality) is the category error this avoids by
        # construction — every input here belongs to the job being judged.
        next_run = parse_iso(job.get("next_run_at"))
        pending = (
            next_run is not None
            and next_run < now
            and (last_run is None or last_run <= next_run)
        )
        if pending:
            wait = now - next_run
            log(
                f"{name}: WAITING {wait / 60:.0f}m past its scheduled slot "
                f"(own cadence {cadence / 60:.0f}m)"
            )
            if wait > cadence and not record.get("wait_alerted"):
                record["wait_alerted"] = True
                waited.append(
                    f"{name} ({wait / 60:.0f}m past its scheduled slot, "
                    f"own cadence {cadence / 60:.0f}m)"
                )
        elif record.get("wait_alerted"):
            record["wait_alerted"] = False

        limit = threshold_seconds(cadence)
        silent = max(now - record["last_ok"] - record.get("paused", 0.0), 0.0)
        overdue = silent > limit
        detail = (
            f"{silent / 60:.0f}m since last success, "
            f"threshold {limit / 60:.0f}m ({MISSED_CYCLES}x its {cadence / 60:.0f}m cadence)"
        )

        if overdue and not record["alerted"]:
            record["alerted"] = True
            stale.append(f"{name} ({detail})")
            log(f"{name}: STALE -> alerting; {detail}")
        elif overdue:
            log(f"{name}: STALE (already alerted, staying quiet); {detail}")
        elif record["alerted"]:
            record["alerted"] = False
            recovered.append(name)
            log(f"{name}: RECOVERED; {detail}")
        else:
            log(f"{name}: ok; {detail}")

    for key in [k for k in memory if k not in seen]:
        del memory[key]
        log(f"{key}: FORGOTTEN (no longer in the job store)")

    for profile, is_paused, _ in stores:
        if not is_paused:
            store_memory.pop(profile, None)
            continue
        record = store_memory.setdefault(profile, {"paused_since": now, "alerted": False})
        stopped = now - record["paused_since"]
        if stopped > PAUSE_ALERT_MINUTES * 60 and not record["alerted"]:
            # Suppression cannot be unbounded. Past this long the pause has
            # stopped explaining the silence and has become the thing to report.
            record["alerted"] = True
            paused_long.append(f"{profile} ({stopped / 3600:.0f}h)")
            log(f"store {profile}: PAUSED TOO LONG -> alerting; stopped {stopped / 60:.0f}m")
        else:
            log(f"store {profile}: paused {stopped / 60:.0f}m")

    state["waited"] = waited
    return stale, recovered, paused_long


def main() -> int:
    now = time.time()
    stores = load_stores()
    state = load_state()
    for profile, paused, jobs in stores:
        log(f"evaluating {len(jobs)} job(s) from profile {profile}{' (PAUSED)' if paused else ''}")

    stale, recovered, paused_long = evaluate(stores, state, now)
    waited = state.get("waited", [])
    save_state(state)

    if len(stale) >= FLEET_ROLLUP_AT:
        slack_post(
            f":rotating_light: scheduled-work watchdog: {len(stale)} jobs have STOPPED "
            f"SUCCEEDING — no successful run within each job's own threshold. "
            f"Affected: {', '.join(stale)}"
        )
    else:
        for entry in stale:
            slack_post(
                f":rotating_light: scheduled-work watchdog: {entry} has produced no "
                f"successful run. Errors alone would not surface this."
            )
    for name in recovered:
        slack_post(f":white_check_mark: scheduled-work watchdog: {name} is succeeding again")
    for entry in paused_long:
        slack_post(
            f":warning: scheduled-work watchdog: store {entry} has been paused this "
            f"long. Absence alerts there are suppressed, so nothing in it is being "
            f"watched — resume it or confirm the pause is intended."
        )
    for entry in waited:
        slack_post(
            f":hourglass_flowing_sand: scheduled-work watchdog: {entry} waited "
            f"longer than its own scheduling period before starting. Not "
            f"necessarily a failure yet — if it recurs, something is holding "
            f"the store's single-threaded cron pool."
        )

    log(
        f"done: {len(stale)} newly stale, {len(recovered)} recovered, "
        f"{len(paused_long)} paused too long, {len(waited)} newly waited"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
