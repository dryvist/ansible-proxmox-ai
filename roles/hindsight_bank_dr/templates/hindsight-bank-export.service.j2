[Unit]
# {{ ansible_managed }}
Description=Nightly logical export of every Hindsight bank to object storage
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hindsight-bank-dr.env
SyslogIdentifier={{ hindsight_bank_dr_syslog_identifier }}
ExecStart=/usr/local/bin/hindsight-bank-export.sh
# Exporting every bank plus the S3 upload is I/O-bound, not CPU-bound; never
# let a slow bank or a slow uplink wedge the timer forever.
TimeoutStartSec=3600
