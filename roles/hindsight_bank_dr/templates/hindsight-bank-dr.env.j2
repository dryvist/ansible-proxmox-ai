# {{ ansible_managed }}
# Scoped RustFS rw credentials for the hindsight-bank-exports bucket only —
# never a root/admin key (secrets-separation.md "Object storage"). Read as
# real process environment by both the export and drill units via
# EnvironmentFile=; never baked into the scripts themselves.
AWS_ACCESS_KEY_ID={{ hindsight_bank_dr_s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ hindsight_bank_dr_s3_secret_access_key }}
AWS_DEFAULT_REGION={{ hindsight_bank_dr_s3_region }}
S3_ENDPOINT={{ hindsight_bank_dr_s3_endpoint }}
