[Unit]
# {{ ansible_managed }}
Description=Hindsight bank logical-restore drill (import + recall + timing)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hindsight-bank-dr.env
SyslogIdentifier={{ hindsight_bank_dr_syslog_identifier }}
ExecStart=/usr/local/bin/hindsight-bank-dr-drill.sh
# A re-embedding import of a whole bank is the more expensive of the two jobs.
TimeoutStartSec=3600
