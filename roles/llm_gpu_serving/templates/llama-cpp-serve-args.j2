{# Shared llama-server flags for a GGUF profile; the caller sets lc_profile,
   lc_artifact, lc_alias, lc_model_dir and lc_host. Every line but the last
   ends in a continuation, so the caller's ExecStart stays one command. The
   shared context is the per-agent context times the slot count, one slot per
   concurrent agent. Tool calls are template-driven (--jinja); llama.cpp has
   no tool-call parser flag. #}
  --model {{ lc_model_dir }}/{{ lc_artifact.gguf_file }} \
  --host {{ lc_host }} \
  --port {{ lc_profile.port }} \
  --alias {{ lc_alias }} \
  --ctx-size {{ lc_profile.max_model_len | int * lc_profile.max_num_seqs | int }} \
  --parallel {{ lc_profile.max_num_seqs }} \
  --n-gpu-layers {{ lc_profile.gpu_layers | default(99) }} \
{% if lc_profile.flash_attention | default(true) %}
  --flash-attn on \
{% endif %}
{% if lc_profile.kv_cache_dtype is defined %}
  --cache-type-k {{ lc_profile.kv_cache_dtype }} \
  --cache-type-v {{ lc_profile.kv_cache_dtype }} \
{% endif %}
{% if lc_profile.reasoning_format is defined %}
  --reasoning-format {{ lc_profile.reasoning_format }} \
{% endif %}
{% for arg in lc_profile.extra_args | default([]) %}
  {{ arg }} \
{% endfor %}
  --metrics \
  --jinja
