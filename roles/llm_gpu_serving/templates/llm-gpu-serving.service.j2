{{ ansible_managed | comment }}
[Unit]
Description=GPU model serving profile {{ llm_gpu_serving_profile_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ llm_gpu_serving_user }}
Group={{ llm_gpu_serving_group }}
WorkingDirectory={{ llm_gpu_serving_data_dir }}
Environment=HF_HOME={{ llm_gpu_serving_hf_home }}
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
{% set tool_call_parser = llm_gpu_serving_profile_registry_model.artifact.tool_call_parser | default(llm_gpu_serving_profile.tool_call_parser) %}
{% set reasoning_parser = llm_gpu_serving_profile_registry_model.artifact.reasoning_parser | default(llm_gpu_serving_profile.reasoning_parser) %}
{% if llm_gpu_serving_profile.engine == 'llama_cpp' %}
Environment=LD_LIBRARY_PATH={{ llm_gpu_serving_llamacpp_install_dir }}
{% endif %}
{% if llm_gpu_serving_profile.engine == 'vllm' %}
# FlashInfer's top-k/top-p sampler JIT-compiles with nvcc on first use; the
# guest has no CUDA toolkit, so use vLLM's prebuilt PyTorch sampler instead.
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
{% endif %}
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
{% if llm_gpu_serving_profile.engine == 'vllm' %}
ExecStart={{ llm_gpu_serving_venv }}/bin/vllm serve {{ llm_gpu_serving_profile_model_dir }} \
  --host {{ llm_gpu_serving_listen_host | default(ansible_facts.default_ipv4.address) }} \
  --port {{ llm_gpu_serving_profile.port }} \
  --served-model-name {{ llm_gpu_serving_profile_registry_model.upstream_model_id }} \
  --max-model-len {{ llm_gpu_serving_profile.max_model_len }} \
  --max-num-seqs {{ llm_gpu_serving_profile.max_num_seqs }} \
  --gpu-memory-utilization {{ llm_gpu_serving_profile.gpu_memory_utilization }} \
{% if llm_gpu_serving_profile.linear_backend == 'b12x' %}
  --linear-backend b12x \
{% endif %}
{% if llm_gpu_serving_profile.moe_backend == 'b12x' %}
  --moe-backend b12x \
{% endif %}
{% if llm_gpu_serving_profile_registry_model.artifact.quantization == 'BF16' %}
  --dtype bfloat16 \
{% endif %}
{% if llm_gpu_serving_profile.enable_auto_tool_choice %}
  --enable-auto-tool-choice \
{% endif %}
{% if tool_call_parser | length > 0 %}
  --tool-call-parser {{ tool_call_parser }} \
{% endif %}
  --reasoning-parser {{ reasoning_parser | mandatory('reasoning_parser is required for vLLM profiles') }}
{% elif llm_gpu_serving_profile.engine == 'llama_cpp' %}
{% set lc_profile = llm_gpu_serving_profile %}
{% set lc_artifact = llm_gpu_serving_profile_registry_model.artifact %}
{% set lc_alias = llm_gpu_serving_profile_registry_model.upstream_model_id %}
{% set lc_model_dir = llm_gpu_serving_profile_model_dir %}
{% set lc_host = llm_gpu_serving_listen_host | default(ansible_facts.default_ipv4.address) %}
ExecStart={{ llm_gpu_serving_llamacpp_server_bin }} \
{% include 'llama-cpp-serve-args.j2' %}

{% endif %}

[Install]
WantedBy=multi-user.target
