{
  "host": {{ llm_gpu_serving_listen_host | default(ansible_facts.default_ipv4.address) | to_json }},
  "port": {{ llm_gpu_serving_profile.port | int }},
  "backend": {{ llm_gpu_serving_audio_cpp_backend | to_json }},
  "threads": {{ llm_gpu_serving_audio_cpp_threads | int }},
  "lazy_load": true,
  "max_loaded_models": {{ llm_gpu_serving_profile_registry_model.audio_cpp_models | length }},
  "log_request_body": false,
  "models": [
{% for m in llm_gpu_serving_profile_registry_model.audio_cpp_models %}
    {"id": {{ m.id | to_json }}, "family": {{ m.family | to_json }}, "path": {{ m.path | to_json }}, "task": {{ m.task | to_json }}, "mode": "offline"}{{ ',' if not loop.last }}
{% endfor %}
  ]
}
