{{ ansible_managed | comment }}
[Unit]
Description=Safety-net baseline restore for trial {{ llm_model_trial_id }}

StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start {{ llm_model_trial_baseline_unit }}
# Retries while the candidate may still be releasing GPU memory.
Restart=on-failure
RestartSec=30
