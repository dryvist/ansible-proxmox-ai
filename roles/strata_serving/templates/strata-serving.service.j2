{{ ansible_managed | comment }}
[Unit]
Description=Strata Qwen3.8 IQ3_S model server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ nvidia_gpu_guest_user }}
Group={{ nvidia_gpu_guest_group }}
WorkingDirectory={{ strata_serving_source_dir }}
Environment=STRATA_REQUEST_LINES={{ strata_serving_request_lines }}
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
ExecStart={{ strata_serving_run_script }}

[Install]
WantedBy=multi-user.target
