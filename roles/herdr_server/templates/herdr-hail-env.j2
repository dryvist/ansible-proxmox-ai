# {{ ansible_managed }}
# herdr-hail environment. Mode 0600, owned by {{ herdr_server_user }} — the
# bridge runs as the same user as the server whose socket it reads.
#
# A Slack bot token is a live credential for a workspace; it never goes into
# the Nix store, which is world-readable, and never into a 0640 config file.
#
# These names are fixed by upstream (src/config.ts) and override the matching
# fields of config.json. The per-channel `enabled` flag has NO env override,
# so switching Slack on is nix-ai's job, not this file's — tokens here with
# the flag unset produce a running bridge that delivers nothing.
{% if herdr_server_hail_slack_bot_token | length > 0 %}
SLACK_BOT_TOKEN={{ herdr_server_hail_slack_bot_token }}
{% endif %}
{% if herdr_server_hail_slack_app_token | length > 0 %}
SLACK_APP_TOKEN={{ herdr_server_hail_slack_app_token }}
{% endif %}
{% if herdr_server_hail_slack_channel | length > 0 %}
SLACK_CHANNEL={{ herdr_server_hail_slack_channel }}
{% endif %}
{% if herdr_server_hail_slack_allowed_users | length > 0 %}
SLACK_ALLOWED_USERS={{ herdr_server_hail_slack_allowed_users }}
{% endif %}
{% for key, value in (herdr_server_hail_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
