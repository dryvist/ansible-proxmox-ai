# {{ ansible_managed }}
# herdr server environment. Mode 0600, owned by {{ herdr_server_user }}.
# Loaded by herdr.service via `EnvironmentFile=-`, so a missing or empty file
# leaves the unit running but credential-less rather than failing to start.
#
# Nothing here may move into the Nix store: the store is world-readable, and
# these are live credentials.
{% if herdr_server_model_base_url | length > 0 %}
OPENAI_BASE_URL={{ herdr_server_model_base_url }}
{% endif %}
{% if herdr_server_model_api_key | length > 0 %}
OPENAI_API_KEY={{ herdr_server_model_api_key }}
{% endif %}
{% if herdr_server_anthropic_api_key | length > 0 %}
ANTHROPIC_API_KEY={{ herdr_server_anthropic_api_key }}
{% endif %}
{% if herdr_server_openai_api_key | length > 0 %}
OPENAI_API_KEY_DIRECT={{ herdr_server_openai_api_key }}
{% endif %}
{% for key, value in (herdr_server_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
