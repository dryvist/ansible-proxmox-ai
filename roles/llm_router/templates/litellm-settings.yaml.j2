litellm_settings:
  # 2026-09-12: dropped "otel" from callbacks.
  #
  # "prometheus" is NOT a tracing sink. It is the only shipped consumer of the
  # router's fallback events, and the only thing in this proxy that records
  # the model group originally ASKED FOR next to the one that served.
  # Rationale and the trap it replaces: defaults/main/60-ops.yml.
  #
  # fast_subagent_lock only alongside a configured spend store — same gate the
  # Redis block above uses, since the lock has nowhere to live without one.
  # Rationale, gated model set, TTL: defaults/main/57-subagent-lock.yml.
  #
  # system_merge folds every system/developer message into one leading system
  # message, in front of every deployment: the MLX backends 404 on any other
  # shape and 404 is neither retried nor fallen back from. files/callbacks/
  # system_merge.py has the failing request shape (every Responses-API turn).
  #
  # request_metrics emits one structured JSON line per request (model_group,
  # answering model, latency, status, key alias — never prompt/response
  # content) to stdout, already shipped by this unit's journal route to
  # index=llm. files/callbacks/request_metrics.py; SPL in README.md.
  #
  # A flow sequence on the key's own line. Under a folded scalar (`>-`) the
  # JSON text became one YAML STRING and LiteLLM tried to import a module
  # literally named `["prometheus", ...` — every router crash-looped.
  callbacks: {{ ((['prometheus'] if llm_router_prometheus_enabled | bool else [])
        + (['fast_subagent_lock.proxy_handler_instance'] if llm_router_redis_host | length > 0 else [])
        + ['system_merge.proxy_handler_instance', 'request_metrics.proxy_handler_instance'])
       | to_json }}
  drop_params: true
{% if llm_router_large_passthrough_enabled | bool %}
  # Resolve the wildcard against the gate's live /v1/models so this proxy's
  # own /v1/models lists every passthrough model (not just the aliases) —
  # Open WebUI's picker and Hermes both read that listing.
  check_provider_endpoint: true
{% endif %}
