litellm_settings:
  # Send OTel through the shared collector so Cribl owns the trace fan-out.
  # message_logging stays off: traces carry request metadata and usage, never
  # prompt or response bodies. Prometheus counters use the same registry-backed
  # deployment tags below and flow through Cribl remote_write.
  #
  # "prometheus" is NOT a second tracing sink. It is the only shipped consumer
  # of the router's fallback events, and the only thing in this proxy that
  # records the model group originally ASKED FOR next to the one that served.
  # Rationale and the trap it replaces: defaults/main/60-ops.yml.
  #
  # system_merge folds every system/developer message into one leading system
  # message, in front of every deployment: the MLX backends 404 on any other
  # shape and 404 is neither retried nor fallen back from. files/callbacks/
  # system_merge.py has the failing request shape (every Responses-API turn).
  #
  # request_metrics emits one structured JSON line per request (model_group,
  # answering model, latency, status, key alias — never prompt/response
  # content) to stdout, already shipped by this unit's journal route to
  # index=llm. files/callbacks/request_metrics.py; SPL in README.md.
  #
  # A flow sequence on the key's own line. Under a folded scalar (`>-`) the
  # JSON text became one YAML STRING and LiteLLM tried to import a module
  # literally named `["prometheus", ...` — every router crash-looped.
  callbacks: {{ (['otel'] + (['langfuse_otel'] if llm_router_langfuse_enabled | bool else [])
        + (['prometheus'] if llm_router_prometheus_enabled | bool else [])
        + ['system_merge.proxy_handler_instance', 'request_metrics.proxy_handler_instance'])
       | to_json }}
  callback_settings:
    otel:
      message_logging: false
{% if llm_router_langfuse_enabled | bool %}
    langfuse_otel:
      message_logging: false
{% endif %}
  drop_params: true
{% set telemetry = namespace(tags=[]) %}
{% for tags in llm_router_deployment_tags_by_entry.values() %}
{% for tag in tags %}
{% if tag.startswith('telemetry_') and tag not in telemetry.tags %}
{% set telemetry.tags = telemetry.tags + [tag] %}
{% endif %}
{% endfor %}
{% endfor %}
  custom_prometheus_tags: {{ telemetry.tags | to_json }}
{% if llm_router_large_passthrough_enabled | bool %}
  # Resolve the wildcard against the gate's live /v1/models so this proxy's
  # own /v1/models lists every passthrough model (not just the aliases) —
  # Open WebUI's picker and Hermes both read that listing.
  check_provider_endpoint: true
{% endif %}
{% if llm_router_redis_host | length > 0 %}
  # Response cache in the shared store, OPT-IN per request (`cache: {use-cache:
  # true}`), so no caller's behaviour changes unless it asks. The cache's Redis
  # client also becomes the proxy's coordination store: key/team/user rate
  # limits, spend counters, the database spend buffer and the shared health
  # check all count across every router instead of per router. Every Redis
  # error falls back to in-memory per-router state; no request is refused for
  # the store being down.
  cache: true
  cache_params:
    type: redis
    host: os.environ/LLM_ROUTER_REDIS_HOST
    port: {{ llm_router_redis_port }}
    password: os.environ/LLM_ROUTER_REDIS_PASSWORD
    db: {{ llm_router_cache_redis_db }}
    mode: default_off
    ttl: {{ llm_router_response_cache_ttl }}
  # Virtual-key lookups shared across routers, so a revoked or changed key
  # takes effect on every router at once. Store down: lookups fall back to the
  # database.
  enable_redis_auth_cache: true
{% endif %}
