{{ ansible_managed | comment }}
[Unit]
Description=Compute the LiteLLM serving-share metric daily over a 7-day window

[Timer]
# Daily, over a trailing 7-day window, so each week's number is reported seven
# times and a single bad day is visible as a step rather than lost in one
# weekly sample. Persistent so a reboot across the boundary still fires.
OnCalendar={{ llm_router_serving_share_on_calendar }}
Persistent=true
# Every router in the pool runs this; the spread keeps three identical queries
# off the shared database in the same second. Duplicates are harmless — the
# line carries computed_at and the query is read-only.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
