{{ ansible_managed | comment }}
# LiteLLM proxy secrets + observability endpoints (systemd EnvironmentFile). The
# config.yaml references these via os.environ/. Never commit real values.
LLM_ROUTER_MASTER_KEY={{ llm_router_master_key }}
LLM_LARGE_BEARER_TOKEN={{ llm_router_llm_large_bearer }}
{% if llm_router_hermes_agent_bearer | trim | length > 0 %}
# Shared bearer for every Hermes AGENT deployment (the same value the
# hermes_agent role writes as API_SERVER_KEY on each agent guest). Emitted only
# when it resolved; the hermes-agent block in the model list is gated on the
# same condition, so a deployment can never be advertised without its key.
HERMES_AGENT_BEARER_TOKEN={{ llm_router_hermes_agent_bearer }}
{% endif %}
{% if llm_router_llm_large_standby_base_url %}
# Standby (off-Studio) large-tier bearer — only emitted when a standby backend
# URL is configured; see llm_router_llm_large_standby_base_url in defaults.
LLM_LARGE_STANDBY_BEARER_TOKEN={{ llm_router_llm_large_standby_bearer }}
{% endif %}
# LiteLLM boxes every retry backoff into [router_settings.retry_after,
# MAX_RETRY_DELAY] and reads that ceiling only from the environment (default 8s),
# so without this the configured retry_after is silently clamped.
MAX_RETRY_DELAY={{ llm_router_retry_max_delay_seconds }}
{% if llm_router_redis_host | length > 0 %}
# Shared spend store for the router pool (roles/redis). config.yaml references
# these via os.environ/, so the password never lands in the rendered config.
# The port is not here: it is a non-secret constant rendered inline instead —
# see the note in config.yaml.j2. Emitted only when a store is configured — the
# budget block in config.yaml is gated on the same condition, so the two cannot
# separate.
LLM_ROUTER_REDIS_HOST={{ llm_router_redis_host }}
LLM_ROUTER_REDIS_PASSWORD={{ llm_router_redis_password }}
{% endif %}
{% if llm_router_db_host | length > 0 %}
# Postgres backing the Adaptive Router's learned quality estimates. Emitted only
# when a database is configured; the general_settings block in config.yaml is
# gated on the same condition, so the two cannot separate. The whole URL is a
# secret (it carries the password), so config.yaml references it via
# os.environ/ and it never lands in the rendered config.
DATABASE_URL=postgresql://{{ llm_router_db_user }}:{{ llm_router_db_password | urlencode }}@{{ llm_router_db_host }}:{{ llm_router_db_port }}/{{ llm_router_db_name }}?max_idle_connection_lifetime={{ llm_router_db_max_idle_connection_lifetime }}
{% if llm_router_store_model_in_db | bool %}
# STORE_MODEL_IN_DB duplicates general_settings.store_model_in_db on purpose:
# LiteLLM reads the environment variable during startup, before the config file
# is parsed, and the /model and /fallback management endpoints refuse writes
# unless it was set at that point. Both come from one role variable, so they
# cannot disagree.
STORE_MODEL_IN_DB=True
# Admin UI sign-in (/ui). Read only from the environment.
UI_USERNAME={{ llm_router_ui_username }}
UI_PASSWORD={{ llm_router_ui_password }}
{% endif %}
{% endif %}
# OTLP/HTTP traces to the Cribl Edge collector (otlp_http wants the full signal path).
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT={{ llm_router_otel_endpoint }}/v1/traces
{% set _credential_ns = namespace(emitted=[]) %}
{% for m in (llm_router_openrouter_models + llm_router_hermes_cloud_models_credentialed) %}
{% if m.credential_env not in _credential_ns.emitted %}
{% set _provider_key = bao_local_llm_secrets[m.key_field] | default(lookup('env', m.credential_env), true) %}
{% if _provider_key | trim | length > 0 %}
# One LiteLLM credential for the {{ m.provider }} API provider. Model access is
# constrained by the rendered model_list and provider policy, not by extra keys.
{{ m.credential_env }}={{ _provider_key }}
{% set _credential_ns.emitted = _credential_ns.emitted + [m.credential_env] %}
{% endif %}
{% endif %}
{% endfor %}
