{{ ansible_managed | comment }}
# LiteLLM proxy secrets + observability endpoints (systemd EnvironmentFile). The
# config.yaml references these via os.environ/. Never commit real values.
LITELLM_ENABLE_MCP_STDIO=true
LLM_ROUTER_ZAMMAD_URL={{ llm_router_mcp_zammad_url }}
LLM_ROUTER_ZAMMAD_HTTP_TOKEN={{ llm_router_mcp_zammad_http_token }}
{% if llm_router_mcp_slack_enabled | bool %}
LLM_ROUTER_SLACK_BOT_TOKEN={{ llm_router_mcp_slack_bot_token }}
LLM_ROUTER_SLACK_TEAM_ID={{ llm_router_slack_team_id }}
{% endif %}
LLM_ROUTER_MASTER_KEY={{ llm_router_master_key }}
LLM_LARGE_BEARER_TOKEN={{ llm_router_llm_large_bearer }}
{% if llm_router_hermes_agent_bearer | trim | length > 0 %}
# Shared bearer for every Hermes AGENT deployment (the same value the
# hermes_agent role writes as API_SERVER_KEY on each agent guest). Emitted only
# when it resolved; the hermes-agent block in the model list is gated on the
# same condition, so a deployment can never be advertised without its key.
HERMES_AGENT_BEARER_TOKEN={{ llm_router_hermes_agent_bearer }}
{% endif %}
{% if llm_router_llm_large_standby_base_url %}
# Standby (off-Studio) large-tier bearer — only emitted when a standby backend
# URL is configured; see llm_router_llm_large_standby_base_url in defaults.
LLM_LARGE_STANDBY_BEARER_TOKEN={{ llm_router_llm_large_standby_bearer }}
{% endif %}
# LiteLLM boxes every retry backoff into [router_settings.retry_after,
# MAX_RETRY_DELAY] and reads that ceiling only from the environment (default 8s),
# so without this the configured retry_after is silently clamped.
MAX_RETRY_DELAY={{ llm_router_retry_max_delay_seconds }}
# chatgpt/ provider: per-node OAuth login file (tasks/chatgpt-auth.yml).
CHATGPT_TOKEN_DIR={{ llm_router_chatgpt_token_dir }}
{% if llm_router_redis_host | length > 0 %}
# Shared spend store for the router pool (roles/redis). config.yaml references
# these via os.environ/, so the password never lands in the rendered config.
# The port is not here: it is a non-secret constant rendered inline instead —
# see the note in config.yaml.j2. Emitted only when a store is configured — the
# budget block in config.yaml is gated on the same condition, so the two cannot
# separate.
LLM_ROUTER_REDIS_HOST={{ llm_router_redis_host }}
LLM_ROUTER_REDIS_PASSWORD={{ llm_router_redis_password }}
{% endif %}
{% if llm_router_db_host | length > 0 %}
# Postgres backing the Adaptive Router's learned quality estimates. Emitted only
# when a database is configured; the general_settings block in config.yaml is
# gated on the same condition, so the two cannot separate. The whole URL is a
# secret (it carries the password), so config.yaml references it via
# os.environ/ and it never lands in the rendered config.
DATABASE_URL=postgresql://{{ llm_router_db_user }}:{{ llm_router_db_password | urlencode }}@{{ llm_router_db_host }}:{{ llm_router_db_port }}/{{ llm_router_db_name }}?max_idle_connection_lifetime={{ llm_router_db_max_idle_connection_lifetime }}
{% if llm_router_store_model_in_db | bool %}
# Keep LiteLLM's 1.104 startup Prisma migration check explicit and fail-closed.
# The schema is reconciled by main.yml first; startup verifies migration setup
# and exits on mismatch instead of serving against an unverified database.
ENFORCE_PRISMA_MIGRATION_CHECK=True
# STORE_MODEL_IN_DB duplicates general_settings.store_model_in_db on purpose:
# LiteLLM reads the environment variable during startup, before the config file
# is parsed, and the /model and /fallback management endpoints refuse writes
# unless it was set at that point. Both come from one role variable, so they
# cannot disagree.
STORE_MODEL_IN_DB=True
{% endif %}
{% endif %}
{% if llm_router_oidc_enabled | bool %}
# Authelia SSO for the admin UI (generic OIDC), the only UI sign-in. The
# redirect target is <PROXY_BASE_URL>/sso/callback. This block is emitted only
# when the OIDC client secret resolved (see 65-oidc.yml), so SSO can never be
# half-configured; general-settings.yaml.j2 turns password login off on the
# same condition.
GENERIC_CLIENT_ID={{ llm_router_oidc_client_id }}
GENERIC_CLIENT_SECRET={{ llm_router_oidc_client_secret }}
GENERIC_AUTHORIZATION_ENDPOINT={{ llm_router_oidc_authorization_endpoint }}
GENERIC_TOKEN_ENDPOINT={{ llm_router_oidc_token_endpoint }}
GENERIC_USERINFO_ENDPOINT={{ llm_router_oidc_userinfo_endpoint }}
PROXY_BASE_URL={{ llm_router_oidc_proxy_base_url }}
GENERIC_USER_ID_ATTRIBUTE={{ llm_router_oidc_user_id_attribute }}
GENERIC_SCOPE={{ llm_router_oidc_scope }}
PROXY_ADMIN_ID={{ llm_router_oidc_admin_email }}
AUTO_REDIRECT_UI_LOGIN_TO_SSO=true
{% endif %}
# LiteLLM OTel traces go to the shared collector, where Cribl owns fan-out.
LITELLM_OTEL_V2=true
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT={{ ai_orchestration_otel_endpoint }}
{% if llm_router_langfuse_enabled | bool %}
# Direct Langfuse export (langfuse_otel callback). Message bodies stay off:
# the capture mode is pinned to no_content, as with the shared collector path.
LANGFUSE_PUBLIC_KEY={{ llm_router_langfuse_public_key }}
LANGFUSE_SECRET_KEY={{ llm_router_langfuse_secret_key }}
LANGFUSE_HOST={{ llm_router_langfuse_host }}
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
{% endif %}
# Sets the three named LiteLLM loggers to INFO at proxy init
# (proxy_server.py initialize(), the not-debug branch), which is where routing
# decisions are logged. The handler LiteLLM attaches at import already admits
# INFO and carries the secret-redaction filter; nothing here touches it.
# Rationale and the mistake this replaces: defaults/main/60-ops.yml.
LITELLM_LOG={{ llm_router_log_level | upper }}
{% set _credential_ns = namespace(emitted=[]) %}
{% for m in (llm_router_openrouter_models + llm_router_opencode_models + llm_router_hermes_cloud_models_credentialed + llm_router_zai_models) %}
{# Every credential-gated entry declares its own credential_env, resolved
   once for the whole registry (20-registry.yml, llm_router_resolved_credentials)
   — the same dict the render-time gates above use, so a value that dict
   already rejected (empty, or a local-backend placeholder such as "local")
   can never land in the proxy's own environment either. #}
{% set _cred_env = m.credential_env %}
{% if _cred_env not in _credential_ns.emitted %}
{% set _provider_key = llm_router_resolved_credentials.get(_cred_env, '') %}
{% if _provider_key | length > 0 %}
# One LiteLLM credential for the {{ m.provider }} API provider. Model access is
# constrained by the rendered model_list and provider policy, not by extra keys.
{{ _cred_env }}={{ _provider_key }}
{% set _credential_ns.emitted = _credential_ns.emitted + [_cred_env] %}
{% endif %}
{% endif %}
{% endfor %}
