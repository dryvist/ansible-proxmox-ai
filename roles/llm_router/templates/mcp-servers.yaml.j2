# Stdio MCP credentials resolve from the root-owned systemd EnvironmentFile.
mcp_servers:
  zammad:
    transport: stdio
    server_id: "{{ llm_router_mcp_zammad_server_id }}"
    command: "{{ llm_router_mcp_zammad_command }}"
    args: {{ llm_router_mcp_zammad_args | to_json }}
    allow_all_keys: false
    env:
      ZAMMAD_URL: os.environ/LLM_ROUTER_ZAMMAD_URL
      ZAMMAD_HTTP_TOKEN: os.environ/LLM_ROUTER_ZAMMAD_HTTP_TOKEN
    allowed_tools: {{ llm_router_mcp_zammad_allowed_tools | to_json }}
  slack:
    transport: stdio
    server_id: "{{ llm_router_mcp_slack_server_id }}"
    command: "{{ llm_router_mcp_slack_command }}"
    args: {{ llm_router_mcp_slack_args | to_json }}
    allow_all_keys: false
    env:
      SLACK_BOT_TOKEN: os.environ/LLM_ROUTER_SLACK_BOT_TOKEN
      SLACK_TEAM_ID: os.environ/LLM_ROUTER_SLACK_TEAM_ID
    allowed_tools: {{ llm_router_mcp_slack_allowed_tools | to_json }}
