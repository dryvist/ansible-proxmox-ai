{# Deployment list for the managed LiteLLM proxy config; included by
   config.yaml.j2, which owns the surrounding settings blocks. Split out so
   each file stays inside the repo's per-file token budget. #}
{# Delegation hints — projected VERBATIM from the registry entry so a consumer
   choosing a tier reads speed/quality/best_for from /model/info rather than
   from a model name written into a skill. Flow style on one line: the shape is
   the registry's, and this template does not get an opinion about it. #}
{% macro delegation_hints(m) -%}
{% if m.hints is defined %}{{ "\n" }}      hints: {{ m.hints | to_json }}{% endif %}
{%- endmacro %}
{% macro litellm_model(m) %}{{ m.litellm_model_name | default(m.provider ~ '/' ~ m.upstream_model_id) }}{% endmacro %}
{# Admission bounds every LOCAL rung carries (defaults/main/40-routing.yml,
   "ADMISSION BUDGET"): the first-byte bound is the capacity signal, the
   retry count is the whole retry budget; an entry may declare tighter
   figures, never looser. The whole-call timeout stays generation-sized.

   `timeout` (non-streaming) is mandatory: LiteLLM picks stream_timeout
   only for streaming calls (litellm/router.py _get_timeout); non-streaming
   falls through to the 2400s litellm_settings.request_timeout otherwise —
   confirmed live 2026-09-19, a non-streaming rung with no bound of its
   own rode that ceiling before the caller saw litellm.Timeout. #}
{% macro local_bounds(m) %}
      num_retries: {{ [m.num_retries | default(llm_router_local_num_retries), llm_router_local_num_retries] | min }}
      stream_timeout: {{ [m.stream_timeout | default(llm_router_local_stream_timeout_seconds), llm_router_local_stream_timeout_seconds] | min }}
      timeout: {{ [m.request_timeout | default(llm_router_local_request_timeout_seconds), llm_router_local_request_timeout_seconds] | min }}
{% endmacro %}
model_list:
{% include 'model-list-hermes-agents.yaml.j2' %}
  # --- Hermes-only local complexity router ---
{% for m in llm_router_hermes_virtual_models %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ llm_router_routine_model }}
          MEDIUM: {{ llm_router_routine_model }}
          COMPLEX: {{ llm_router_primary_model }}
          REASONING: {{ llm_router_primary_model }}
        default_model: {{ llm_router_primary_model }}
    model_info:
      mode: chat
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.max_output_tokens }}{{ delegation_hints(m) }}
{% endfor %}

  # Provider-specific cloud value routers reclassify without an API call.
{% for m in llm_router_hermes_cloud_router_models_credentialed %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ m.routine_model }}
          MEDIUM: {{ m.routine_model }}
          COMPLEX: {{ m.agentic_model }}
          REASONING: {{ m.agentic_model }}
        default_model: {{ m.agentic_model }}
    model_info:
      mode: chat
      max_input_tokens: {{ m.context_window }}
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}{{ delegation_hints(m) }}
{% endfor %}

  # --- large tier: one deployment each, bearer-authed to llm-large ---
  # Exact tuned model names take precedence over the optional wildcard.
{% for m in llm_router_large_models %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
      # /v1/responses -> /chat/completions bridge. None of these backends serve
      # a Responses endpoint, and without this a Responses-only client (Codex
      # and anything else speaking that wire protocol) reaches a 404 on an
      # otherwise healthy deployment. LiteLLM treats this as an internal control
      # flag and never forwards it in the upstream request body.
      use_chat_completions_api: true
      # Queue excess work at the router instead of flooding the backend.
      # Per-entry: mirrors THIS model's host effectiveConcurrency
      # (10-large.yml max_parallel_requests) when the registry declares one,
      # else the tier-wide default.
      max_parallel_requests: {{ m.max_parallel_requests | default(llm_router_local_max_parallel_requests) }}
{{ local_bounds(m) }}
{% if m.extra_body is defined %}
      # Forwarded VERBATIM to the backend (drop_params would otherwise strip a
      # non-OpenAI param like repetition_penalty). See the registry entry.
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
    model_info:
      disable_background_health_check: true
{% if m.context_window is defined %}
      # Explicit because these backend ids are absent from LiteLLM's catalog.
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{{- delegation_hints(m) }}
{% if m.standby | default(false) and llm_router_llm_large_standby_base_url %}
  # Same-model, same-context standby; emitted only when configured.
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_large_standby_base_url }}
      api_key: os.environ/LLM_LARGE_STANDBY_BEARER_TOKEN
      # /v1/responses -> /chat/completions bridge. None of these backends serve
      # a Responses endpoint, and without this a Responses-only client (Codex
      # and anything else speaking that wire protocol) reaches a 404 on an
      # otherwise healthy deployment. LiteLLM treats this as an internal control
      # flag and never forwards it in the upstream request body.
      use_chat_completions_api: true
      # Preserve the primary deployment's OWN admission cap on failover —
      # same entry, same host, so the same per-model value.
      max_parallel_requests: {{ m.max_parallel_requests | default(llm_router_local_max_parallel_requests) }}
{{ local_bounds(m) }}
{% if m.extra_body is defined %}
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
    model_info:
      disable_background_health_check: true
{% if m.context_window is defined %}
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{{- delegation_hints(m) }}
{% endif %}
{% endfor %}
{% if llm_router_large_passthrough_enabled | bool %}
  # --- large tier passthrough: every model the serving gate advertises ---
  - model_name: "*"
    litellm_params:
      model: openai/*
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
{% if llm_router_passthrough_max_parallel_requests | int > 0 %}
      # This tier has an independent admission cap.
      max_parallel_requests: {{ llm_router_passthrough_max_parallel_requests }}
{% endif %}
{% endif %}
{% include 'model-list-opencode.yaml.j2' %}
{% include 'model-list-zai.yaml.j2' %}
{% include 'model-list-openrouter.yaml.j2' %}
  # --- Hermes-only paid provider fallbacks ---
  # Emitted only when its exact credential resolves. No cloud group aliases a
  # physical local model, so callers other than hermes-default never inherit
  # paid egress.
{% for m in llm_router_hermes_cloud_models_credentialed %}
  - model_name: {{ m.route_group }}
    litellm_params:
      model: {{ litellm_model(m) }}
{% if m.provider != 'chatgpt' %}
      api_key: os.environ/{{ m.credential_env }}
{% endif %}
{% if m.api_base is defined %}
      api_base: {{ m.api_base }}
{% endif %}
      # Defaults to 0: a genuinely free preset (hermes-cloud-free) has no
      # per-token price, and 0 is its real price, not a placeholder.
      input_cost_per_token: {{ m.input_cost_per_token | default(0) }}
      output_cost_per_token: {{ m.output_cost_per_token | default(0) }}
      max_tokens: {{ m.max_output_tokens }}
      rpm: {{ llm_router_hermes_cloud_rpm }}
      tpm: {{ llm_router_hermes_cloud_tpm }}
      max_parallel_requests: {{ llm_router_hermes_cloud_max_parallel_requests }}
      # Per-entry bound, else the tier default — which is sized for long LOCAL
      # generations and is far too generous for a cloud rung. num_retries is 0,
      # so failover needs an ERROR, and a stall is not an error until the
      # timeout fires: an unbounded rung holds the whole chain rather than
      # handing over. Size it from a MEASURED healthy completion, never a guess.
      timeout: {{ m.request_timeout | default(llm_router_request_timeout_seconds) }}
{% if m.stream_timeout is defined %}
      # Paired with the bound above, never set alone: the callers on this chain
      # stream, so a bound covering only the non-streaming path would leave the
      # stalling case it exists to catch unbounded. Every other per-entry bound
      # in this role sets both from one value.
      stream_timeout: {{ m.stream_timeout }}
{% endif %}
      # A group with several cloud members retries onto the next member; a
      # single-member group hands over to its chain at once (38-zero-retry-groups.yml).
      num_retries: {{ llm_router_cloud_group_retries if m.route_group in llm_router_multi_member_cloud_groups else 0 }}
{% if m.reasoning_effort is defined %}
      reasoning_effort: {{ m.reasoning_effort }}
{% endif %}
      order: 1
{% if m.monthly_budget is defined and (m.api_base | default('')) not in llm_router_flat_rate_api_bases %}
      # Absent on hermes-cloud-free: nothing to bound, and a rendered ceiling
      # with no spend behind it would be dishonest. See assert-budget-backing.yml.
      # Also absent on a flat-rate api_base (33-zai.yml
      # llm_router_flat_rate_api_bases) — a dollar ceiling on a subscription
      # plan is a false cutoff on estimated, not real, spend.
      max_budget: {{ m.monthly_budget }}
      budget_duration: {{ llm_router_hermes_cloud_monthly_budget_period }}
{% endif %}
{% if m.provider == 'openrouter' %}
      extra_body:
        provider:
          sort: price
          max_price:
            prompt: 0.75
            completion: 4.0
          require_parameters: true
          allow_fallbacks: true
          data_collection: deny
          # Defaults true; see the free preset's entry in llm-models.yml for
          # the one case where an entry sets zero_data_retention: false.
          zdr: {{ m.zero_data_retention | default(true) | bool | lower }}
{% endif %}
    model_info:
      mode: {{ m.mode | default('chat') }}
      # Same rationale as the OpenRouter tier above: a real call already
      # proves liveness or hands over at once (num_retries above), so a
      # synthetic probe only spends this cloud rung's own rate limit.
      disable_background_health_check: true
      max_input_tokens: {{ m.context_window }}
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}{{ delegation_hints(m) }}
{% endfor %}
{% if llm_router_openrouter_wildcard_enabled | bool %}
{% set _wc_key = bao_local_llm_secrets.OPENROUTER_API_KEY | default(lookup('env', 'OPENROUTER_API_KEY'), true) %}
{% if _wc_key | trim | length > 0 %}
  # --- OpenRouter wildcard: last resort, explicit name only ---
  # See "OpenRouter wildcard passthrough" in the role README for the reversal
  # this represents, why it can't be reached via fallback, and why it ranks
  # ahead of the large-tier bare "*".
  - model_name: "openrouter/*"
    litellm_params:
      model: openrouter/*
      api_key: os.environ/OPENROUTER_API_KEY
      order: {{ llm_router_openrouter_default_order }}
      rpm: {{ llm_router_openrouter_rpm }}
      tpm: {{ llm_router_openrouter_tpm }}
      max_parallel_requests: {{ llm_router_openrouter_max_parallel_requests }}
      # No max_budget/budget_duration — see README, "OpenRouter wildcard passthrough".
      extra_body:
        provider:
          sort: price
          data_collection: deny
          zdr: true
{% endif %}
{% endif %}
{% include 'model-list-light.yaml.j2' %}
{% include 'model-list-cpu-pool.yaml.j2' %}

  # vLLM tier + hermes-local entries — see README "The vLLM tier and the
  # Hermes local GPU leg".
{% for m in llm_router_vllm_models + llm_router_hermes_local_models %}
{% if llm_router_llm_vllm_enabled %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_vllm_base_url }}
      api_key: {{ llm_router_light_api_key }}
      # /v1/responses -> /chat/completions bridge. None of these backends serve
      # a Responses endpoint, and without this a Responses-only client (Codex
      # and anything else speaking that wire protocol) reaches a 404 on an
      # otherwise healthy deployment. LiteLLM treats this as an internal control
      # flag and never forwards it in the upstream request body.
      use_chat_completions_api: true
      # Same base value the serving guest's llama_cpp role uses for -np
      # (inventory/group_vars/llm_vllm_group.yml).
      max_parallel_requests: {{ hostvars[(groups['llm_vllm_group'] | default([]))[0]].llama_cpp_parallel
                                 if (groups['llm_vllm_group'] | default([]) | length > 0)
                                 else llm_router_local_max_parallel_requests }}
{{ local_bounds(m) }}
{% if m.embedding | default(false) or m.context_window is defined or m.allowed_fails is defined or m.cooldown_time is defined or m.hints is defined %}
    model_info:
{% if m.embedding | default(false) %}
      mode: embedding
{% elif m.context_window is defined %}
      # Mandatory — README "The vLLM tier and the Hermes local GPU leg".
      # SMALLER of the context window and what this card can prefill in the
      # admission budget, so an in-window but too-slow prompt skips at
      # pre-call. Computed ONCE in defaults/main/20-registry.yml
      # (_llm_router_vllm_max_input_tokens_by_model) so 55-roles.yml's role
      # deployment on the same backend can never advertise a bigger window
      # than this one does. Set-then-emit-inline, never a folded block
      # scalar (always a string, breaking LiteLLM's int-typed pre-call check).
{% set _vllm_max_input_tokens = _llm_router_vllm_max_input_tokens_by_model[m.client_model_id] %}
      max_input_tokens: {{ _vllm_max_input_tokens }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% if m.allowed_fails is defined %}
      allowed_fails: {{ m.allowed_fails }}
{% endif %}
{% if m.cooldown_time is defined %}
      cooldown_time: {{ m.cooldown_time }}
{% endif %}
{{- delegation_hints(m) }}
{% endif %}
{% endif %}
{% endfor %}
  # --- Standalone `free` / `free-zdrless` model groups ----------------
{% include 'model-list-free.yaml.j2' %}
