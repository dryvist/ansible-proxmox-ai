{% from 'model-list-extra-body.yaml.j2' import local_extra_body with context %}
{# Direct-only aliases stay outside capability and fallback projections. #}
{% for m in llm_router_direct_gpu_models %}
{% for alias in m.direct_route_aliases %}
  - model_name: {{ alias }}
    litellm_params:
      model: {{ litellm_model(m) }}
      tags: {{ deployment_tags(m) }}
      api_base: {{ llm_router_llm_gpu_base_url }}
      api_key: {{ llm_router_light_api_key }}
      use_chat_completions_api: true
      max_parallel_requests: {{ m.max_parallel_requests | default(1) }}
{{ local_bounds(m) }}
{{ local_extra_body(m) }}
      input_cost_per_token: {{ m.input_cost_per_token | default(0) }}
      output_cost_per_token: {{ m.output_cost_per_token | default(0) }}
    model_info:
      allow_fail_open: true
      disable_background_health_check: true
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.max_output_tokens | default(m.context_window) }}
{{- delegation_hints(m) }}
{% endfor %}
{% endfor %}
{% for m in llm_router_direct_studio_models %}
{% for alias in m.direct_route_aliases %}
  - model_name: {{ alias }}
    litellm_params:
      model: {{ litellm_model(m) }}
      tags: {{ deployment_tags(m) }}
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
      use_chat_completions_api: true
      max_parallel_requests: {{ m.max_parallel_requests | default(llm_router_local_max_parallel_requests) }}
{{ local_bounds(m) }}
{{ local_extra_body(m) }}
    model_info:
      allow_fail_open: true
      disable_background_health_check: true
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.max_output_tokens | default(m.context_window) }}
{{- delegation_hints(m) }}
{% endfor %}
{% endfor %}
