{# Top-level guardrails block, included from config.yaml.j2. Entries come from llm_router_guardrails. #}
guardrails:
{% for _guardrail in llm_router_guardrails %}
  - guardrail_name: {{ _guardrail.guardrail_name | to_json }}
    litellm_params:
{% for _key, _value in _guardrail.litellm_params.items() %}
      {{ _key }}: {{ _value | to_json }}
{% endfor %}
{% endfor %}
