  # --- Caller-selected local complexity route ---
  - model_name: {{ llm_router_auto_router_model }}
    litellm_params:
      model: auto_router/complexity_router
      tags: [local, zdr, sensitivity:public, sensitivity:sensitive, sensitivity:pii]
      complexity_router_default_model: {{ llm_router_primary_model }}
      complexity_router_config:
        tiers:
          SIMPLE: {{ llm_router_auto_router_small_target }}
          MEDIUM: {{ llm_router_primary_model }}
          COMPLEX: {{ llm_router_primary_model }}
          REASONING: {{ llm_router_primary_model }}
        classifier_type: jev
        jev_classifier_config:
          model: {{ llm_router_auto_router_classifier_model }}
          api_base: {{ llm_router_laya_api_base | to_json }}
          api_key: os.environ/LLM_LAYA_API_KEY
          timeout_ms: 5000
          circuit_breaker_enabled: true
          circuit_breaker_cooldown_seconds: 30
        classifier_fallback: default_model
        classifier_context_window_size: 0
        classifier_context_budget_chars: 1500
        plan_mode_min_tier: MEDIUM
