{{ ansible_managed | comment }}
[Unit]
Description=LiteLLM proxy — the LLM fabric front door (OpenAI-compatible)
After=network-online.target
Wants=network-online.target
# Bound rapid starts; the normal 15-second restart cadence remains below this.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User={{ llm_router_user }}
Group={{ llm_router_group }}
WorkingDirectory={{ llm_router_home }}
EnvironmentFile={{ llm_router_env_file }}
# No --log_config: the log level is LITELLM_LOG in the EnvironmentFile
# (defaults/main/60-ops.yml). A dictConfig passed here strips LiteLLM's own
# handler and its redaction filter from any logger it names.
ExecStart={{ llm_router_venv }}/bin/litellm --config {{ llm_router_config_file }} --host 0.0.0.0 --port {{ llm_router_api_port }}
# Restart after every process exit. An explicit systemctl stop is not restarted.
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target
