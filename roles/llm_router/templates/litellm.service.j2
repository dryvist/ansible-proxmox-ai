{{ ansible_managed | comment }}
[Unit]
Description=LiteLLM proxy — the LLM fabric front door (OpenAI-compatible)
After=network-online.target
Wants=network-online.target
# Bound rapid starts; the normal 15-second restart cadence remains below this.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User={{ llm_router_user }}
Group={{ llm_router_group }}
WorkingDirectory={{ llm_router_home }}
EnvironmentFile={{ llm_router_env_file }}
# --log_config raises the router's own logger so routing decisions are visible.
# It is a flag rather than an environment variable on purpose: LITELLM_LOG moves
# the handler threshold only and cannot recover a record the logger already
# dropped, so the env var reads like the fix and does nothing. See
# defaults/main/60-ops.yml.
ExecStart={{ llm_router_venv }}/bin/litellm --config {{ llm_router_config_file }} --log_config {{ llm_router_log_config_file }} --host 0.0.0.0 --port {{ llm_router_api_port }}
# Restart after every process exit. An explicit systemctl stop is not restarted.
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target
