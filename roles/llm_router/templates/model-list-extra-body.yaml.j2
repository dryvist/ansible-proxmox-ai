{# Local Qwen3.8 deployments default to model-controlled reasoning depth. #}
{% macro local_extra_body(m) -%}
{%- set body = m.extra_body | default({}) -%}
{%- if (m.upstream_model_id | default('')) is search('Qwen3[.]8(-|$)') -%}
{%- set body = body | combine({'chat_template_kwargs': {'enable_thinking': true}}, recursive=true) -%}
{%- endif -%}
{%- if body | length > 0 %}
      extra_body:
{{ body | to_nice_yaml(indent=2, sort_keys=false) | trim | indent(8, true) }}
{%- endif -%}
{%- endmacro %}
