{{ ansible_managed | comment }}
# Managed LiteLLM proxy config. Models derive from llm-models.yml; credentials
# resolve only through the systemd EnvironmentFile.
{% include 'model-list.yaml.j2' %}
router_settings:
  routing_strategy: {{ llm_router_routing_strategy }}
  # NO routing_groups / cost-based-routing. Declaring it for one group
  # registers LiteLLM's lowest-cost logging handler GLOBALLY (router.py
  # _build_strategy_selector -> logging_callback_manager.add_litellm_callback),
  # and that handler reads litellm_params.model_info on every success event in
  # the process — including deployments the group does not manage, where
  # litellm_params is None. It raises on each one, non-blocking, which is the
  # continuous "ended span" noise in the router log.
  #
  # It bought cost-ordering between two final-resort deployments already
  # ordered by their real token prices, so it loses nothing.
  # tests/llm_router/test_hermes_cloud_value.yml asserts the key stays absent.
  allowed_fails: {{ llm_router_allowed_fails }}
  cooldown_time: {{ llm_router_cooldown_time }}
  model_group_alias:
{% for alias, target in llm_router_model_group_aliases.items() %}
    {{ alias | to_json }}: {{ target | to_json }}
{% endfor %}
{% if llm_router_hermes_default_fallback_chain | length > 0 %}
  # The source-verified fallback key is the name the caller of that invocation
  # TYPED — captured on entry, so it is never the complexity-selected local
  # group. It is equally never an alias resolved to its target: model_group_alias
  # resolution happens below the fallback handler, and the lookup is a plain
  # string match, so an alias and the id it points at are two independent keys
  # and neither inherits the other's chain. Every name a caller can type needs
  # its own entry.
  # Only credential-backed provider groups render here, so no dead route or
  # duplicate local attempt is advertised.
  fallbacks:
    - hermes-default: {{ llm_router_hermes_default_fallback_chain | to_json }}
{% for _group in llm_router_hermes_default_fallback_chain if not _group.startswith('hermes-local') %}
    - {{ _group }}: {{ llm_router_hermes_own_fallback_by_group[_group] | to_json }}
{% endfor %}
  # Explicit empty chains for embed/embeddings/ocr, PLUS `free-zdrless`:
  # fail FAST, never walk default_fallbacks.
{% for _name in llm_router_cross_modality_fail_fast_names %}
    - {{ _name | to_json }}: []
{% endfor %}
  # Local-only roles: no fallbacks, no default ladder — fail fast rather
  # than ever reach a hosted deployment.
{% for _name in llm_router_local_only_fail_fast_names %}
    - {{ _name | to_json }}: []
{% endfor %}
  # `free` falls over to `free-zdrless` only — its ONLY rung, never local
  # or paid, never the other direction, and never a member of the
  # 8-segment Hermes ladder above.
    - free: [free-zdrless]
{% if llm_router_context_window_wider_groups | length > 0 %}
    # ENTRY POINTS. hermes-default is not the only name a caller uses: every
    # servable id and every alias above is called directly, and a name with no
    # key here makes a failure arriving that way terminal. Each targets the
    # SAME six-segment ladder hermes-default uses (35-hermes-cloud.yml /
    # 36-hermes-cloud-segments.yml), minus itself — an entry that IS one of
    # the chain's own rungs (e.g. `best`, a servable id) must not target
    # itself, which would either no-op or cycle depending on how litellm
    # resolves a self-referential fallback. Never hermes-default's OWN name,
    # so an escalated call cannot re-enter the chain that named it.
    #
    # A ZDR entry point (llm_router_zdr_entry_point_names, 37-fallback-
    # entry-points.yml) additionally drops llm_router_openrouter_free_groups
    # — the one segment carrying no ZDR claim — from its OWN ladder: an alias
    # whose target promises zero data retention must never fall through to a
    # rung that makes no such promise. hermes-default's own chain above is
    # untouched; it is the general-purpose dispatcher of last resort.
{% for _name in llm_router_entry_point_names %}
{% set _chain = llm_router_hermes_default_fallback_chain | reject('equalto', _name) | list %}
{% if _name in llm_router_zdr_entry_point_names %}
{% set _chain = _chain | reject('in', llm_router_openrouter_free_groups) | list %}
{% endif %}
    - {{ _name | to_json }}: {{ _chain | to_json }}
{% endfor %}
{% endif %}
{% endif %}
{% if (llm_router_context_window_fallbacks | length > 0) or ('free-zdrless' in llm_router_cross_modality_fail_fast_names) %}
  # Escape hatch for the local legs, which serve a smaller context than the
  # primary. Rendered all-or-nothing on purpose: a key missing from a map that
  # EXISTS re-raises without ever consulting the ordinary fallbacks map, while
  # no map at all falls through to it — so a partial map is worse than none
  # (see 35-hermes-cloud.yml for the mechanism and the derivation).
  #
  # PLUS `free` -> `free-zdrless`: free-zdrless is the wider of the two,
  # so an oversize request to `free` escapes there; free-zdrless itself
  # carries no entry here, same as embed/ocr.
  context_window_fallbacks:
{% for entry in llm_router_context_window_fallbacks %}
{% for group, targets in entry.items() %}
    - {{ group }}: {{ targets | to_json }}
{% endfor %}
{% endfor %}
    - free: [free-zdrless]
{% endif %}
  # Derived (35-hermes-cloud.yml) from the distinct target names in the whole
  # map, not from one chain's length and not from a fixed 1. It bounds rung
  # ATTEMPTS along a path rather than nesting, and several chains render here,
  # so any narrower bound silently truncates the fallback design while still
  # rendering and passing every test that doesn't count fallback depth.
  max_fallbacks: {{ llm_router_max_fallbacks }}
  # ESCALATION NEVER RECOVERS TO LOCAL. Each group's own entry is the
  # chain's own tail after it (llm_router_hermes_own_fallback_by_group,
  # 58-review-roles.yml), never the primary. A caller escalates by naming a
  # cloud group directly; without the per-group entries above, an escalated
  # call over budget got a terminal refusal, since only hermes-default
  # carried a chain.
  #
  # This IS a cross-tier fallback and it is safe only because of the
  # context-window machinery below: enable_pre_call_checks plus
  # context_window_fallbacks skip a rung that cannot serve the request rather
  # than truncating into it. Do not remove either while these entries stand.
  # ponytail: falls back to the primary rather than re-entering hermes-default,
  # which would risk a cycle back through the same cloud rungs.
  #
  # No cross-tier fallback for the default brain itself, on purpose: a fallback
  # serving a smaller context than the primary poisons callers instead of
  # degrading them (incident history: Zammad, AI/LLM Serving). Fail loud; the
  # watchdog pauses. (The chain above is NOT a same-context failover — the
  # local leg is smaller than the primary, which is why it needs the
  # context_window_fallbacks escape hatch rather than silently truncating.)
  # Pre-call context-window checks so an over-long request is not routed to a model
  # that cannot serve it (no cross-tier fallback masks the error).
  enable_pre_call_checks: true
  optional_pre_call_checks:
    - enforce_model_rate_limits
  # Bounded once; the rate-limit policy below overrides this for 429s only.
  num_retries: {{ llm_router_num_retries }}
  timeout: {{ llm_router_request_timeout_seconds }}
  # A 429 means the serving slot is busy, not that the work failed — wait it out
  # here so every consumer inherits the resilience instead of each one retrying.
  # retry_after is the MINIMUM sleep between attempts; see defaults for sizing.
  retry_after: {{ llm_router_retry_after_seconds }}
  retry_policy:
    RateLimitErrorRetries: {{ llm_router_rate_limit_retries }}
    # A stalled first byte gets ONE more attempt after retry_after; the
    # admission budget (40-routing.yml) bounds retries x (retry_after +
    # stream_timeout) on every local rung.
    TimeoutErrorRetries: {{ llm_router_timeout_retries }}
{% if llm_router_default_fallbacks | length > 0 %}
  # Catch-all ladder for any name without its own fallbacks entry, so no
  # request can dead-end on a busy or failed rung: the free external rung,
  # then the paid one (55-roles.yml, llm_router_default_fallbacks).
  default_fallbacks: {{ llm_router_default_fallbacks | to_json }}
{% endif %}
{% if llm_router_hermes_cloud_zero_retry_groups | length > 0 %}
  # Every group that carries a fallback chain advances on 429 instead of
  # sleeping on the busy slot: the chain rungs, the provider routers, and each
  # entry-point name above. Keyed by the name the caller TYPED for that
  # invocation (router.py:6692, litellm 1.98.0) — the same key the fallback
  # maps use — and a per-group policy REPLACES the global one for that name
  # (router_utils/get_retry_from_policy.py:32-33), so zeroing 429 retries here
  # leaves every other error type on num_retries and touches no other group.
  # The global RateLimitErrorRetries above now governs only names with no
  # chain to hand over to.
  model_group_retry_policy:
{% for group in llm_router_hermes_cloud_zero_retry_groups %}
    {{ group }}:
      RateLimitErrorRetries: {{ llm_router_cloud_group_retries if group in llm_router_multi_member_cloud_groups else 0 }}
{% endfor %}
{% endif %}
  # ONE failure counter per deployment, MANY allowances. The router-level
  # policy path passes no per-exception suffix (router_utils/
  # cooldown_handlers.py:404-408, litellm 1.98.0), so every error type
  # increments the same 30-second counter (:587-594, TTL = cooldown_time),
  # while the allowance it is compared against is looked up per type
  # (router.py:12142-12148). A run of 429s — allowed up to the rate-limit
  # figure — therefore inflates the counter that the NEXT timeout is judged
  # by. Without a timeout allowance that judgement uses the generic
  # allowed_fails, so one timeout after two busy-slot 429s parks the
  # deployment. Sizing rationale for the timeout figure: 40-routing.yml.
  allowed_fails_policy:
    RateLimitErrorAllowedFails: {{ llm_router_rate_limit_allowed_fails }}
    TimeoutErrorAllowedFails: {{ llm_router_timeout_allowed_fails }}
{% if llm_router_redis_host | length > 0 %}
  # Shared spend store — see README "Spend tracking (Redis)" for why the
  # budget below renders only alongside it, and why redis_port is a literal
  # int rather than an os.environ/ marker.
  redis_host: os.environ/LLM_ROUTER_REDIS_HOST
  redis_port: {{ llm_router_redis_port }}
  redis_password: os.environ/LLM_ROUTER_REDIS_PASSWORD
{% if llm_router_openrouter_budget_limit | float > 0 %}
  provider_budget_config:
    openrouter:
      budget_limit: {{ llm_router_openrouter_budget_limit }}
      time_period: {{ llm_router_openrouter_budget_period }}
{% endif %}
{% else %}
  # No spend store configured, so deliberately NO provider_budget_config —
  # see README "Spend tracking (Redis)". Set llm_router_redis_host for a real
  # cap; the rate ceilings on each egress deployment above work either way.
{% endif %}
  # Deliberately no `fail_closed_budget_enforcement`: it governs LiteLLM's
  # virtual-key budgets, not the provider budget above, and 503s when spend
  # cannot be verified. A database IS now attached and that does NOT make it
  # appropriate — this proxy still issues no virtual keys, so there is nothing
  # for it to enforce. See README "Spend tracking".

{% include 'general-settings.yaml.j2' %}

{% include 'litellm-settings.yaml.j2' %}
