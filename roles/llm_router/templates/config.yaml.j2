{{ ansible_managed | comment }}
# Managed LiteLLM proxy config. Models derive from llm-models.yml; credentials
# resolve only through the systemd EnvironmentFile.
{% macro litellm_model(m) %}{{ m.litellm_model_name | default(m.provider ~ '/' ~ m.upstream_model_id) }}{% endmacro %}

model_list:
  # --- Hermes-only local complexity router ---
{% for m in llm_router_hermes_virtual_models %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ llm_router_routine_model }}
          MEDIUM: {{ llm_router_routine_model }}
          COMPLEX: {{ llm_router_primary_model }}
          REASONING: {{ llm_router_primary_model }}
        default_model: {{ llm_router_primary_model }}
    model_info:
      mode: chat
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.max_output_tokens }}
{% endfor %}

  # Provider-specific cloud value routers reclassify without an API call.
{% for m in llm_router_hermes_cloud_router_models_credentialed %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      complexity_router_config:
        classifier_type: heuristic
        tiers:
          SIMPLE: {{ m.routine_model }}
          MEDIUM: {{ m.routine_model }}
          COMPLEX: {{ m.agentic_model }}
          REASONING: {{ m.agentic_model }}
        default_model: {{ m.agentic_model }}
    model_info:
      mode: chat
      max_input_tokens: {{ m.context_window }}
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}
{% endfor %}

  # --- large tier: one deployment each, bearer-authed to llm-large ---
  # Exact tuned model names take precedence over the optional wildcard.
{% for m in llm_router_large_models %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
      # Queue excess work at the router instead of flooding the backend.
      max_parallel_requests: {{ llm_router_local_max_parallel_requests }}
{% if m.client_model_id == llm_router_primary_model %}
      num_retries: 2
{% endif %}
{% if m.extra_body is defined %}
      # Forwarded VERBATIM to the backend (drop_params would otherwise strip a
      # non-OpenAI param like repetition_penalty). See the registry entry.
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
    model_info:
      disable_background_health_check: true
{% if m.context_window is defined %}
      # Explicit because these backend ids are absent from LiteLLM's catalog.
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% if m.standby | default(false) and llm_router_llm_large_standby_base_url %}
  # Same-model, same-context standby; emitted only when configured.
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_large_standby_base_url }}
      api_key: os.environ/LLM_LARGE_STANDBY_BEARER_TOKEN
      # Preserve the primary deployment's admission cap on failover.
      max_parallel_requests: {{ llm_router_local_max_parallel_requests }}
{% if m.extra_body is defined %}
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
    model_info:
      disable_background_health_check: true
{% if m.context_window is defined %}
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% endif %}
{% endfor %}
{% if llm_router_large_passthrough_enabled | bool %}
  # --- large tier passthrough: every model the serving gate advertises ---
  - model_name: "*"
    litellm_params:
      model: openai/*
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
{% if llm_router_passthrough_max_parallel_requests | int > 0 %}
      # This tier has an independent admission cap.
      max_parallel_requests: {{ llm_router_passthrough_max_parallel_requests }}
{% endif %}
{% endif %}
  # --- OpenRouter egress tier: explicit ids, one provider key ---
  # Never chained into fallbacks; an unseeded model renders no entry.
{% for m in llm_router_openrouter_models %}
{% set _or_env = m.credential_env %}
{% set _or_key = bao_local_llm_secrets[m.key_field] | default(lookup('env', m.credential_env), true) %}
{% if _or_key | trim | length > 0 %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_key: os.environ/{{ _or_env }}
      # Bound the minute so a runaway caller can't exhaust the period budget
      # before it's observed.
      rpm: {{ llm_router_openrouter_rpm }}
      tpm: {{ llm_router_openrouter_tpm }}
      max_parallel_requests: {{ llm_router_openrouter_max_parallel_requests }}
    model_info:
      max_input_tokens: {{ m.context_window }}
{% if m.max_output_tokens is defined %}
      # An entry that declares its own generation cap gets it here; without one
      # the context window is the only bound this tier has ever advertised.
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}
{% else %}
      max_tokens: {{ m.context_window }}
{% endif %}
{% endif %}
{% endfor %}
  # --- Hermes-only paid provider fallbacks ---
  # Emitted only when its exact credential resolves. No cloud group aliases a
  # physical local model, so callers other than hermes-default never inherit
  # paid egress.
{% for m in llm_router_hermes_cloud_models_credentialed %}
  - model_name: {{ m.route_group }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_key: os.environ/{{ m.credential_env }}
{% if m.api_base is defined %}
      api_base: {{ m.api_base }}
{% endif %}
      # Defaults to 0: a genuinely free preset (hermes-cloud-free) has no
      # per-token price, and 0 is its real price, not a placeholder.
      input_cost_per_token: {{ m.input_cost_per_token | default(0) }}
      output_cost_per_token: {{ m.output_cost_per_token | default(0) }}
      max_tokens: {{ m.max_output_tokens }}
      rpm: {{ llm_router_hermes_cloud_rpm }}
      tpm: {{ llm_router_hermes_cloud_tpm }}
      max_parallel_requests: {{ llm_router_hermes_cloud_max_parallel_requests }}
      timeout: {{ llm_router_request_timeout_seconds }}
      num_retries: 0
{% if m.monthly_budget is defined %}
      # Absent on hermes-cloud-free: nothing to bound, and a rendered ceiling
      # with no spend behind it would be dishonest. See assert-budget-backing.yml.
      max_budget: {{ m.monthly_budget }}
      budget_duration: {{ llm_router_hermes_cloud_monthly_budget_period }}
{% endif %}
{% if m.provider == 'openrouter' %}
      extra_body:
        provider:
          sort: price
          max_price:
            prompt: 0.75
            completion: 4.0
          require_parameters: true
          allow_fallbacks: true
          data_collection: deny
          # Defaults true; see the free preset's entry in llm-models.yml for
          # the one case where an entry sets zero_data_retention: false.
          zdr: {{ m.zero_data_retention | default(true) | bool | lower }}
{% endif %}
    model_info:
      mode: chat
      max_input_tokens: {{ m.context_window }}
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}
{% endfor %}
{% if llm_router_openrouter_wildcard_enabled | bool %}
{% set _wc_key = bao_local_llm_secrets.OPENROUTER_API_KEY | default(lookup('env', 'OPENROUTER_API_KEY'), true) %}
{% if _wc_key | trim | length > 0 %}
  # --- OpenRouter wildcard: last resort, explicit name only ---
  # See "OpenRouter wildcard passthrough" in the role README for the reversal
  # this represents, why it can't be reached via fallback, and why it ranks
  # ahead of the large-tier bare "*".
  - model_name: "openrouter/*"
    litellm_params:
      model: openrouter/*
      api_key: os.environ/OPENROUTER_API_KEY
      rpm: {{ llm_router_openrouter_rpm }}
      tpm: {{ llm_router_openrouter_tpm }}
      max_parallel_requests: {{ llm_router_openrouter_max_parallel_requests }}
      # No max_budget/budget_duration — see README, "OpenRouter wildcard passthrough".
      extra_body:
        provider:
          sort: price
          data_collection: deny
          zdr: true
{% endif %}
{% endif %}
  # --- light tier --- (README "Tiers" — CPU always renders, GPU only when
  # llm_router_llm_fast_enabled, sharing model_name so LiteLLM load-balances)
{% for m in llm_router_light_models %}
{% if llm_router_llm_fast_enabled %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_fast_base_url }}
      api_key: {{ llm_router_light_api_key }}
    model_info:
      disable_background_health_check: true
{% if m.embedding | default(false) %}
      mode: embedding
{% endif %}
{% endif %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_light_base_url }}
      api_key: {{ llm_router_light_api_key }}
    model_info:
      disable_background_health_check: true
{% if m.embedding | default(false) %}
      mode: embedding
{% endif %}
{% endfor %}

  # vLLM tier + hermes-local entries — see README "The vLLM tier and the
  # Hermes local GPU leg".
{% for m in llm_router_vllm_models + llm_router_hermes_local_models %}
{% if llm_router_llm_vllm_enabled %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_vllm_base_url }}
      api_key: {{ llm_router_light_api_key }}
{% if m.num_retries is defined %}
      num_retries: {{ m.num_retries }}
{% endif %}
{% if m.request_timeout is defined %}
      timeout: {{ m.request_timeout }}
{% endif %}
{% if m.stream_timeout is defined %}
      stream_timeout: {{ m.stream_timeout }}
{% endif %}
{% if m.embedding | default(false) or m.context_window is defined or m.allowed_fails is defined or m.cooldown_time is defined %}
    model_info:
{% if m.embedding | default(false) %}
      mode: embedding
{% elif m.context_window is defined %}
      # Mandatory here — see README "The vLLM tier and the Hermes local GPU leg".
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% if m.allowed_fails is defined %}
      allowed_fails: {{ m.allowed_fails }}
{% endif %}
{% if m.cooldown_time is defined %}
      cooldown_time: {{ m.cooldown_time }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}

router_settings:
  routing_strategy: {{ llm_router_routing_strategy }}
{% if 'hermes-cloud-openrouter' in llm_router_hermes_cloud_fallback_groups %}
  # Kimi and GLM are treated as equivalent final-resort agentic deployments;
  # use their real token prices rather than falsifying costs to encode quality.
  routing_groups:
    - group_name: hermes-openrouter-value
      models: [hermes-cloud-openrouter]
      routing_strategy: cost-based-routing
{% endif %}
  allowed_fails: {{ llm_router_allowed_fails }}
  cooldown_time: {{ llm_router_cooldown_time }}
  model_group_alias:
{% for alias, target in llm_router_model_group_aliases.items() %}
    {{ alias | to_json }}: {{ target | to_json }}
{% endfor %}
{% if llm_router_hermes_default_fallback_chain | length > 0 %}
  # The source-verified fallback key is the original request name, not the
  # complexity-selected local group. Only credential-backed provider groups
  # render here, so no dead route or duplicate local attempt is advertised.
  fallbacks:
    - hermes-default: {{ llm_router_hermes_default_fallback_chain | to_json }}
{% endif %}
  # Derived from the chain length (35-hermes-cloud.yml), not a fixed 1: this is
  # a 5-leg chain now, and a hardcoded max_fallbacks here would silently cap
  # every attempt after the first, truncating the whole fallback design while
  # still rendering and passing every test that doesn't count fallback depth.
  max_fallbacks: {{ llm_router_max_fallbacks }}
  # No CROSS-TIER fallbacks for the default brain, on purpose: a fallback
  # serving a smaller context than the primary poisons callers instead of
  # degrading them (incident history: Zammad, AI/LLM Serving). Fail loud; the
  # watchdog pauses. (The same-tier chain above is a same-context failover,
  # not an exception to this.)
  # Pre-call context-window checks so an over-long request is not routed to a model
  # that cannot serve it (no cross-tier fallback masks the error).
  enable_pre_call_checks: true
  optional_pre_call_checks:
    - enforce_model_rate_limits
  # Bounded once; the rate-limit policy below overrides this for 429s only.
  num_retries: {{ llm_router_num_retries }}
  timeout: {{ llm_router_request_timeout_seconds }}
  # A 429 means the serving slot is busy, not that the work failed — wait it out
  # here so every consumer inherits the resilience instead of each one retrying.
  # retry_after is the MINIMUM sleep between attempts; see defaults for sizing.
  retry_after: {{ llm_router_retry_after_seconds }}
  retry_policy:
    RateLimitErrorRetries: {{ llm_router_rate_limit_retries }}
{% if llm_router_hermes_cloud_zero_retry_groups | length > 0 %}
  # Cloud groups advance on 429; local groups retain the global retry policy.
  model_group_retry_policy:
{% for group in llm_router_hermes_cloud_zero_retry_groups %}
    {{ group }}:
      RateLimitErrorRetries: 0
{% endfor %}
{% endif %}
  allowed_fails_policy:
    RateLimitErrorAllowedFails: {{ llm_router_rate_limit_allowed_fails }}
{% if llm_router_redis_host | length > 0 %}
  # Shared spend store — see README "Spend tracking (Redis)" for why the
  # budget below renders only alongside it, and why redis_port is a literal
  # int rather than an os.environ/ marker.
  redis_host: os.environ/LLM_ROUTER_REDIS_HOST
  redis_port: {{ llm_router_redis_port }}
  redis_password: os.environ/LLM_ROUTER_REDIS_PASSWORD
{% if llm_router_openrouter_budget_limit | float > 0 %}
  provider_budget_config:
    openrouter:
      budget_limit: {{ llm_router_openrouter_budget_limit }}
      time_period: {{ llm_router_openrouter_budget_period }}
{% endif %}
{% else %}
  # No spend store configured, so deliberately NO provider_budget_config —
  # see README "Spend tracking (Redis)". Set llm_router_redis_host for a real
  # cap; the rate ceilings on each egress deployment above work either way.
{% endif %}
  # Deliberately no `fail_closed_budget_enforcement`: it governs LiteLLM's
  # virtual-key budgets, not the provider budget above, and 503s when spend
  # cannot be verified. Attaching a database does NOT make it appropriate —
  # this proxy issues no virtual keys. See README "Spend tracking".

general_settings:
  master_key: os.environ/LLM_ROUTER_MASTER_KEY
{% if llm_router_db_host | length > 0 %}
  # Adaptive-router state. Gated on the same condition as DATABASE_URL in the
  # EnvironmentFile, so config and env cannot separate. os.environ/ because the
  # URL embeds the password. Rationale for all four: defaults/main/45-database.yml.
  database_url: os.environ/DATABASE_URL
  store_model_in_db: {{ llm_router_store_model_in_db | to_json }}
  disable_spend_logs: {{ llm_router_disable_spend_logs | to_json }}
  disable_error_logs: {{ llm_router_disable_error_logs | to_json }}
{% endif %}
  # health_check_interval is general_settings-only (LiteLLM rejects it under
  # router_settings).
  background_health_checks: {{ llm_router_background_health_checks | to_json }}
{% if llm_router_background_health_checks %}
  health_check_interval: {{ llm_router_health_check_interval }}
  health_check_skip_disabled_background_models: true
{% endif %}

litellm_settings:
  # OTLP traces to the Cribl Edge collector (endpoint from the EnvironmentFile);
  # Cribl fans out to Langfuse + Splunk. No direct "langfuse" callback — it
  # requires the v2 SDK and errors on init with the v3 pip resolves.
  callbacks: ["otel"]
  drop_params: true
{% if llm_router_large_passthrough_enabled | bool %}
  # Resolve the wildcard against the gate's live /v1/models so this proxy's
  # own /v1/models lists every passthrough model (not just the aliases) —
  # Open WebUI's picker and Hermes both read that listing.
  check_provider_endpoint: true
{% endif %}
