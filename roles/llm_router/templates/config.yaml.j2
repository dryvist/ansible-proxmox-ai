{{ ansible_managed | comment }}
# LiteLLM proxy config (managed by the llm_router role). One OpenAI-compatible front
# door for the whole fabric. Physical backends have one deployment entry each;
# stable consumer names resolve through model_group_alias. Secrets come from the
# systemd EnvironmentFile via os.environ/ — no credential literal lives here.
#
# Every model name below comes from the repo-root llm-models.yml registry, via
# the role's tier views. Three names stay distinct on purpose and must not be
# collapsed: `model_name` is what a CALLER sends (client_model_id),
# `litellm_params.model` is LiteLLM's own provider-prefixed route string, and
# the id after the prefix is what the UPSTREAM serves (upstream_model_id).
{% macro litellm_model(m) %}{{ m.litellm_model_name | default(m.provider ~ '/' ~ m.upstream_model_id) }}{% endmacro %}

model_list:
  # --- large tier: one deployment each, bearer-authed to llm-large ---
  # Each tuned model is registered under its physical id: exact model_name
  # matches beat the "*" wildcard below, so the request routes to the TUNED
  # deployment (llama-swap: parsers, preload, batching) instead of falling
  # through to the zero-config dynamic tier.
{% for m in llm_router_large_models %}
{# Registry entries select a backend symbolically; the URL lives in the role. #}
{% set _api_base = llm_router_llm_large_cluster_base_url if m.endpoint | default('') == 'cluster'
                   else llm_router_llm_large_base_url %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ _api_base }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
      # In-flight admission cap, so excess work QUEUES here instead of being
      # refused by the backend. Without it this deployment carried no ceiling
      # of any kind and forwarded everything to a server admitting 2 in-flight,
      # which 429'd the remainder instantly. Per-instance and deliberately so —
      # see llm_router_local_max_parallel_requests in defaults for why pool-wide
      # coordination is not available for this control.
      max_parallel_requests: {{ llm_router_local_max_parallel_requests }}
{% if m.extra_body is defined %}
      # Per-model sampling defaults pinned at the router. extra_body is forwarded
      # to the OpenAI-compatible backend VERBATIM (litellm_settings.drop_params
      # would otherwise strip a non-OpenAI param like repetition_penalty before
      # it reaches the server). See the model entry in defaults for the evidence.
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
{% if m.context_window is defined %}
    model_info:
      # These mlx-community backend ids are unknown to LiteLLM's built-in
      # model cost/context map, so without an explicit value here
      # max_input_tokens resolves to null — enable_pre_call_checks then has
      # nothing to check against and callers seeing that null (e.g. Hermes)
      # fall back to a near-zero context guess and compress a request to
      # death. Value = the model's real served context length.
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% if m.standby | default(false) and llm_router_llm_large_standby_base_url %}
  # Standby sibling of {{ m.client_model_id }} on an off-Studio large-tier backend.
  # SAME model id + SAME context window => a real failover deployment (LiteLLM
  # groups both under this model_name), NOT a cross-tier alias — so it degrades
  # the brain's availability without the smaller-context "poison the caller"
  # failure the no-cross-tier-fallback rule guards against. Emitted only when
  # llm_router_llm_large_standby_base_url is set (default OFF => byte-identical
  # to the no-standby render). Motivation: single-Studio brain SPOF, INC-17080.
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_large_standby_base_url }}
      api_key: os.environ/LLM_LARGE_STANDBY_BEARER_TOKEN
      # Same admission cap as the primary sibling. A standby that admits without
      # limit would simply relocate the rejection storm on failover, at the
      # moment the fabric can least absorb it.
      max_parallel_requests: {{ llm_router_local_max_parallel_requests }}
{% if m.extra_body is defined %}
      extra_body:
{% for _pk, _pv in m.extra_body.items() %}
        {{ _pk }}: {{ _pv }}
{% endfor %}
{% endif %}
{% if m.context_window is defined %}
    model_info:
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% endif %}
{% endfor %}
{% if llm_router_large_passthrough_enabled | bool %}
  # --- large tier passthrough: every model the serving gate advertises ---
  # Exposure is blocklist-shaped, enforced at the source: the serving host
  # auto-registers every downloaded, memory-fitting MLX model MINUS its
  # declarative blocklist (nix-ai programs.mlx.discover.blocklist), and this
  # wildcard forwards any model id not explicitly tuned above to that gate.
  # No per-model router edit is ever needed; the tuned entries above win over
  # the wildcard on exact match.
  - model_name: "*"
    litellm_params:
      model: openai/*
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
{% if llm_router_passthrough_max_parallel_requests | int > 0 %}
      # Admission cap for the zero-config tier. Deliberately its OWN knob rather
      # than sharing the tuned tier's: LiteLLM keys the semaphore per DEPLOYMENT,
      # and this is a single deployment fronting every untuned model, so one
      # value here serialises them against each other — a long document-OCR
      # decode can hold the slot a small on-demand model wanted. That is the
      # accepted cost of not letting this tier flood the same backend the tuned
      # entries depend on. Set llm_router_passthrough_max_parallel_requests: 0
      # to omit the cap entirely and restore the previous unbounded behaviour.
      max_parallel_requests: {{ llm_router_passthrough_max_parallel_requests }}
{% endif %}
{% endif %}
  # --- OpenRouter egress tier: explicit opt-in by real upstream id, one key per MODEL ---
  # Never chained into any fallbacks (see defaults). Keys come from OpenBao
  # secrets-external/ai/saas/openrouter via the EnvironmentFile; an unseeded
  # model renders no entry at all.
{% for m in llm_router_openrouter_models %}
{% set _or_env = 'OPENROUTER_API_KEY_' ~ (m.key_field | upper | replace('-', '_')) %}
{% set _or_key = bao_local_llm_secrets[m.key_field] | default(lookup('env', _or_env), true) %}
{% if _or_key | length > 0 %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_key: os.environ/{{ _or_env }}
      # Rate and concurrency ceilings on paid egress. The spend cap below bounds
      # the period; these bound the minute, so a runaway caller cannot exhaust a
      # whole day's budget before the cap observes it.
      rpm: {{ llm_router_openrouter_rpm }}
      tpm: {{ llm_router_openrouter_tpm }}
      max_parallel_requests: {{ llm_router_openrouter_max_parallel_requests }}
    model_info:
      max_input_tokens: {{ m.context_window }}
      max_tokens: {{ m.context_window }}
{% endif %}
{% endfor %}
  # NOTE there is deliberately no `openrouter/*` passthrough entry. The loop
  # above IS the egress allowlist: a model the registry does not enable with a
  # seeded key is not reachable through this router at all. See defaults for
  # why the wildcard was removed rather than tightened.
  # --- light tier ---
  # The CPU `llm-light` deployment always renders. The GPU `llm-fast` deployment
  # renders only when llm_router_llm_fast_enabled is true; with it false the tier
  # is a SINGLE deployment per model name and there is no standby to drain to.
  # When both render they share a model_name, and LiteLLM load-balances the pair
  # and cools a failed deployment down.
{% for m in llm_router_light_models %}
{% if llm_router_llm_fast_enabled %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_fast_base_url }}
      api_key: {{ llm_router_light_api_key }}
{% if m.embedding | default(false) %}
    model_info:
      mode: embedding
{% endif %}
{% endif %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_light_base_url }}
      api_key: {{ llm_router_light_api_key }}
{% if m.embedding | default(false) %}
    model_info:
      mode: embedding
{% endif %}
{% endfor %}

  # vLLM tier — the NVIDIA/CUDA guest. One deployment per model: vLLM serves a
  # single model per instance and there is no standby serving the same weights,
  # so this tier deliberately does not render a pair.
{% for m in llm_router_vllm_models %}
{% if llm_router_llm_vllm_enabled %}
  - model_name: {{ m.client_model_id }}
    litellm_params:
      model: {{ litellm_model(m) }}
      api_base: {{ llm_router_llm_vllm_base_url }}
      api_key: {{ llm_router_light_api_key }}
{% if m.embedding | default(false) %}
    model_info:
      mode: embedding
{% endif %}
{% endif %}
{% endfor %}

router_settings:
  routing_strategy: {{ llm_router_routing_strategy }}
  allowed_fails: {{ llm_router_allowed_fails }}
  cooldown_time: {{ llm_router_cooldown_time }}
  model_group_alias:
{% for alias, target in llm_router_model_group_aliases.items() %}
    {{ alias | to_json }}: {{ target | to_json }}
{% endfor %}
{% if llm_router_hermes_default_fallback_chain | length > 0 %}
  # hermes-default automatic failover across the cluster + standalone gates
  # (see defaults for the full ordering rationale and the source-verified
  # reason the key is the ALIAS, not the resolved primary id). Same-tier only
  # (every entry here carries the same context_window as the primary) — this
  # is NOT the cross-tier fallback the no-fallback rule below still forbids.
  fallbacks:
    - hermes-default: {{ llm_router_hermes_default_fallback_chain | to_json }}
{% endif %}
  # No CROSS-TIER fallbacks for the default brain, on purpose: a fallback
  # serving a smaller context than the primary poisons callers instead of
  # degrading them (incident history: Zammad, AI/LLM Serving). Fail loud; the
  # watchdog pauses. (The same-tier chain above is a same-context failover,
  # not an exception to this.)
  # Pre-call context-window checks so an over-long request is not routed to a model
  # that cannot serve it (no cross-tier fallback masks the error).
  enable_pre_call_checks: true
  # Genuine failures are forwarded once so backend calls remain exactly bounded.
  # The rate-limit policy below overrides this for 429s only.
  num_retries: {{ llm_router_num_retries }}
  timeout: {{ llm_router_request_timeout_seconds }}
  # A 429 means the serving slot is busy, not that the work failed — wait it out
  # here so every consumer inherits the resilience instead of each one retrying.
  # retry_after is the MINIMUM sleep between attempts; see defaults for sizing.
  retry_after: {{ llm_router_retry_after_seconds }}
  retry_policy:
    RateLimitErrorRetries: {{ llm_router_rate_limit_retries }}
  allowed_fails_policy:
    RateLimitErrorAllowedFails: {{ llm_router_rate_limit_allowed_fails }}
{% if llm_router_redis_host | length > 0 %}
  # Shared spend store for the router pool. Without this every member would
  # count only its own spend and the ceiling below would really be Nx, which is
  # why the budget is rendered ONLY inside this block — a budget without a
  # store is a control that reports a limit it does not hold, and the assert in
  # tasks/assert.yml fails the build rather than let the two separate.
  # Credentials come from the EnvironmentFile via os.environ/, like every other
  # secret here; no literal lands in this file.
  redis_host: os.environ/LLM_ROUTER_REDIS_HOST
  # Port is a LITERAL int, not an os.environ/ reference like its neighbours.
  # LiteLLM's documented Redis examples show the port as an integer, and its
  # os.environ/ indirection is documented for string fields; passing the
  # unresolved marker where an int is expected risks failing at client
  # construction rather than at render, which is the worst place to find out.
  # It is also not a secret — it comes from the same public ports registry every
  # other port here does — so routing it through the EnvironmentFile bought
  # nothing.
  redis_port: {{ llm_router_redis_port }}
  redis_password: os.environ/LLM_ROUTER_REDIS_PASSWORD
{% if llm_router_openrouter_budget_limit | float > 0 %}
  # Period ceiling on paid egress, enforced against the store above so it binds
  # every caller rather than only the compliant ones. The per-deployment rpm/tpm
  # ceilings above bound the RATE spend accumulates at, so a runaway caller
  # cannot exhaust the period before this counter observes it.
  provider_budget_config:
    openrouter:
      budget_limit: {{ llm_router_openrouter_budget_limit }}
      time_period: {{ llm_router_openrouter_budget_period }}
{% endif %}
{% else %}
  # No spend store configured, so deliberately NO provider_budget_config.
  # LiteLLM tracks provider spend in Redis; with a multi-member pool and no
  # shared store each member counts only its own, so a rendered ceiling would
  # really be Nx and would reset on every rolling converge. A control that
  # reports a limit it does not hold is worse than an absent one. Set
  # llm_router_redis_host to get a real cap; the rate ceilings on each egress
  # deployment above work either way.
{% endif %}
  # NOTE deliberately no `fail_closed_budget_enforcement`. It is a
  # general_settings key governing LiteLLM's POSTGRES-backed virtual-key
  # budgets, not the provider budget above, and it 503s when spend can be
  # verified against neither Redis nor a database. This proxy issues no virtual
  # keys and has no database, so it would be inert at best and a 503 generator
  # on the fabric's only front door at worst. See defaults.

general_settings:
  master_key: os.environ/LLM_ROUTER_MASTER_KEY
  # Active probes spawn models on the llama-swap tier (see defaults) — passive
  # recovery via allowed_fails/cooldown_time is the default; health_check_interval
  # is a general_settings field (LiteLLM rejects it under router_settings).
  background_health_checks: {{ llm_router_background_health_checks | to_json }}
{% if llm_router_background_health_checks %}
  health_check_interval: {{ llm_router_health_check_interval }}
{% endif %}

litellm_settings:
  # OTLP traces to the Cribl Edge collector (endpoint from the EnvironmentFile);
  # Cribl fans out to Langfuse + Splunk. No direct "langfuse" callback — it
  # requires the v2 SDK and errors on init with the v3 pip resolves.
  callbacks: ["otel"]
  drop_params: true
{% if llm_router_large_passthrough_enabled | bool %}
  # Resolve the wildcard against the gate's live /v1/models so this proxy's
  # own /v1/models lists every passthrough model (not just the aliases) —
  # Open WebUI's picker and Hermes both read that listing.
  check_provider_endpoint: true
{% endif %}
