{# LOCAL SURVIVOR deployments, one per budgeted cloud group. Included by
   model-list.yaml.j2, which owns the macros (local_bounds resolves from
   that context). Split out when that file crossed its per-file token budget:
   the remedy for an over-budget file is a split along a real seam, never a
   raised budget. #}
{% for _group in llm_router_hermes_cloud_budgeted_groups %}
  # LOCAL SURVIVOR for {{ _group }}. Budgets FILTER a model group rather than
  # failing it: an over-budget deployment is dropped from the healthy set and
  # the router only raises when that set is left EMPTY
  # (router_strategy/budget_limiter.py). Order filtering runs AFTER that and
  # keeps the lowest order still present (litellm/utils.py,
  # _get_order_filtered_deployments).
  #
  # So this member is never chosen while the paid one is in budget, and is all
  # that remains once the paid one is dropped — which is what turns budget
  # exhaustion into a local answer instead of a refusal.
  #
  # It is the only native route. A fallbacks entry cannot work: the raise
  # happens during deployment selection, before an attempt exists to fail.
  # Per-key model_max_budget with budget_fallbacks is ENTERPRISE-LICENSED and
  # is rejected on this deployment — do not retry that route.
  - model_name: {{ _group }}
    litellm_params:
      model: openai/{{ llm_router_primary_model }}
      api_base: {{ llm_router_llm_large_base_url }}
      api_key: os.environ/LLM_LARGE_BEARER_TOKEN
      use_chat_completions_api: true
      # The primary's OWN cap (see llm_router_hermes_primary_max_parallel_requests,
      # 35-hermes-cloud.yml) — this deployment IS the primary model, so it must
      # track the same per-model value rather than the tier-wide default.
      max_parallel_requests: {{ llm_router_hermes_primary_max_parallel_requests }}
      # The same local admission bounds as the primary it duplicates.
      num_retries: {{ llm_router_local_num_retries }}
      stream_timeout: {{ llm_router_local_stream_timeout_seconds }}
      order: 2
    model_info:
      disable_background_health_check: true
      # The survivor's OWN window, from the primary's registry entry — not the
      # group's paid member's. Omitting it resolved max_input_tokens to null,
      # which exempts this deployment from enable_pre_call_checks entirely: an
      # over-long request that the paid member would have refused was instead
      # handed to a local gate that cannot serve it, and answered from a
      # silently truncated prompt. Advertising the real number is narrower than
      # the paid member on purpose (55-roles.yml, "FALLBACK ORDER IS ONE-WAY"):
      # a rejected request beats a confidently wrong answer. It stays the less
      # preferred member by order, so it can only ever be reached once the paid
      # member is budget-filtered out.
      max_input_tokens: {{ llm_router_hermes_primary_context_window }}
      max_tokens: {{ llm_router_hermes_primary_context_window }}
{% endfor %}
