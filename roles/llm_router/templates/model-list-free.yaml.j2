{# Standalone `free` / `free-zdrless` model groups; membership from
   `in_free_route`, split by zero_data_retention. Split out of
   model-list.yaml.j2 per .token-limits.yaml (real seam, never a raised
   budget); included by it, so `litellm_model` resolves from that context.
   Two model_names, not one, because assert-registry-render-parity.yml's
   NARROW-DEPLOYMENT-PREFERRED check forbids a narrower deployment
   outranking a wider sibling under one model_name, and the ZDR-true
   members here (131072 tok) are narrower than the ZDR-false one
   (1,000,000 tok); `free` -> `free-zdrless` (config.yaml.j2) is that
   check's own stated remedy, a distinct model_name. Membership stays
   apart from the price word `free`: the OpenCode Go entries here are a
   paid subscription tier, route membership and price are separate
   facts. `litellm_params.order` gives in-request escalation to the next
   order once the current one's deployments are exhausted
   (litellm/router_utils/fallback_event_handlers.py,
   `async_function_with_fallbacks_common_utils`), before the group's own
   external fallback entry is consulted. #}
{% macro _free_deployment(m, model_name, idx) %}
  - model_name: {{ model_name }}
    litellm_params:
      model: {{ litellm_model(m) }}
{% if m.tier == 'opencode' %}
      # provider: openai is an OpenAI-compatible wire protocol at a non-default endpoint.
      api_base: {{ m.api_base | default(llm_router_opencode_base_url) }}
      # Required since 2026-09-06 (see model-list-opencode.yaml.j2's standalone
      # registration for the vendor requirement, the source citation, and the
      # static-value ceiling); this is the same tier's second deployment.
      extra_headers:
        x-opencode-session: "hermes-router-{{ m.client_model_id | regex_replace('/', '-') }}"
{% endif %}
      api_key: os.environ/{{ m.credential_env }}
      use_chat_completions_api: true
      order: {{ idx }}
      # Rate/concurrency ceilings mirror this entry's own provider tier.
{% if m.tier == 'opencode' %}
      rpm: {{ llm_router_opencode_rpm }}
      tpm: {{ llm_router_opencode_tpm }}
      max_parallel_requests: {{ llm_router_opencode_max_parallel_requests }}
{% else %}
      rpm: {{ llm_router_openrouter_rpm }}
      tpm: {{ llm_router_openrouter_tpm }}
      max_parallel_requests: {{ llm_router_openrouter_max_parallel_requests }}
{% endif %}
    model_info:
      disable_background_health_check: true
      max_input_tokens: {{ m.context_window }}
{% if m.max_output_tokens is defined %}
      max_output_tokens: {{ m.max_output_tokens }}
      max_tokens: {{ m.max_output_tokens }}
{% else %}
      max_tokens: {{ m.context_window }}
{% endif %}
{% endmacro %}
{% set _free_entries = llm_router_registry_enabled | selectattr('in_free_route', 'defined') | selectattr('in_free_route') | list %}
{# `free`: ZDR-true members, OpenCode Go tier first, order from the attributes. #}
{% set _free_opencode = _free_entries | selectattr('tier', 'equalto', 'opencode') | list %}
{% set _free_zdr_other = (_free_entries | rejectattr('tier', 'equalto', 'opencode')
     | selectattr('zero_data_retention', 'undefined') | list)
     + (_free_entries | rejectattr('tier', 'equalto', 'opencode')
        | selectattr('zero_data_retention', 'defined') | selectattr('zero_data_retention') | list) %}
{# Credentialed only: filtered BEFORE the loop, not skipped inside it, so a
   missing credential never consumes an order slot that the next rendered
   deployment then silently inherits. #}
{% set _free_zdr_ordered = (_free_opencode + _free_zdr_other)
     | selectattr('credential_env', 'in', llm_router_resolved_credentials.keys() | list) | list %}
{% for m in _free_zdr_ordered %}
{{ _free_deployment(m, 'free', loop.index) }}
{% endfor %}
{# `free-zdrless`: the ZDR-false members, the terminal half `free`'s own fallback entry points at. #}
{% set _free_zdrless = _free_entries | selectattr('zero_data_retention', 'defined') | rejectattr('zero_data_retention')
     | selectattr('credential_env', 'in', llm_router_resolved_credentials.keys() | list) | list %}
{% for m in _free_zdrless %}
{{ _free_deployment(m, 'free-zdrless', loop.index) }}
{% endfor %}
