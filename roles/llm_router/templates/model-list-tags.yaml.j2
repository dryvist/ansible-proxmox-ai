{# One implementation of the LiteLLM deployment tag contract. A caller may
   override the class for a routed/free view while retaining the registry's
   ZDR, retention and telemetry tags. #}
{% macro deployment_tags(m, class_override='') -%}
{%- set _entry = m.client_model_id ~ '|' ~ m.tier -%}
{%- set _known = _entry in llm_router_deployment_tags_by_entry
      or m.client_model_id in llm_router_deployment_tags_by_model -%}
{%- set _tags = llm_router_deployment_tags_by_entry.get(_entry,
      llm_router_deployment_tags_by_model.get(m.client_model_id, ['retains'])) -%}
{%- if class_override -%}
{%- set _tags = [class_override] + (_tags[1:] if _known else _tags) -%}
{%- endif -%}
{{ _tags | to_json }}
{%- endmacro %}
