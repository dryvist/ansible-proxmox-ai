# {{ ansible_managed }}
# herdr-remote relay environment. Mode 0600, owned by {{ herdr_remote_user }}.
HERDR_RELAY_HOST={{ herdr_remote_bind_host }}
HERDR_RELAY_PORT={{ herdr_remote_bind_port }}
HERDR_TRUSTED_ORIGINS={{ herdr_remote_trusted_origins }}
{% if herdr_remote_relay_token | length > 0 %}
HERDR_RELAY_TOKEN={{ herdr_remote_relay_token }}
{% endif %}
{% if herdr_remote_remotes | length > 0 %}
HERDR_REMOTES={{ herdr_remote_remotes }}
{% endif %}
{% for key, value in (herdr_remote_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
