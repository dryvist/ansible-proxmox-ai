# {{ ansible_managed }}
---
services:
  crawl4ai:
    image: {{ crawl4ai_docker_image }}
    container_name: {{ crawl4ai_docker_container_name }}
    restart: {{ crawl4ai_docker_restart_policy }}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    mem_limit: {{ crawl4ai_docker_memory_limit }}
    pids_limit: {{ crawl4ai_docker_pids_limit }}
    ports:
      - "{{ crawl4ai_docker_port }}:{{ crawl4ai_docker_port }}"
    shm_size: "1gb"
    tmpfs:
      - /tmp
      - /var/lib/redis
      - /var/lib/crawl4ai/outputs
      - /home/appuser/.crawl4ai
      - /home/appuser/.cache/url_seeder
      - /home/appuser/.gunicorn
    environment:
      CRAWL4AI_API_TOKEN: "${CRAWL4AI_API_TOKEN:?CRAWL4AI_API_TOKEN must be set}"
