CREATE DATABASE IF NOT EXISTS {{ clickhouse_docker_llm_database }};
{% for table in clickhouse_docker_llm_tables %}

CREATE TABLE IF NOT EXISTS {{ clickhouse_docker_llm_database }}.{{ table }}
(
    event_time DateTime64(3),
    ingest_time DateTime64(3) DEFAULT now64(3),
    ingest LowCardinality(String) DEFAULT 'live',
    session_id String,
    message_id String,
    role LowCardinality(String),
    model String,
    repo String,
    cwd String,
    tool_name LowCardinality(String),
    content String CODEC(ZSTD(3)),
    raw String CODEC(ZSTD(3)),
    host String
)
ENGINE = ReplacingMergeTree(ingest_time)
PARTITION BY toYYYYMM(event_time)
ORDER BY (session_id, event_time, message_id);
{% endfor %}
