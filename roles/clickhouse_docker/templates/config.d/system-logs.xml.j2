<?xml version="1.0"?>
<!-- Rendered by roles/clickhouse_docker. -->
<clickhouse>
    <logger>
        <level>{{ clickhouse_docker_log_level }}</level>
    </logger>
{% for table in clickhouse_docker_system_log_ttl_tables %}
    <{{ table }}>
{% if table == 'text_log' %}
        <level>{{ clickhouse_docker_log_level }}</level>
{% endif %}
        <ttl>event_date + INTERVAL {{ clickhouse_docker_system_log_ttl_days }} DAY DELETE</ttl>
    </{{ table }}>
{% endfor %}
    <opentelemetry_span_log remove="1"/>
</clickhouse>
