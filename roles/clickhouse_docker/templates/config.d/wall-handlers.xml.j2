{#- Two fixed GET queries for the homelab wall gateway, answered as whichever
   user the request authenticates as (the gateway sends wall_reader). A
   plain <url> is an exact path match. <defaults/> keeps every built-in
   handler (the query endpoint, /ping, ...) that clients and the healthcheck
   rely on. -#}
<?xml version="1.0"?>
<!-- Rendered by roles/clickhouse_docker. -->
<clickhouse>
    <http_handlers>
        <rule>
            <url>{{ clickhouse_docker_wall_words_url }}</url>
            <methods>GET</methods>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT source, word, n FROM {{ clickhouse_docker_llm_database }}.{{ clickhouse_docker_wall_words_view }} ORDER BY source ASC, n DESC, word ASC FORMAT JSON</query>
            </handler>
        </rule>
        <rule>
            <url>{{ clickhouse_docker_wall_recent_url }}</url>
            <methods>GET</methods>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT ts, source, model, role, chars FROM {{ clickhouse_docker_llm_database }}.{{ clickhouse_docker_wall_recent_view }} ORDER BY ts DESC LIMIT {{ clickhouse_docker_wall_recent_rows }} FORMAT JSON</query>
            </handler>
        </rule>
        <defaults/>
    </http_handlers>
</clickhouse>
