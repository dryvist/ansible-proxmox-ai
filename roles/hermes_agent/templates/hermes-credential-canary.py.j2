#!/usr/bin/env python3
"""Check named-profile credential presence and primary Slack routes."""

import json
import re
import sys
from pathlib import Path


HERMES_HOME = Path({{ hermes_agent_hermes_home | to_json }})
PROFILE_EXPECTATIONS = json.loads({{ hermes_agent_credential_canary_profile_fields | to_json }})
CONFIG_PATHS = (HERMES_HOME / "config.yaml", Path("/etc/hermes/config.yaml"))
ENV_ASSIGNMENT = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
ROUTES_SECTION = re.compile(r"^(?P<indent> {0,2})profile_routes\s*:")
PROFILE_FIELD = re.compile(r"^\s+profile\s*:\s*(?P<value>.*?)\s*$")


def _has_value(value):
    value = value.strip()
    if value[:1] in ("'", '"'):
        closing = value.find(value[0], 1)
        if closing >= 0:
            value = value[1:closing]
    else:
        value = value.split(" #", 1)[0].strip()
    return bool(value.strip())


def _present_fields(env_path, required_fields):
    try:
        lines = env_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return set()

    present = {}
    required = set(required_fields)
    for line in lines:
        match = ENV_ASSIGNMENT.match(line.strip())
        if match and match.group(1) in required:
            present[match.group(1)] = _has_value(match.group(2))
    return {field for field, has_value in present.items() if has_value}


def _yaml_scalar(value):
    value = value.strip()
    if value.startswith('"'):
        try:
            parsed, _ = json.JSONDecoder().raw_decode(value)
            return parsed
        except json.JSONDecodeError:
            return ""
    if value.startswith("'"):
        end = value.find("'", 1)
        return value[1:end].replace("''", "'") if end >= 0 else ""
    return value.split("#", 1)[0].strip()


def _has_profile_route(config_text, profile_name):
    section_indent = None
    for line in config_text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if section_indent is None:
            section = ROUTES_SECTION.match(line)
            if section:
                section_indent = len(section.group("indent"))
            continue

        indent = len(line) - len(line.lstrip())
        if indent <= section_indent:
            section_indent = None
            continue

        field = PROFILE_FIELD.match(line)
        if field and _yaml_scalar(field.group("value")) == profile_name:
            return True
    return False


def _primary_route_present(profile_name):
    for config_path in CONFIG_PATHS:
        try:
            config_text = config_path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        if _has_profile_route(config_text, profile_name):
            return True
    return False


def main():
    missing = []
    for expected in PROFILE_EXPECTATIONS:
        profile_name = expected["name"]
        fields = expected.get("fields", [])
        env_path = HERMES_HOME / "profiles" / profile_name / ".env"
        present = _present_fields(env_path, fields)
        missing.extend(
            f"{profile_name}.{field}" for field in fields if field not in present
        )
        if expected.get("route_required", True) and not _primary_route_present(profile_name):
            missing.append(f"{profile_name}.profile_routes")

    if not PROFILE_EXPECTATIONS:
        missing.append("profiles.none")

    ok = not missing
    detail = (
        "all named profile credentials and Slack routes are present"
        if ok
        else "missing: " + ", ".join(missing)
    )
    print(json.dumps({"ok": ok, "detail": detail}, separators=(",", ":")))
    return 0 if ok else 2


if __name__ == "__main__":
    sys.exit(main())
