{# Hermes' native OTLP metrics export for the gateway process. #}
{% macro gateway_health_metrics(endpoint, interval_seconds) %}
monitoring:
  export:
    otlp:
      enabled: true
      # Hermes rewrites the /v1/traces suffix to /v1/metrics for the metrics exporter.
      endpoint: '{{ endpoint }}/v1/traces'
  gateway_health_export:
    enabled: true
    metrics_enabled: true
    diagnostic_events_enabled: false
    warning_error_events_enabled: false
    export_interval_seconds: {{ interval_seconds }}
{% endmacro %}
