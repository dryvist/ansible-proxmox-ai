#!/usr/bin/env python3
# {{ ansible_managed }}
#
# Drain-before-restart wrapper for the hermes-gateway unit.
#
# The gateway ticks the DEFAULT cron store in-process, so restarting it
# terminates whatever cron jobs are mid-run in that store. Restarting on a
# quiet moment is not a usable mitigation: the fleet spans several
# profile-scoped stores, each ticked on a 5-minute cycle, and a single run may
# legitimately occupy most of an hour — so "wait for a gap" has no gap to find
# and "wait until nothing is running" never terminates while ticks keep firing.
#
# The sequence that does terminate is quiesce -> wait -> restart -> un-quiesce:
#
#   1. Engage Hermes' own ESTOP sentinel ($HERMES_HOME/ESTOP) in every cron
#      store. Upstream documents the sentinel as the interface — cron dispatch,
#      kanban dispatch and new gateway turns all skip while it exists, and
#      in-flight work is never killed. A store an operator had already paused
#      is left alone and stays paused afterwards.
#   2. Poll every store's job records until no job holds a live fire claim,
#      bounded by DRAIN_TIMEOUT_SECONDS.
#   3. Restart the unit.
#   4. Release only the sentinels this run engaged.
#
# Step 4 runs from a `finally` (with SIGTERM/SIGINT mapped onto it), so an
# abort at any point still lifts the pause. Quiesce and un-quiesce live in ONE
# process for exactly that reason: a play that dies before its handler flush
# never reaches this script at all, so it cannot leave the fleet paused.
#
# A hard kill (SIGKILL, OOM, control-node power loss) reaches no handler at all,
# so step 1 stamps an owner marker and a timestamp into the sentinel, and step 1
# of the NEXT run reclaims one it can positively identify as its own and older
# than any live drain. Without that an orphan is indistinguishable from an
# operator's pause, the next converge dutifully preserves it, and the fleet
# stays stopped forever — with no failure, no alarm and no error log, because a
# paused fleet looks exactly like a quiet one.
#
# Exit status is the restart's, so a failed restart still fails the converge.

from __future__ import annotations

import json
import os
import pwd
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

# --- Rendered config ---------------------------------------------------------
HERMES_HOME = Path("{{ hermes_agent_hermes_home }}")
HERMES_USER = "{{ hermes_agent_user }}"
UNIT = "hermes-gateway"
# Upstream's claim_job_for_fire() default lease, refreshed by the runner's
# heartbeat for the whole execution: a claim younger than this means a live
# runner, and one older than this means a runner that died without clearing it.
CLAIM_TTL_SECONDS = {{ hermes_agent_cron_fire_claim_ttl_seconds }}
# How long to wait for in-flight runs before restarting anyway. Defaults to the
# per-run wall-clock ceiling, so a job still claimed at expiry has already
# outlived the runtime the fleet grants it and would be reaped regardless.
DRAIN_TIMEOUT_SECONDS = {{ hermes_agent_cron_drain_timeout_seconds }}
POLL_SECONDS = {{ hermes_agent_cron_drain_poll_seconds }}

SENTINEL_NAME = "ESTOP"
# Stamped into every sentinel this wrapper writes. Without it a sentinel
# orphaned by a hard kill (SIGKILL, OOM, control-node power loss) is
# indistinguishable from an operator's pause, so the next converge preserves it
# and the fleet stays stopped forever — silently, since a paused fleet raises
# nothing. Upstream counts any file as engaged regardless of body, so the extra
# field changes no upstream behaviour.
SENTINEL_OWNER = "ansible:hermes_agent:drain-before-restart"
# An orphan is reclaimable once it is older than any live drain could be: the
# drain bound plus room for the restart itself. Below that, an owned sentinel
# belongs to a converge still running and must not be stolen.
ORPHAN_AFTER_SECONDS = DRAIN_TIMEOUT_SECONDS + CLAIM_TTL_SECONDS


def log(message: str) -> None:
    print(f"drain-before-restart: {message}", flush=True)


def store_homes(hermes_home: Path) -> list[Path]:
    """Every cron store on the guest: the default one plus each profile.

    Discovered rather than templated, so a profile added or removed between
    converges is covered without redeploying this script. A profile that has
    registered no jobs yet has no cron/jobs.json; it is still quiesced, because
    the next converge may be the one that gives it jobs.
    """
    homes = [hermes_home]
    profiles = hermes_home / "profiles"
    if profiles.is_dir():
        homes.extend(sorted(p for p in profiles.iterdir() if p.is_dir()))
    return homes


def load_jobs(home: Path) -> list[dict]:
    """Job records in one store, or none when it has no readable store."""
    try:
        raw = json.loads((home / "cron" / "jobs.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    jobs = raw if isinstance(raw, list) else raw.get("jobs", [])
    return [job for job in jobs if isinstance(job, dict)]


def claimed_jobs(home: Path, now: datetime, ttl_seconds: float) -> list[str]:
    """Jobs in one store that a live runner currently holds.

    The freshness test is upstream's, bounded on both sides: a claim stamped in
    the future is treated as stale, not as fresh forever, so clock skew cannot
    wedge the drain. A claim older than the lease is likewise stale — the
    runner is gone and only the record survives it.

    Names are qualified by store: a job name is unique only within its own
    store, so bare names would collide across profiles.
    """
    live = []
    for job in load_jobs(home):
        if not isinstance(job, dict):
            continue
        claim = job.get("fire_claim")
        if not isinstance(claim, dict):
            continue
        try:
            at = datetime.fromisoformat(str(claim.get("at")))
        except (TypeError, ValueError):
            continue
        if at.tzinfo is None:
            at = at.replace(tzinfo=timezone.utc)
        age = (now - at).total_seconds()
        if 0 <= age < ttl_seconds:
            live.append(f"{home.name}/{job.get('name') or job.get('id')}")
    return live


def orphan_age(sentinel: Path, now: datetime) -> float | None:
    """Age in seconds of a dead converge's leftover, or None if not one.

    A number only for a sentinel this wrapper positively wrote and that is
    older than any live drain could be. Anything else — an operator's pause, an
    empty file from a bare `touch`, a body that will not parse, one without the
    owner marker however old, a sibling converge still draining — is somebody
    else's and is left alone. The age is returned rather than a bool so the
    clear can say how stale the thing it removed was.
    """
    try:
        state = json.loads(sentinel.read_text(encoding="utf-8"))
        if not isinstance(state, dict) or state.get("owner") != SENTINEL_OWNER:
            return None
        engaged_at = datetime.fromisoformat(str(state["engaged_at"]))
        age = (now - engaged_at).total_seconds()
    except (OSError, ValueError, TypeError, KeyError):
        return None
    return age if age > ORPHAN_AFTER_SECONDS else None


def engage(home: Path) -> str:
    """Take the ESTOP sentinel for this run.

    Returns "engaged" when the store was running, "reclaimed" when a dead
    converge's orphan was taken over (this run owns it and will release it), or
    "held" when the pause belongs to someone else and must survive.

    Ownership matters: the file is left to the runtime user so `hermes resume`
    can lift a pause this root-run script left behind.
    """
    sentinel = home / SENTINEL_NAME
    now = datetime.now(timezone.utc)
    outcome = "engaged"
    if sentinel.exists():
        age = orphan_age(sentinel, now)
        if age is None:
            return "held"
        log(
            f"{home.name}: clearing a pause this wrapper wrote {age:.0f}s ago and "
            f"never released — a converge died before its release could run (a live "
            f"drain cannot hold one past {ORPHAN_AFTER_SECONDS}s). It is owned by "
            "this run and goes out with it."
        )
        outcome = "reclaimed"
    payload = {
        "owner": SENTINEL_OWNER,
        "engaged_at": now.isoformat(),
        "reason": f"draining {UNIT} for restart",
    }
    sentinel.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    try:
        entry = pwd.getpwnam(HERMES_USER)
        os.chown(sentinel, entry.pw_uid, entry.pw_gid)
    except (KeyError, OSError):
        pass
    return outcome


def disengage(home: Path) -> None:
    try:
        (home / SENTINEL_NAME).unlink()
    except OSError:
        pass


def wait_for_drain(
    homes: list[Path],
    *,
    ttl_seconds: float = CLAIM_TTL_SECONDS,
    timeout_seconds: float = DRAIN_TIMEOUT_SECONDS,
    poll_seconds: float = POLL_SECONDS,
) -> list[str]:
    """Block until no store holds a live claim. Returns what was still live.

    An empty list means the fleet drained; a non-empty one means the bound
    expired first and names what the restart is about to interrupt.
    """
    deadline = time.monotonic() + timeout_seconds
    while True:
        now = datetime.now(timezone.utc)
        live = [job for home in homes for job in claimed_jobs(home, now, ttl_seconds)]
        if not live:
            return []
        if time.monotonic() >= deadline:
            return live
        log(f"waiting on {len(live)} in-flight run(s): {', '.join(sorted(live))}")
        time.sleep(min(poll_seconds, max(deadline - time.monotonic(), 0)))


def restart() -> int:
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    # A unit parked on start-limit-hit (five failed starts inside the
    # StartLimitInterval) refuses `restart` until the counter is cleared, and
    # a converge is the sanctioned way to clear it — never a hand-run
    # reset-failed on the guest. Harmless when the unit is healthy.
    subprocess.run(["systemctl", "reset-failed", UNIT], check=False)
    return subprocess.run(["systemctl", "restart", UNIT]).returncode


def _raise_on_signal(signum, _frame):
    raise SystemExit(128 + signum)


def main() -> int:
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, _raise_on_signal)

    homes = store_homes(HERMES_HOME)
    ours: list[Path] = []
    try:
        for home in homes:
            outcome = engage(home)
            if outcome == "held":
                log(f"{home.name} is paused by someone else — leaving it that way")
                continue
            ours.append(home)
        log(f"quiesced {len(ours)} store(s); draining up to {DRAIN_TIMEOUT_SECONDS}s")

        stranded = wait_for_drain(homes)
        if stranded:
            log(
                f"drain bound of {DRAIN_TIMEOUT_SECONDS}s expired with "
                f"{len(stranded)} run(s) still claimed past their own wall-clock "
                f"ceiling; restarting anyway: {', '.join(sorted(stranded))}"
            )
        else:
            # The denominator, not just the verdict: "no in-flight runs" reads
            # identically whether this scanned every job in the fleet or found
            # no stores at all. A drain that is looking at nothing reports the
            # same clean line as a drain that looked and found nothing, and a
            # guard nobody can distinguish from a broken one is not a guard.
            scanned = sum(len(load_jobs(home)) for home in homes)
            log(
                f"no in-flight runs across {len(homes)} store(s) holding "
                f"{scanned} job(s); restarting"
            )
        return restart()
    finally:
        for home in ours:
            disengage(home)
        if ours:
            log(f"released {len(ours)} pause(s)")


if __name__ == "__main__":
    sys.exit(main())
