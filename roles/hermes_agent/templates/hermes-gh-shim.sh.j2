#!/bin/sh
# {{ ansible_managed }}
# gh wrapper: sets GH_TOKEN from the file hermes-gh-token.timer refreshes, then
# runs the real gh. HERMES_GH_TOKEN_SET selects the set (default: review).
set -eu
key="${HERMES_GH_TOKEN_SET:-review}"
case "$key" in
{% for key in hermes_agent_github_identity_sets %}
  {{ key }}) ;;
{% endfor %}
  *) echo "gh: unknown HERMES_GH_TOKEN_SET '$key'" >&2; exit 2 ;;
esac
file="{{ hermes_agent_github_identity_token_dir }}/$key"
if [ ! -s "$file" ]; then
  echo "gh: no GitHub token at $file (hermes-gh-token.timer not run?)" >&2
  exit 1
fi
GH_TOKEN="$(cat "$file")"
export GH_TOKEN
unset GITHUB_TOKEN
exec {{ hermes_agent_github_identity_real_gh }} "$@"
