{{ ansible_managed | comment }}
# Secrets for the standalone github-public gateway
# (hermes_agent_github_public_gateway_*): the webhook secret and the model API
# key, plus the shared non-credential operational settings. Nothing else.
# This key is the per-profile router key for the profile directory name
# (hermes_<name>_llm_router_key); no fallback to another store's key.
HERMES_AGENT_MODEL_API_KEY={{ bao_apps_secrets['hermes_' ~ (hermes_agent_github_public_gateway_profile | replace('-', '_')) ~ '_llm_router_key']
   | mandatory('hermes_' ~ (hermes_agent_github_public_gateway_profile | replace('-', '_')) ~ '_llm_router_key missing from bao_apps_secrets for the public gateway — seed it in ansible-proxmox-apps. No fallback key is allowed.') }}

WEBHOOK_ENABLED=true
WEBHOOK_PORT={{ hermes_agent_github_public_gateway_port }}
WEBHOOK_SECRET={{ hermes_agent_webhook_secret }}

{% include 'hermes-env-operational.j2' %}
