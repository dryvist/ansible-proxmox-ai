# Kanban dispatcher bounds. Upstream (>=v0.13) runs the dispatcher inside the
# gateway BY DEFAULT — dispatch_in_gateway and auto_decompose both default
# true with NO concurrency cap — so a stock gateway will decompose and spawn a
# worker per ready card, unbounded. This block makes that implicit engine
# explicit and BOUNDS it against the single shared serving deployment (same
# measured-envelope rationale as gateway.api_server.max_concurrent_runs
# below). The board only gets cards from session classes holding the opt-in
# `kanban` toolset (see platform_toolsets) — cards, not this block, start work.
kanban:
  dispatch_in_gateway: true
  orchestrator_profile: {{ 'default' if _pepper else hermes_agent_kanban_orchestrator_profile }}
  # Fallback assignee profile for ready cards that carry no explicit assignee.
  # The v0.18.0 dispatcher only spawns workers for ASSIGNED cards; without this
  # every card is skipped_unassigned and the board never starts work. Read by
  # the gateway dispatcher (gateway/kanban_watchers.py: kanban.default_assignee).
  default_assignee: {{ 'default' if _pepper else hermes_agent_kanban_orchestrator_profile }}
{% if _pepper %}
  dispatch_profiles: [default]
{% endif %}
  dispatch_interval_seconds: 60
  max_in_progress: {{ hermes_agent_kanban_max_in_progress }}
  max_in_progress_per_profile: {{ hermes_agent_kanban_max_in_progress_per_profile }}
  auto_decompose: true
  auto_decompose_per_tick: 3
  failure_limit: 2
