{# Profile extras: a profile enables the plugins it names in its own `plugins` list, and only those open in
   this render (hermes_agent_profile_plugins_open, 155-plugins.yml). The root config passes no profile.
   plugins.isolation stays at its in_process default: hermes-agent v0.22.5 refuses ctx.register_platform in
   the plugin host (hermes_cli/plugin_isolation.py HOST_UNSUPPORTED_CTX_METHODS; hermes_cli/plugin_host_child.py
   __getattr__), and the homeassistant plugin registers a platform (its __init__.py register()). #}
{% set _extras = (hermes_agent_profile.plugins | default([]) if hermes_agent_profile is defined else []) | select('in', hermes_agent_profile_plugins_open | default([])) | list %}
plugins:
  enabled:
{% for name in hermes_agent_plugins_enabled + _extras %}
    - {{ name }}
{% endfor %}
