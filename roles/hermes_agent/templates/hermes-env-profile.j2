{{ ansible_managed | comment }}
# Secrets for the "{{ hermes_agent_profile.name }}" Hermes profile
# ({{ hermes_agent_profile.description }}). Only the sections named in this
# profile's `env` list (hermes_agent_profiles, defaults/main.yml) carry a
# real value below — every other credential this file could hold is
# rendered BLANK on purpose.
#
# Why blank, not omitted: a worker spawned into this profile
# (`hermes -p {{ hermes_agent_profile.name }} chat ...`) INHERITS the default
# gateway process's full environment (normal fork/exec), then this file loads
# with dotenv override=True — so a key PRESENT here always wins, but a key
# simply ABSENT from this file leaves the inherited (default profile's) value
# untouched and readable. Blanking every key this profile must not have is
# therefore the actual enforcement, not a stylistic choice — see the
# "profile isolation" note on hermes_agent_profiles in defaults/main.yml for
# the OS-user caveat this does and does not cover.
# This profile's own per-profile router key
# (hermes_{{ hermes_agent_profile.name | replace('-', '_') }}_llm_router_key,
# roles/llm_router A4/56-virtual-keys.yml — same field-naming contract that
# role generates). No fallback to the default store's key or the shared
# master key: a profile without its own seeded key fails the converge here
# rather than silently running with a broader identity than declared.
HERMES_AGENT_MODEL_API_KEY={{ bao_apps_secrets['hermes_' ~ (hermes_agent_profile.name | replace('-', '_')) ~ '_llm_router_key']
   | mandatory('hermes_' ~ (hermes_agent_profile.name | replace('-', '_')) ~ '_llm_router_key missing from bao_apps_secrets for profile '
               ~ hermes_agent_profile.name ~ ' — seed it in ansible-proxmox-apps. No fallback key is allowed.') }}

{% include 'hermes-env-operational.j2' %}

{% include 'hermes-env-langfuse.j2' %}

# Slack (worker tool posts + `hermes send`). Not scoped per profile today —
# every profile that posts to Slack uses the one shared bot token.
{% if hermes_agent_id != 'donna' or hermes_agent_slack_bot_token | length > 0 %}
SLACK_BOT_TOKEN={{ hermes_agent_slack_bot_token if 'slack' in hermes_agent_profile.env else '' }}
{% endif %}
SLACK_APP_TOKEN={{ hermes_agent_slack_app_token if 'slack' in hermes_agent_profile.env else '' }}
SLACK_ALLOWED_USERS={{ hermes_agent_slack_allowed_users if 'slack' in hermes_agent_profile.env else '' }}
SLACK_HOME_CHANNEL={{ hermes_agent_slack_home_channel if 'slack' in hermes_agent_profile.env else '' }}
SLACK_HOME_CHANNEL_NAME={{ hermes_agent_slack_home_channel_name if 'slack' in hermes_agent_profile.env else '' }}

# Splunk MCP client — this profile's config.yaml mcp_servers.splunk (when
# rendered) resolves these ${VARS} at connect time.
{% if hermes_agent_splunk_access | bool %}
SPLUNK_MCP_URL={{ hermes_agent_splunk_mcp_url if 'splunk' in hermes_agent_profile.env else '' }}
SPLUNK_MCP_TOKEN={{ hermes_agent_splunk_mcp_token if 'splunk' in hermes_agent_profile.env else '' }}
{% endif %}
{# With the facade canary enabled, profiles use the same identity-scoped field
   as roster-owned MCPs.
   Preserve the existing blank line for non-owner profiles when this role owns
   any MCP targets, so dotenv cannot inherit the default profile's key. -#}
{% set _facade_canary = hermes_agent_facade_canary_enabled | default(false) | bool -%}
{% set _facade_selected = _facade_canary and ('vikunja' in hermes_agent_profile.mcp)
   and (hermes_agent_vikunja_mcp_enabled | bool) -%}
{% set _profile_owns_mcp = hermes_agent_owned_mcp_slugs | default([]) | select('in', hermes_agent_profile.mcp) | list | length > 0 -%}
{% set _gateway_key_visible = _facade_canary or (hermes_agent_owned_mcp_slugs | default([]) | length > 0) -%}
{% set _gateway_key_required = _facade_selected or (not _facade_canary and _profile_owns_mcp) -%}
{{ ('HERMES_AGENT_GATEWAY_KEY=' ~
    ((openbao_secrets_by_domain[hermes_agent_id][hermes_agent_gateway_key_field]
      | mandatory(hermes_agent_gateway_key_field ~ ' missing from the ' ~ hermes_agent_id ~ ' OpenBao domain'))
     if _gateway_key_required else ''))
   if _gateway_key_visible else '' }}
# Zammad ITSM client — the dryvist/zammad-incidents skill reads these at use
# time (Authorization: Token token=$ZAMMAD_API_TOKEN).
ZAMMAD_URL={{ hermes_agent_zammad_url if 'zammad' in hermes_agent_profile.env else '' }}
ZAMMAD_API_TOKEN={{ hermes_agent_zammad_api_token if 'zammad' in hermes_agent_profile.env else '' }}

# Home Assistant (presence-gated: rendered only for a profile whose config enables the plugin,
# hermes_agent_homeassistant_enabled in 155-plugins.yml). Read-only token, base URL, optional notify target
# and optional entity denylist.
{% set _ha_on = ('homeassistant' in hermes_agent_profile.env) and (hermes_agent_homeassistant_enabled | default(false) | bool) %}
HASS_TOKEN={{ hermes_agent_homeassistant_token if _ha_on else '' }}
HASS_URL={{ hermes_agent_homeassistant_url if _ha_on else '' }}
HASS_HOME_CHANNEL={{ hermes_agent_homeassistant_home_channel if _ha_on else '' }}
HASS_ENTITY_DENYLIST={{ hermes_agent_homeassistant_entity_denylist if _ha_on else '' }}

# llm-wiki. Not a credential (no 'env' grant needed) — hermes_agent_wiki_path
# is the SAME directory every profile shares (hermes_agent_home/wiki, a
# sibling of $HERMES_HOME, not inside it), same posture as the shared
# Hindsight memory bank. Gated on hermes_agent_wiki_enabled only, matching
# the default profile's hermes-env.j2. The research/llm-wiki skill itself is
# still opt-in per profile (tasks/profiles.yml materializes it only when a
# profile's `skills` list names it) — this var alone does not grant access.
{% if hermes_agent_wiki_enabled | bool %}
WIKI_PATH={{ hermes_agent_wiki_path }}
{% endif %}

# GitHub. The bundled read-only skill authenticates with this key. A profile
# granted `github` gets the READ-ONLY hermes_agent_github_read_token here; a
# profile without that grant renders it blank. Default-profile scheduled issue
# work uses the role's short-lived GitHub identity instead.
GH_PAT_WRITE_PROJECT_ISSUES={{ hermes_agent_github_read_token if 'github' in hermes_agent_profile.env else '' }}
# dryvist-guardrails: blocks GitHub writes from the shell and code tools. Set only for
# the profiles listed in hermes_agent_guardrails_github_readonly_profiles (155-plugins.yml).
DRYVIST_GUARDRAILS_GITHUB_READONLY={{ '1' if hermes_agent_profile.name in hermes_agent_guardrails_github_readonly_profiles else '' }}

# Deliberately always blank for every profile today — present so an inherited
# default-profile value can never leak through by simple omission.
CONTEXT7_API_KEY=

# Browser settings, rendered for every profile rather than gated. These are
# operational settings, not grants: the executable path and the sandbox flag
# must hold in a worker or its browser downloads a second Chromium or fails to
# start. Nothing here authorises anything.
AGENT_BROWSER_EXECUTABLE_PATH={{ hermes_agent_chromium_executable }}
AGENT_BROWSER_ARGS={{ hermes_agent_browser_args }}

# Firecrawl reaches a self-hosted service whose access control is the firewall,
# and every profile runs on a guest already inside that allowlist — so gating
# the URL per profile would remove page-reading from workers while granting no
# security. The key is an internal placeholder the service does not check.
{% if hermes_agent_firecrawl_enabled | bool %}
FIRECRAWL_API_URL={{ hermes_agent_firecrawl_api_url }}
FIRECRAWL_API_KEY={{ hermes_agent_firecrawl_api_key }}
{% endif %}
