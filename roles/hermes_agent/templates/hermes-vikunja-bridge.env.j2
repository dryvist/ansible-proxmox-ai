{{ ansible_managed | comment }}
# Environment for the Vikunja Kanban bridge. Rendered 0600, hermes-owned.
#
# This file exists so the WRITE-scoped Vikunja token never lands in the script
# template (which is 0750 and readable by the group). The Ansible-side variable
# is hermes_agent_vikunja_bridge_token, sourced from HERMES_VIKUNJA_API_TOKEN —
# a different credential from ai_runner's VIKUNJA_API_TOKEN, on purpose. The
# name below is the one the daemon's own process environment uses.
VIKUNJA_API_TOKEN={{ hermes_agent_vikunja_bridge_token }}
