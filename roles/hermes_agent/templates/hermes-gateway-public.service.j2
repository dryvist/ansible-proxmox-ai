{{ ansible_managed | comment }}
[Unit]
Description=Hermes Agent public-review gateway (github-public webhook route only)
After=network-online.target
Wants=network-online.target
# Same bounded-restart and page-on-failure pairing as hermes-gateway.service.
# StartLimit* belong in [Unit]; systemd 229+ ignores them in [Service].
StartLimitIntervalSec={{ hermes_agent_unit_restart_interval_sec }}
StartLimitBurst={{ hermes_agent_unit_restart_burst }}
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
# cwd MUST be $HERMES_HOME (see hermes-gateway.service).
WorkingDirectory={{ hermes_agent_github_public_gateway_home }}
Environment=HERMES_HOME={{ hermes_agent_github_public_gateway_home }}
Environment=HERMES_GITHUB_APP_SLUG={{ hermes_agent_github_app_slug }}
# Trust boundary the gh wrapper pins this process tree to.
Environment=HERMES_TRUST_BOUNDARY=public
EnvironmentFile={{ hermes_agent_github_public_gateway_home }}/.env
ExecStart={{ hermes_agent_github_public_gateway_cmd }}
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
