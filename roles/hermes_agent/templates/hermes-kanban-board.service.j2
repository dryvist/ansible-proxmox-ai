{{ ansible_managed | comment }}
[Unit]
Description=Hermes Kanban board (operator view over the agent task store)
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
WorkingDirectory={{ hermes_agent_hermes_home }}
Environment=HERMES_HOME={{ hermes_agent_hermes_home }}
Environment=HERMES_BIN={{ hermes_agent_bin }}
Environment=KANBAN_BOARD_HOST={{ hermes_agent_kanban_board_host }}
Environment=KANBAN_BOARD_PORT={{ hermes_agent_kanban_board_port }}
EnvironmentFile=-{{ hermes_agent_hermes_home }}/.env
ExecStart=/usr/bin/env python3 {{ hermes_agent_hermes_home }}/scripts/{{ hermes_agent_kanban_board_script_name }}
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
