#!/usr/bin/env python3
{{ ansible_managed | comment }}
"""Deterministic, no-LLM Splunk status digest.

STDOUT is delivered verbatim to Slack (cron runs `--no-agent --deliver slack:<ch>`),
so everything printed here must be TRUE. Never invent data. Missing / zero / stale
data is ALWAYS an explicit anomaly, never summarized as "no anomalies" (Zammad
#17143 fabrication; #17144 masked ingest outage).

Every hourly run posts the real numbers AND their change since the previous run.
There is no "no change" short-circuit: a flat hour is reported as flat *with* the
volumes that are flat, because a bare "No change" line is recycled boilerplate
that carries no information and trains readers to ignore the channel.

Pure stdlib + the `mcp` client (present in the hermes-agent venv, which runs this
file — `hermes cron ... --script *.py` executes non-.sh scripts via Python). Reads
secrets from the .env file, never prints them. The MCP streamable-http teardown
emits a harmless "Session termination failed: 202" on STDERR only; it never reaches
STDOUT, and the single terminal print() keeps the delivered payload clean.
"""
import asyncio
import datetime as dt
import hashlib
import json
import math
import os
import sys

# --- config (rendered from roles/hermes_agent/defaults/main.yml) ---------------
ENV_PATH = "{{ hermes_agent_hermes_home }}/.env"
STATE_PATH = "{{ hermes_agent_hermes_home }}/state/splunk-digest.json"
# Expected-continuous indexes: absent / zero-volume / stale here is an ingest
# anomaly, not "no anomalies". #17144 was os + network going silent unnoticed.
EXPECTED_CONTINUOUS = {{ hermes_agent_splunk_digest_expected_indexes | to_json }}
STALENESS_MIN = {{ hermes_agent_splunk_digest_staleness_minutes }}
EARLIEST = "{{ hermes_agent_splunk_digest_window }}"
# Inventory + liveness via tstats metadata ONLY — never index=* over raw events.
# Grouped by host too: 24h volume per index is the headline, host counts and
# host-set changes are how a single dead forwarder shows up before the index
# total drops far enough to look like an outage.
TSTATS_QUERY = "| tstats count as vol, max(_time) as last_time where index=* by index, host"
# State schema version. Bumped when the shape changes; an older/absent value
# means "no usable baseline" and the run reports full numbers with no deltas.
STATE_SCHEMA = 2
# ponytail: calibration knob, deliberately a module constant and not an Ansible
# variable — one number, one consumer. Percent swing that promotes an index to
# the "movers" line. Raise it if normal diurnal jitter starts filling the line.
MOVER_PCT = 25.0
# Cap on how many host names a single set-change line will spell out.
MAX_NAMED_HOSTS = 5


def load_env(path):
    """Parse KEY=VALUE lines. Values may be quoted."""
    env = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip('"').strip("'")
    return env


async def run_tstats(url, token):
    """Return the parsed results list, or raise on any failure."""
    from mcp.client.streamable_http import streamablehttp_client
    from mcp import ClientSession

    async with streamablehttp_client(url, headers={"Authorization": f"Bearer {token}"}) as (r, w, _):
        async with ClientSession(r, w) as s:
            await s.initialize()
            res = await s.call_tool("splunk_run_query", {"query": TSTATS_QUERY, "earliest": EARLIEST})
            if getattr(res, "isError", False):
                raise RuntimeError("splunk_run_query returned isError=true")
            data = res.structuredContent
            if not isinstance(data, dict):
                # fall back to text content
                if res.content and getattr(res.content[0], "text", None):
                    data = json.loads(res.content[0].text)
                else:
                    raise RuntimeError("no structuredContent and no text content")
            return data.get("results", [])


def oom_bucket(vol):
    """Order-of-magnitude bucket so normal jitter doesn't churn the fingerprint."""
    return 0 if vol <= 0 else int(math.log10(vol))


def fmt_age(minutes):
    if minutes < 90:
        return f"{int(round(minutes))} min"
    hours = minutes / 60.0
    if hours < 48:
        return f"{hours:.1f} h"
    return f"{hours / 24:.1f} d"


def fmt_vol(v):
    return f"{v:,}"


def fmt_delta(cur, prev_vol, have_baseline):
    """Delta cell. Explicit about zero; explicit about *why* a delta is absent."""
    if not have_baseline:
        return "no baseline"
    if prev_vol is None:
        return "NEW"
    diff = cur - prev_vol
    return "0" if diff == 0 else f"{diff:+,}"


def pct_change(cur, prev_vol):
    """Percent change, or None when it is undefined (no baseline / prior zero)."""
    if prev_vol is None or prev_vol <= 0:
        return None
    return (cur - prev_vol) * 100.0 / prev_vol


def name_list(names):
    """Comma-joined, capped, with an honest '+N more' tail."""
    shown = sorted(names)[:MAX_NAMED_HOSTS]
    extra = len(names) - len(shown)
    return ", ".join(shown) + (f" (+{extra} more)" if extra > 0 else "")


def parse_results(results, now_epoch):
    """Fold the per-(index, host) rows into per-index records + the host set."""
    by_index = {}
    all_hosts = set()
    saw_host_field = False
    for row in results:
        idx = row.get("index")
        if idx is None:
            continue
        try:
            vol = int(float(row.get("vol", 0)))
        except (TypeError, ValueError):
            vol = 0
        try:
            last = int(float(row.get("last_time", 0)))
        except (TypeError, ValueError):
            last = 0
        rec = by_index.setdefault(idx, {"vol": 0, "last_time": 0, "hosts": set()})
        rec["vol"] += vol
        rec["last_time"] = max(rec["last_time"], last)
        host = row.get("host")
        if host is not None:
            saw_host_field = True
            if host != "":
                rec["hosts"].add(host)
                all_hosts.add(host)
    for rec in by_index.values():
        rec["age_min"] = (now_epoch - rec["last_time"]) / 60.0 if rec["last_time"] > 0 else float("inf")
    return by_index, all_hosts, saw_host_field


def build_digest(results, now_epoch, prev):
    """Return (full_text, fingerprint, snapshot).

    `prev` is the previous run's snapshot (or None when there is no usable
    baseline — first run, or a pre-delta state file). `snapshot` is what this
    run persists for the next one to diff against.
    """
    by_index, all_hosts, saw_host_field = parse_results(results, now_epoch)

    def is_silent(rec):
        return rec is None or rec["vol"] == 0 or rec["age_min"] > STALENESS_MIN

    # ingest-silence anomalies over the expected-continuous list
    anomalies = []
    for idx in EXPECTED_CONTINUOUS:
        rec = by_index.get(idx)
        if is_silent(rec):
            if rec is None:
                anomalies.append(f":warning: INGEST SILENCE: index={idx} — ABSENT from results, 24h volume 0")
            else:
                anomalies.append(
                    f":warning: INGEST SILENCE: index={idx} — last event {fmt_age(rec['age_min'])} ago, "
                    f"24h volume {fmt_vol(rec['vol'])}"
                )

    all_expected_silent = all(is_silent(by_index.get(i)) for i in EXPECTED_CONTINUOUS)
    zero_rows = len(by_index) == 0

    # health counters (honest populations): healthy = present, nonzero, fresh
    healthy = sum(1 for r in by_index.values() if r["vol"] > 0 and r["age_min"] <= STALENESS_MIN)
    silent_count = len(anomalies)

    # fingerprint: sorted (index, oom_bucket, is_silent) incl. absent-expected.
    # It no longer gates whether numbers are reported — it only answers "did the
    # health picture change materially since last hour", which is worth saying.
    fp_tuples = sorted(
        [(i, oom_bucket(r["vol"]), is_silent(r)) for i, r in by_index.items()]
        + [(i, -1, True) for i in EXPECTED_CONTINUOUS if i not in by_index]
    )
    fingerprint = hashlib.sha256(json.dumps(fp_tuples).encode()).hexdigest()

    snapshot = {
        "by_index": {i: {"vol": r["vol"], "hosts": len(r["hosts"])} for i, r in by_index.items()},
        "hosts": sorted(all_hosts),
        "host_detail": saw_host_field,
    }

    # --- deltas vs the previous run -------------------------------------------
    prev_by_index = (prev or {}).get("by_index") or {}
    have_baseline = prev is not None
    prev_hosts = set((prev or {}).get("hosts") or [])
    prev_host_detail = bool((prev or {}).get("host_detail"))

    def prev_vol(idx):
        rec = prev_by_index.get(idx)
        return rec.get("vol") if isinstance(rec, dict) else None

    gone_indexes = sorted(set(prev_by_index) - set(by_index))
    new_indexes = sorted(i for i in by_index if have_baseline and prev_vol(i) is None)
    new_hosts = all_hosts - prev_hosts if (have_baseline and prev_host_detail) else set()
    gone_hosts = prev_hosts - all_hosts if (have_baseline and prev_host_detail) else set()

    everything_flat = (
        have_baseline
        and not gone_indexes
        and not new_indexes
        and not new_hosts
        and not gone_hosts
        and all(r["vol"] == prev_vol(i) for i, r in by_index.items())
    )

    # --- compose full digest ---
    now_iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines = []
    if zero_rows or all_expected_silent:
        lines.append(":rotating_light: *SPLUNK INGEST OUTAGE* :rotating_light:")
        if zero_rows:
            lines.append("tstats returned ZERO rows over the last 24h — no index reported any data.")
        else:
            lines.append("ALL expected-continuous indexes are silent or stale — likely a pipeline/ingest failure.")
        lines.append("")

    if have_baseline:
        since = (prev or {}).get("captured_iso")
        try:
            since_txt = dt.datetime.fromisoformat(since).strftime("%H:%M UTC")
        except (TypeError, ValueError):
            since_txt = "the previous run"
        baseline_txt = f"Δ vs {since_txt}"
    else:
        baseline_txt = "Δ unavailable — no prior baseline"
    lines.append(f"*Splunk Status Digest* — {now_iso} (24h window; {baseline_txt})")

    if not saw_host_field:
        host_txt = "hosts: unavailable (query returned no host field)"
    elif not have_baseline or not prev_host_detail:
        host_txt = f"hosts: {len(all_hosts)} (no baseline)"
    else:
        net = len(all_hosts) - len(prev_hosts)
        host_txt = f"hosts: {len(all_hosts)} ({net:+d})" if net else f"hosts: {len(all_hosts)} (flat)"
    lines.append(
        f"Indexes reporting: {len(by_index)}  |  healthy: {healthy}  |  "
        f"expected silent: {silent_count}  |  {host_txt}"
    )
    lines.append("")
    lines.append("```")
    lines.append(f"{'INDEX':<16} {'24h VOLUME':>13} {'Δ vs PREV':>12} {'HOSTS':>6} {'LAST EVENT':>11}")
    for idx, r in sorted(by_index.items(), key=lambda kv: kv[1]["vol"], reverse=True):
        lines.append(
            f"{idx:<16} {fmt_vol(r['vol']):>13} {fmt_delta(r['vol'], prev_vol(idx), have_baseline):>12} "
            f"{len(r['hosts']):>6} {fmt_age(r['age_min']):>11}"
        )
    lines.append("```")

    if not have_baseline:
        lines.append(":information_source: No prior baseline (first run, or the state file predates delta "
                     "tracking) — volumes above are real, deltas begin with the next run.")
    elif everything_flat:
        lines.append(f":left_right_arrow: All {len(by_index)} indexes FLAT vs the previous run — every 24h "
                     f"volume above is byte-identical to last hour, and all {len(all_hosts)} hosts are the "
                     "same set. A rolling 24h window that does not move at all is itself worth a look.")
    else:
        movers = []
        for idx, r in sorted(by_index.items(), key=lambda kv: kv[1]["vol"], reverse=True):
            pct = pct_change(r["vol"], prev_vol(idx))
            if pct is not None and abs(pct) >= MOVER_PCT:
                movers.append(f"{idx} {pct:+.0f}% ({fmt_vol(prev_vol(idx))} -> {fmt_vol(r['vol'])})")
        if movers:
            lines.append(f"*Movers* (>= {MOVER_PCT:.0f}% swing): " + "; ".join(movers))

    if new_indexes:
        lines.append(":new: Newly reporting since last run: " + ", ".join(new_indexes))
    for idx in gone_indexes:
        lines.append(f":warning: index={idx} STOPPED reporting — had {fmt_vol(prev_by_index[idx].get('vol', 0))} "
                     "events at the previous run, absent now")
    if gone_hosts:
        lines.append(f":warning: {len(gone_hosts)} host(s) stopped logging since last run: {name_list(gone_hosts)}")
    if new_hosts:
        lines.append(f":new: {len(new_hosts)} host(s) started logging since last run: {name_list(new_hosts)}")

    lines.append("")
    if anomalies:
        lines.append("*Ingest silence anomalies:*")
        lines.extend(anomalies)
    else:
        lines.append(f":white_check_mark: All {len(EXPECTED_CONTINUOUS)} expected-continuous indexes fresh "
                     f"(< {STALENESS_MIN} min) with data in the last 24h.")

    return "\n".join(lines), fingerprint, snapshot


def load_state():
    """Return the stored state, or None when it is unreadable."""
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) else None


def baseline_from(state):
    """The previous snapshot, or None when the state carries no usable baseline.

    A pre-delta state file (schema < 2, no by_index) is treated as "no baseline"
    rather than an error — the run reports full numbers and deltas resume next hour.
    """
    if not state or state.get("schema") != STATE_SCHEMA:
        return None
    return state if isinstance(state.get("by_index"), dict) else None


def save_state(fingerprint, first_seen_iso, last_post_date, snapshot, captured_iso):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    payload = {"schema": STATE_SCHEMA, "fingerprint": fingerprint,
               "first_seen_iso": first_seen_iso, "last_post_date": last_post_date,
               "captured_iso": captured_iso}
    payload.update(snapshot)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, STATE_PATH)


def stability_line(state, fingerprint, now, today):
    """One honest line about how long the health picture has held."""
    if not state:
        # No prior run to have changed *from* — saying "CHANGED" here would be a
        # comparison against nothing, i.e. a fabrication.
        return "Health-state baseline established (no prior state file).", now.isoformat()
    if state.get("fingerprint") != fingerprint:
        return ":arrows_counterclockwise: Health state CHANGED vs the previous run.", now.isoformat()
    first_seen_iso = state.get("first_seen_iso", now.isoformat())
    try:
        first_date = dt.datetime.fromisoformat(first_seen_iso).date()
        day_n, first_short = (now.date() - first_date).days + 1, first_date.isoformat()
    except (TypeError, ValueError):
        day_n, first_short = 1, today
    return f"Health state unchanged — Day {day_n} since {first_short}.", first_seen_iso


def main():
    # fail loud, never fabricate: any error is delivered, then exit 0
    try:
        env = load_env(ENV_PATH)
        url = env.get("SPLUNK_MCP_URL")
        token = env.get("SPLUNK_MCP_TOKEN")
        if not url or not token:
            raise RuntimeError("SPLUNK_MCP_URL / SPLUNK_MCP_TOKEN missing from .env")
        results = asyncio.run(run_tstats(url, token))
    except Exception as e:  # noqa: BLE001 - deliberately broad; failure must be delivered
        # asyncio.TaskGroup wraps the real fault in an ExceptionGroup; unwrap to
        # the root leaf so the delivered message names the actual cause (e.g.
        # "502 Bad Gateway from the Splunk MCP") instead of a useless
        # "ExceptionGroup: 1 sub-exception". Keep it short and free of secrets.
        root = e
        for _ in range(10):
            sub = getattr(root, "exceptions", None)
            if not sub:
                break
            root = sub[0]
        print(f":warning: Splunk digest FAILED: {type(root).__name__}: {str(root)[:200]}")
        return 0

    now = dt.datetime.now(dt.timezone.utc)
    today = now.strftime("%Y-%m-%d")
    state = load_state()
    full_text, fingerprint, snapshot = build_digest(results, now.timestamp(), baseline_from(state))
    stability, first_seen_iso = stability_line(state, fingerprint, now, today)

    save_state(fingerprint, first_seen_iso, today, snapshot, now.isoformat())
    print(full_text + "\n" + stability)
    return 0


if __name__ == "__main__":
    sys.exit(main())
