{{ ansible_managed | comment }}
[Unit]
Description=Hermes Dashboard (authenticated interactive UI)
After=network-online.target hermes-gateway.service
Wants=network-online.target
# Bound the Restart=always loop below and page when the bound is hit; see the
# gateway unit for the full reasoning. StartLimit* must be in [Unit] — systemd
# 229+ ignores them in [Service], silently restoring the unbounded loop.
StartLimitIntervalSec={{ hermes_agent_unit_restart_interval_sec }}
StartLimitBurst={{ hermes_agent_unit_restart_burst }}
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
WorkingDirectory={{ hermes_agent_hermes_home }}
Environment=HERMES_HOME={{ hermes_agent_hermes_home }}
# Without this the server looks for the SPA next to the INSTALLED package (in
# site-packages), which the git-checkout install path never populates, and / then
# returns {"error":"Frontend not built"} while /api/* stays healthy. Points at the
# checkout's build output — the same path `hermes update` keeps rebuilding.
Environment=HERMES_WEB_DIST={{ hermes_agent_web_dist }}
EnvironmentFile=-{{ hermes_agent_hermes_home }}/.env
ExecStart={{ hermes_agent_bin }} dashboard --host {{ hermes_agent_dashboard_host }} --port {{ hermes_agent_dashboard_port }} --no-open
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
