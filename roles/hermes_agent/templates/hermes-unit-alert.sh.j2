#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Fired by OnFailure= of a long-running Hermes unit, but pages only when
# systemd reports Result=start-limit-hit. Empty or failed queries stay fail-open.
# With no start-rate limit, a config-broken unit looped every few seconds
# forever with no signal at all.
#
# Runs as root with no dependency on the hermes user, $HERMES_HOME, or .env,
# deliberately independent of the stack that just broke — same reasoning as
# hermes-brain-watchdog-alert.sh, so a broken environment cannot also silence
# the alert about itself.
set -uo pipefail

UNIT="${1:-unknown}"
RESULT="$(systemctl show --property=Result --value "${UNIT}" 2>/dev/null || true)"
[[ -z "${RESULT}" || "${RESULT}" == "start-limit-hit" ]] || exit 0
NTFY_URL="{{ hermes_agent_brain_watchdog_ntfy_url }}"
NTFY_TOKEN="{{ hermes_agent_ntfy_publish_token }}"
HOST="$(hostname)"
MSG=":rotating_light: ${UNIT} failed on ${HOST} and systemd has STOPPED restarting it (start-rate limit hit). It is down until manually reset: systemctl reset-failed ${UNIT} && systemctl start ${UNIT}. journalctl -u ${UNIT} for the cause."

logger -t hermes-unit-alert "${MSG}"

[[ -n "${NTFY_URL}" ]] || exit 0
if [[ -n "${NTFY_TOKEN}" ]]; then
  curl -fsS --max-time 8 -H "Title: ${UNIT} stopped restarting" -H "Priority: urgent" \
    -H "Tags: rotating_light,skull" -H "Authorization: Bearer ${NTFY_TOKEN}" \
    -d "${MSG}" "${NTFY_URL}" > /dev/null 2>&1 || true
else
  curl -fsS --max-time 8 -H "Title: ${UNIT} stopped restarting" -H "Priority: urgent" \
    -H "Tags: rotating_light,skull" -d "${MSG}" "${NTFY_URL}" > /dev/null 2>&1 || true
fi
exit 0
