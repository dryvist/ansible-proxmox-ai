{% set _api_server_on = hermes_agent_api_server_key | length > 0 %}
{% set _a2a_inbound_on = hermes_agent_a2a_inbound_enabled | bool %}
{% set _a2a_served = hermes_agent_profiles | default([]) | selectattr('a2a', 'defined') | list %}
{% set _profile_channels = hermes_agent_slack_profile_channels
     if hermes_agent_slack_profile_channels is defined and hermes_agent_slack_profile_channels is mapping else {} %}
{% set _profile_routes_on = _profile_channels | length > 0 %}
{% set _profile_api_routes_on = hermes_agent_profiles | default([])
     | selectattr('locked', 'defined') | selectattr('locked') | list | length > 0 %}
{% if _api_server_on or _a2a_inbound_on or _profile_routes_on or _profile_api_routes_on %}
{% if _api_server_on %}
# Inbound job-submission API queue hardening. The platform itself is enabled by
# key presence via the .env bridge (API_SERVER_* in hermes-env.j2); this caps
# in-flight agent runs across all its agent-serving endpoints. Over-cap
# submissions are refused up front (429 + Retry-After) instead of stacking
# prefills on the single shared serving deployment — see defaults/main.yml
# for the measured-envelope rationale behind the value.
{% endif %}
gateway:
{% if _api_server_on %}
  api_server:
    max_concurrent_runs: {{ hermes_agent_api_max_concurrent_runs }}
{% endif %}
{% if _a2a_inbound_on %}
  platforms:
    a2a:
      enabled: true
      extra:
        port: {{ hermes_agent_a2a_inbound_port }}
{% if _a2a_served | length > 0 %}
        # Named profiles that declare `a2a`, served under /<profile> on this listener.
        agents:
{% for _profile in _a2a_served %}
          {{ _profile.name | to_json }}:
            profile: {{ _profile.name | to_json }}
            name: {{ (_profile.a2a.name | default('Hermes ' ~ _profile.name)) | to_json }}
            description: {{ (_profile.a2a.description | default(_profile.description)) | to_json }}
            advertised_toolsets: {{ _profile.a2a.advertised_toolsets | default([]) | to_json }}
{% endfor %}
{% endif %}
{% endif %}
{% if _profile_api_routes_on and not _profile_routes_on %}
  multiplex_profiles: true
{% endif %}
{% if _profile_routes_on %}
  # Named-profile Slack routes: 152-profile-slack-routes.yml.
  multiplex_profiles: true
  profile_routes:
{% for profile, value in _profile_channels | dictsort %}
{% for channel in ([value] if value is string else (value | list)) %}
    - name: {{ (profile ~ ('-reports' if loop.first else '-reports-' ~ loop.index)) | to_json }}
      platform: slack
      chat_id: {{ channel | string | to_json }}
      profile: {{ profile | to_json }}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
