# Shared Hermes 0.23 browser_exec settings for the gateway and named profiles.
# No cloud provider is selected; sessions use the apt-managed Chromium.
browser:
  headed: false
  inactivity_timeout: {{ hermes_agent_browser_inactivity_timeout }}
  auto_local_for_private_urls: {{ hermes_agent_browser_auto_local_for_private_urls | to_json }}
  executable_path: {{ hermes_agent_chromium_executable | to_json }}
  chromium_args: {{ hermes_agent_browser_args | to_json }}
