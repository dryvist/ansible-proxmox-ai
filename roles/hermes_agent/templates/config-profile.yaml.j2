{{ ansible_managed | comment }}
# Hermes Agent profile config: {{ hermes_agent_profile.name }} — {{ hermes_agent_profile.description }}
# A named operating profile (see hermes_agent_profiles in defaults/main.yml).
# Scoped subset of the default profile's config.yaml: same brain/agent/session
# floor, but NO dashboard, NO platforms, NO platform_toolsets, and only the
# mcp_servers this profile is scoped to reach.

model:
  provider: custom
  default: {{ hermes_agent_model }}
  base_url: '{{ hermes_agent_model_base_url }}'
  api_mode: {{ hermes_agent_model_api_mode }}
  context_length: {{ hermes_agent_model_context_length }}
  max_tokens: {{ hermes_agent_model_max_tokens }}
  api_key: '${HERMES_AGENT_MODEL_API_KEY}'

memory:
  provider: {{ hermes_agent_memory_provider }}
  memory_enabled: true
  user_profile_enabled: true

logging:
  level: {{ hermes_agent_log_level }}

agent:
  max_turns: {{ hermes_agent_max_turns }}
  api_max_retries: 2
  tool_use_enforcement: auto
  # H-17 global deny floor — same list every profile inherits; see
  # hermes_agent_disabled_toolsets in defaults/main.yml for the rationale.
  disabled_toolsets: {{ hermes_agent_disabled_toolsets | to_json }}

terminal:
  backend: local
  timeout: 180

# Same pin as the default profile's config.yaml: profiles carry no
# platform_toolsets, so a spawned worker gets the web toolset by upstream
# default — without the pin its backend rides the key/env auto-detect cascade,
# which a stray provider key would silently redirect. ddgs is installed once
# into the shared venv (tasks/main.yml).
web:
  backend: ddgs
{% if hermes_agent_firecrawl_enabled | bool %}
  extract_backend: firecrawl
{% endif %}

# Same reasoning as the gateway config: no cloud_provider, so the browser tools
# run locally against the apt Chromium; and allow_private_urls on, because a
# worker that cannot reach the estate's own services can do none of the work
# these profiles exist for.
browser:
  headed: false
  record_sessions: false
  allow_private_urls: true

display:
  streaming: false
  tool_progress: all

security:
  redact_secrets: true
  tirith_enabled: true

compression:
  enabled: {{ hermes_agent_context_compression_enabled | to_json }}
  threshold: {{ hermes_agent_context_compression_threshold }}
  summary_model: {{ hermes_agent_compression_model }}

{% if hermes_agent_kanban_goal_mode | bool %}
# A card assigned to this profile is judged from ITS OWN config.yaml (the
# spawned worker reads the assignee's HERMES_HOME) — this block must exist
# here too, identical to the default profile's, or goal-mode completion
# judging fails for any card this profile owns.
#
# INTENT vs REALITY. This comment used to open "Every seeded recurring card
# runs goal_mode=true". That is the design intent, and the code does not
# implement it: upstream's `--goal` is opt-in (`action="store_true"`, default
# False), and NO card-creation path in this role passes it — the Vikunja
# bridge's `hermes kanban create` sends title, body, idempotency key,
# max-runtime, max-retries and an optional assignee, and nothing else creates
# cards. `hermes_agent_kanban_goal_mode` only gates whether this auxiliary
# block is rendered; it never reaches a card. So goal_mode is off for every
# card this role seeds, and both judge paths (the completion gate and the goal
# loop) are unreachable unless a card is created with `--goal` /
# `goal_mode=True` from outside the role.
#
# Closing the gap is a live behavior change, not a doc fix: goal mode adds up
# to hermes_agent_kanban_goal_max_turns extra worker conversations per card
# against a serving tier that admits one request at a time, so it is an
# operator decision. Left open deliberately; this block stays because it is
# what makes goal-mode judging work the moment a goal card does exist.
auxiliary:
  transient_retries: 1
  goal_judge:
    provider: custom
    model: {{ hermes_agent_kanban_goal_judge_model | to_json }}
    base_url: '{{ hermes_agent_model_base_url }}'
    api_key: '${HERMES_AGENT_MODEL_API_KEY}'
    api_mode: {{ hermes_agent_model_api_mode }}
{% endif %}

session_reset:
  mode: both
  at_hour: {{ hermes_agent_session_reset_at_hour }}
  idle_minutes: {{ hermes_agent_session_reset_idle_minutes }}
  notify: true

plugins:
  enabled:
    - observability/otel

# Belt-and-braces (§5 of the profiles design): this profile has no gateway of
# its own, but if one were ever accidentally started against this HERMES_HOME
# it must never contend for the machine-global dispatcher lock — the DEFAULT
# gateway is the only dispatcher, and it spawns workers into this profile via
# `hermes -p {{ hermes_agent_profile.name }}`, not by running its own board here.
kanban:
  dispatch_in_gateway: false

{% set _mcp_splunk = ('splunk' in hermes_agent_profile.mcp) and (hermes_agent_splunk_mcp_enabled | bool) and (hermes_agent_splunk_mcp_url | length > 0) %}
{% set _mcp_docs = ('docs' in hermes_agent_profile.mcp) and (hermes_agent_docs_mcp_enabled | bool) %}
{% set _mcp_grep = ('grep' in hermes_agent_profile.mcp) and (hermes_agent_grep_mcp_enabled | bool) %}
{% set _mcp_vikunja = ('vikunja' in hermes_agent_profile.mcp) and (hermes_agent_vikunja_mcp_enabled | bool) %}
{% set _mcp_nautobot = ('nautobot' in hermes_agent_profile.mcp) and (hermes_agent_nautobot_mcp_enabled | bool) %}
{% if _mcp_splunk or _mcp_docs or _mcp_grep or _mcp_vikunja or _mcp_nautobot %}
# MCP servers this profile is scoped to reach. ${VARS} resolve from THIS
# profile's own .env at connect time — never the default profile's.
mcp_servers:
{% if _mcp_splunk %}
  splunk:
    timeout: {{ hermes_agent_mcp_tool_timeout_seconds }}
    url: "${SPLUNK_MCP_URL}"
    headers:
      Authorization: "Bearer ${SPLUNK_MCP_TOKEN}"
{% endif %}
{% if _mcp_docs %}
  docs:
    timeout: {{ hermes_agent_mcp_tool_timeout_seconds }}
    url: "{{ hermes_agent_docs_mcp_url }}"
{% endif %}
{% if _mcp_grep %}
  grep:
    timeout: {{ hermes_agent_mcp_tool_timeout_seconds }}
    url: "{{ hermes_agent_grep_mcp_url }}"
{% endif %}
{% if _mcp_vikunja %}
  vikunja:
    timeout: {{ hermes_agent_mcp_tool_timeout_seconds }}
    url: "{{ hermes_agent_vikunja_mcp_url }}"
{% endif %}
{% if _mcp_nautobot %}
  nautobot:
    timeout: {{ hermes_agent_mcp_tool_timeout_seconds }}
    url: "{{ hermes_agent_nautobot_mcp_url }}"
{% endif %}
{% endif %}
timezone: '{{ hermes_agent_timezone }}'
