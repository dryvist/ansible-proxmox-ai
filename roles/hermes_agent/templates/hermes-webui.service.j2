{{ ansible_managed | comment }}
[Unit]
Description=Hermes WebUI (nesquena/hermes-webui — agent loaded in-process)
After=network-online.target hermes-gateway.service
Wants=network-online.target
StartLimitIntervalSec={{ hermes_agent_unit_restart_interval_sec }}
StartLimitBurst={{ hermes_agent_unit_restart_burst }}
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
WorkingDirectory={{ hermes_agent_webui_install_dir }}
# This UI runs the agent IN-PROCESS from HERMES_HOME rather than calling the
# gateway over HTTP, so it must see exactly the same home the agent does or it
# operates on a different profile and session store than everything else here.
Environment=HERMES_HOME={{ hermes_agent_hermes_home }}
Environment=HERMES_WEBUI_PORT={{ hermes_agent_webui_port }}
Environment=HERMES_WEBUI_HOST={{ hermes_agent_webui_host }}
EnvironmentFile=-{{ hermes_agent_hermes_home }}/.env
# bootstrap.py is upstream's ONLY entrypoint — it resolves dependencies and
# then becomes the server. `--foreground` is the flag its own help text says to
# use "under launchd / systemd / supervisord": it os.execv's server.py in this
# process, so systemd supervises the real server rather than a launcher that
# exits. Without it bootstrap.py spawns a DETACHED child, which systemd cannot
# see, cannot stop, and which survives to answer requests after the unit has
# failed — a dead service that still returns 200.
#
# There is no `app.py` in this repo and never was; the previous ExecStart named
# one, so the unit crashlooped to its start limit on every guest.
#
# Port is positional. TimeoutStartSec is generous because a moved checkout
# installs dependencies inside this same process before the server binds.
ExecStart=/usr/bin/python3 {{ hermes_agent_webui_install_dir }}/bootstrap.py \
  --no-browser --foreground \
  --host {{ hermes_agent_webui_host }} {{ hermes_agent_webui_port | trim }}
TimeoutStartSec=600
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
