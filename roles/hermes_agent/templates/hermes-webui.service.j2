{{ ansible_managed | comment }}
[Unit]
Description=Hermes WebUI (nesquena/hermes-webui — agent loaded in-process)
After=network-online.target hermes-gateway.service
Wants=network-online.target
StartLimitIntervalSec={{ hermes_agent_unit_restart_interval_sec }}
StartLimitBurst={{ hermes_agent_unit_restart_burst }}
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
WorkingDirectory={{ hermes_agent_webui_install_dir }}
# This UI runs the agent IN-PROCESS from HERMES_HOME rather than calling the
# gateway over HTTP, so it must see exactly the same home the agent does or it
# operates on a different profile and session store than everything else here.
Environment=HERMES_HOME={{ hermes_agent_hermes_home }}
Environment=HERMES_WEBUI_PORT={{ hermes_agent_webui_port }}
Environment=HERMES_WEBUI_HOST={{ hermes_agent_webui_host }}
EnvironmentFile=-{{ hermes_agent_hermes_home }}/.env
ExecStart=/usr/bin/python3 {{ hermes_agent_webui_install_dir }}/app.py
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
