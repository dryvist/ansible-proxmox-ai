{% set _profile_a2a_on = (hermes_agent_a2a_delegation_enabled | default(false) | bool)
    and hermes_agent_profile.name != 'eval'
    and hermes_agent_profile.name in (hermes_agent_a2a_delegating_profiles | default([])) %}
# Named workers never inherit the default listener or its manually supplied peers.
A2A_BEARER_TOKEN=
A2A_HOST=
{% for peer in hermes_agent_a2a_peers | default([]) %}
{{ hermes_agent_env_prefix }}_A2A_PEER_{{ loop.index0 }}_TOKEN=
{% endfor %}
{% for peer in hermes_agent_a2a_authorized_peers | default([]) %}
{{ hermes_agent_env_prefix }}_PROFILE_A2A_PEER_{{ loop.index0 }}_TOKEN={{ peer.token if _profile_a2a_on else '' }}
{% endfor %}
