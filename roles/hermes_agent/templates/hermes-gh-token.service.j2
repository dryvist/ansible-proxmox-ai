{{ ansible_managed | comment }}
[Unit]
Description=Refresh Hermes GitHub installation tokens from OpenBao
After=network-online.target
Wants=network-online.target
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile={{ hermes_agent_github_identity_env_path }}
ExecStart=/usr/bin/python3 {{ hermes_agent_github_identity_helper_path }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
