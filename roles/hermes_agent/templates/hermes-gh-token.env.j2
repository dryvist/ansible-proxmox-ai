{{ ansible_managed | comment }}
# Root-only (0600) inputs for hermes-gh-token.service.
BAO_ADDR={{ hermes_agent_github_identity_bao_addr }}
{% for boundary, creds in hermes_agent_github_identity_approles.items() %}
HERMES_BAO_ROLE_ID_{{ boundary | upper }}={{ creds.role_id }}
HERMES_BAO_SECRET_ID_{{ boundary | upper }}={{ creds.secret_id }}
{% endfor %}
GH_TOKEN_MOUNT={{ hermes_agent_github_identity_mount }}
GH_TOKEN_SETS="{% for kind, by_b in hermes_agent_github_identity_sets.items() %}{% for b, name in by_b.items() %}{{ kind }}-{{ b }}={{ b }}:{{ name }} {% endfor %}{% endfor %}"
GH_TOKEN_DIR={{ hermes_agent_github_identity_token_dir }}
GH_TOKEN_OWNER={{ hermes_agent_user }}
