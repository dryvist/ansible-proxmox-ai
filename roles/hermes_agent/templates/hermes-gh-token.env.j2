{{ ansible_managed | comment }}
# Root-only (0600) inputs for hermes-gh-token.service.
BAO_ADDR={{ hermes_agent_github_identity_bao_addr }}
HERMES_BAO_ROLE_ID={{ hermes_agent_github_identity_role_id }}
HERMES_BAO_SECRET_ID={{ hermes_agent_github_identity_secret_id }}
GH_TOKEN_MOUNT={{ hermes_agent_github_identity_mount }}
GH_TOKEN_SETS={% for k, v in hermes_agent_github_identity_sets.items() %}{{ k }}={{ v }}{{ ' ' if not loop.last else '' }}{% endfor %}

GH_TOKEN_DIR={{ hermes_agent_github_identity_token_dir }}
GH_TOKEN_OWNER={{ hermes_agent_user }}
