{% set _profile_a2a_on = (hermes_agent_a2a_delegation_enabled | default(false) | bool)
    and hermes_agent_profile.name != 'eval'
    and hermes_agent_profile.name in (hermes_agent_a2a_delegating_profiles | default([])) %}
{% if _profile_a2a_on and hermes_agent_a2a_authorized_peers | length > 0 %}
a2a_agents:
{% for peer in hermes_agent_a2a_authorized_peers %}
  {{ peer.name | to_json }}:
    url: {{ peer.url | to_json }}
    auth:
      type: bearer
      token: {{ ('${' ~ hermes_agent_env_prefix ~ '_PROFILE_A2A_PEER_' ~ loop.index0 ~ '_TOKEN}') | to_json }}
{% endfor %}
{% endif %}
