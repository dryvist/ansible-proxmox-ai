{{ ansible_managed | comment }}
{% import 'config-context-limits.yaml.j2' as context_limits %}
# Hermes Agent config for the standalone github-public gateway
# (hermes_agent_github_public_gateway_*). Serves only the github-public webhook
# route: its own model, no memory, no chat platform, no MCP servers, and only the
# terminal and web toolsets.

model:
  provider: {{ hermes_agent_model_provider }}
  default: {{ hermes_agent_github_public_gateway_model }}
  base_url: '{{ hermes_agent_model_base_url }}'
  api_mode: {{ hermes_agent_model_api_mode }}
  context_length: {{ hermes_agent_model_context_length }}
  max_tokens: {{ hermes_agent_model_max_tokens }}
  api_key: '${HERMES_AGENT_MODEL_API_KEY}'

{{ context_limits.top_level(hermes_agent_context_limits) }}

# No memory provider and no built-in memory or user-profile store.
memory:
  memory_enabled: false
  user_profile_enabled: false
{{ context_limits.memory(hermes_agent_context_limits) }}

logging:
  level: {{ hermes_agent_log_level }}

agent:
  max_turns: {{ hermes_agent_max_turns }}
  api_max_retries: 2
  tool_use_enforcement: auto
  disabled_toolsets: {{ hermes_agent_disabled_toolsets | to_json }}
{{ context_limits.tool_output_tools_delegation(hermes_agent_context_limits) }}

platform_toolsets:
  webhook: {{ hermes_agent_github_route_toolsets | to_json }}

terminal:
  backend: local
  timeout: 180

web:
  backend: ddgs
{{ context_limits.web(hermes_agent_context_limits) }}

{% if 'proactive_prune_tokens' in hermes_agent_context_limits.get('compression', {}) %}
compression:
{{ context_limits.compression(hermes_agent_context_limits) }}
{% endif %}

security:
  redact_secrets: true
  tirith_enabled: true

# This gateway never dispatches the Kanban board.
kanban:
  dispatch_in_gateway: false

platforms:
  webhook:
    enabled: true
    extra:
      port: {{ hermes_agent_github_public_gateway_port }}
      routes:
{% import 'config-github-route.yaml.j2' as _gh with context %}
{{ _gh.github_route({'name': hermes_agent_github_route_public_name, 'private': false}) }}

timezone: '{{ hermes_agent_timezone }}'
