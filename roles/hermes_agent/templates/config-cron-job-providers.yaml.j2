{% set _telemetry = hermes_agent_direct_cron_telemetry | default({}) %}
custom_providers:
  - name: {{ hermes_agent_model_shared_provider_name | to_json }}
    base_url: '{{ hermes_agent_model_base_url }}'
    api_key: '${HERMES_AGENT_MODEL_API_KEY}'
{% if _telemetry is mapping %}
{% for _job in hermes_agent_direct_cron_jobs | default([]) if not (_job.no_agent | default(false) | bool) %}
  - name: {{ hermes_agent_direct_cron_telemetry[_job.name].provider | to_json }}
    base_url: '{{ hermes_agent_model_base_url }}'
    api_key: '${HERMES_AGENT_MODEL_API_KEY}'
    extra_body:
      metadata:
        hermes_job: {{ _job.name | to_json }}
{% endfor %}
{% endif %}
