{% if hermes_agent_langfuse_enabled | bool %}
# Langfuse content capture is fixed to sanitized.
HERMES_LANGFUSE_PUBLIC_KEY={{ hermes_agent_langfuse_public_key }}
HERMES_LANGFUSE_SECRET_KEY={{ hermes_agent_langfuse_secret_key }}
HERMES_LANGFUSE_BASE_URL={{ hermes_agent_langfuse_base_url }}
HERMES_LANGFUSE_CAPTURE=sanitized
HERMES_LANGFUSE_ENV=production
{% endif %}
