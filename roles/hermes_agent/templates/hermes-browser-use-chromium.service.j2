{{ ansible_managed | comment }}
[Unit]
Description=Loopback Chromium CDP endpoint for the Browser Use CLI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ hermes_agent_user }}
Group={{ hermes_agent_user }}
Environment=HOME={{ hermes_agent_home }}
ExecStart={{ hermes_agent_chromium_executable }} --headless --no-sandbox --disable-gpu --no-first-run --no-default-browser-check --remote-debugging-address=127.0.0.1 --remote-debugging-port={{ hermes_agent_browser_use_cdp_port }} --user-data-dir={{ hermes_agent_browser_use_home }}/chromium-profile about:blank
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
