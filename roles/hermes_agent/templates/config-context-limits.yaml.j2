{# Shared projections of the nix-hermes limits.json data. #}
{% macro top_level(limits) %}
{% if 'context_file_max_chars' in limits %}
context_file_max_chars: {{ limits.context_file_max_chars | to_json }}
{% endif %}
{% if 'file_read_max_chars' in limits %}
file_read_max_chars: {{ limits.file_read_max_chars | to_json }}
{% endif %}
{% endmacro %}

{% macro memory(limits) %}
{% if 'memory_char_limit' in limits.get('memory', {}) %}
  memory_char_limit: {{ limits.memory.memory_char_limit | to_json }}
{% endif %}
{% if 'user_char_limit' in limits.get('memory', {}) %}
  user_char_limit: {{ limits.memory.user_char_limit | to_json }}
{% endif %}
{% endmacro %}

{% macro tool_output_tools_delegation(limits) %}
{% set _tool_output = limits.get('tool_output', {}) %}
{% if 'max_bytes' in _tool_output or 'max_lines' in _tool_output or 'max_line_length' in _tool_output %}
tool_output:
{% if 'max_bytes' in _tool_output %}
  max_bytes: {{ _tool_output.max_bytes | to_json }}
{% endif %}
{% if 'max_lines' in _tool_output %}
  max_lines: {{ _tool_output.max_lines | to_json }}
{% endif %}
{% if 'max_line_length' in _tool_output %}
  max_line_length: {{ _tool_output.max_line_length | to_json }}
{% endif %}
{% endif %}
{% set _tool_search = limits.get('tools', {}).get('tool_search', {}) %}
{% if 'listing_max_tokens' in _tool_search or 'defer' in _tool_search %}
tools:
  tool_search:
{% if 'listing_max_tokens' in _tool_search %}
    listing_max_tokens: {{ _tool_search.listing_max_tokens | to_json }}
{% endif %}
{% if 'defer' in _tool_search %}
    defer: {{ _tool_search.defer | to_json }}
{% endif %}
{% endif %}
{% if 'max_summary_chars' in limits.get('delegation', {}) %}
delegation:
  max_summary_chars: {{ limits.delegation.max_summary_chars | to_json }}
{% endif %}
{% endmacro %}

{% macro web(limits) %}
{% if 'extract_char_limit' in limits.get('web', {}) %}
  extract_char_limit: {{ limits.web.extract_char_limit | to_json }}
{% endif %}
{% endmacro %}

{% macro compression(limits) %}
{% if 'proactive_prune_tokens' in limits.get('compression', {}) %}
  proactive_prune_tokens: {{ limits.compression.proactive_prune_tokens | to_json }}
{% endif %}
{% endmacro %}
