#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Hermes brain-health watchdog. Rendered by the hermes_agent role and run on a
# systemd timer (every {{ hermes_agent_brain_watchdog_interval }}) as the hermes
# user. It exists because Hermes cron runs are stateless and upstream ALWAYS
# delivers a failure notification ("Failed jobs always deliver regardless of the
# [SILENT] marker") — so when the single-deployment brain (ai_default_model) is
# unreachable, every seeded cron fires, 500s, and DMs the operator, twice an hour
# per job, with nobody getting one clean "the brain is down" signal.
#
# Fix: probe the brain end-to-end; on a DEBOUNCED transition, `hermes cron
# pause`/`resume` the role-seeded fleet and alert EXACTLY ONCE per edge (Slack DM
# + urgent ntfy). Paused jobs don't fire, so a brain outage stops producing spam
# instead of amplifying it. Pausing loses no coverage a run would otherwise
# achieve — the brain is down either way — it just makes the gap visible once.
set -uo pipefail

# --- Rendered config ---------------------------------------------------------
HERMES_BIN="{{ hermes_agent_bin }}"
# Probe the ROUTER ALIAS the agent itself requests, not a physical model id.
# The alias resolves to whatever the brain currently is, so it tracks a
# brain-sync repoint for free — which is what reading the state file was for.
# Reading that file instead made the watchdog monitor a backend the agent had
# stopped using: it would report healthy while the real brain was wedged, and
# 404 (pausing the whole cron fleet) if that physical id ever stopped
# resolving. Same variable the agent uses, so the two cannot diverge.
MODEL="{{ hermes_agent_model }}"
BASE_URL="{{ hermes_agent_model_base_url }}"
PROBE_URL="${BASE_URL}/chat/completions"
PROBE_TIMEOUT="{{ hermes_agent_brain_watchdog_probe_timeout }}"
DOWN_AFTER="{{ hermes_agent_brain_watchdog_down_after }}"
UP_AFTER="{{ hermes_agent_brain_watchdog_up_after }}"
# Consecutive busy (429 / probe-deadline) probes tolerated before a saturated
# brain is escalated to DOWN. Keeps "busy" from becoming a permanent mute.
BUSY_GRACE_PROBES="{{ hermes_agent_brain_watchdog_busy_grace_probes }}"
# 1 = converge a paused fleet back to running whenever the brain is healthy.
RECONCILE_PAUSED="{{ 1 if hermes_agent_brain_watchdog_reconcile_paused else 0 }}"
NTFY_URL="{{ hermes_agent_brain_watchdog_ntfy_url }}"
# External deadman OK-ping target (silent-Mac / LXC-down backstop). Full ping URL
# from the environment; empty = no-op. See defaults + hc_ping below.
HEALTHCHECK_URL="{{ hermes_agent_brain_watchdog_healthcheck_url }}"
STATE_DIR="{{ hermes_agent_hermes_home }}/brain-watchdog"
# Flap coalescing: once a down/up cycle completes cleanly, further edges
# within this many seconds are coalesced (counted, window extended) instead of
# each firing its own alert. See "Flap coalescing" below.
FLAP_COOLDOWN_SECONDS="{{ hermes_agent_brain_watchdog_flap_cooldown_seconds }}"
# Sustained-flap escalation: fire ONE loud page while STILL flapping once the
# episode crosses either threshold, then re-arm (see "Sustained-flap" below).
SUSTAINED_FLAP_THRESHOLD="{{ hermes_agent_brain_watchdog_sustained_flap_threshold }}"
SUSTAINED_FLAP_SECONDS="{{ hermes_agent_brain_watchdog_sustained_flap_seconds }}"
SUSTAINED_FLAP_REARM="{{ hermes_agent_brain_watchdog_sustained_flap_rearm_seconds }}"
# Rendered at template time (the seeded list is static) so the script avoids
# bash's array-length parameter form, whose brace-hash opener would be misread as
# a Jinja comment start in this .j2 and mangle the template.
JOB_COUNT="{{ hermes_agent_cluster_pause_cron_names | length }}"

# Brain-dependent cron fleet — the only jobs this watchdog touches (never
# user/agent-created jobs). The SAME list a cluster window pauses, not the
# narrower seeded list: `hermes_agent_seeded_cron_names` covers only the
# script-fed `<job>-enqueue` crons, which do not call the brain, while the
# enabled `*-v2` jobs that DO call it were absent — so a brain outage paused a
# fleet of enqueuers and left every brain-dependent job firing. One list for
# both pause paths, derived in defaults, so they cannot drift apart again.
SEEDED_JOBS=(
{% for job in hermes_agent_cluster_pause_cron_names %}
  "{{ job }}"
{% endfor %}
)

# Secrets arrive via the systemd unit's EnvironmentFile (the same $HERMES_HOME/.env
# the gateway loads): HERMES_AGENT_MODEL_API_KEY (probe auth), SLACK_BOT_TOKEN +
# SLACK_ALLOWED_USERS (DM alert). Defaulted empty so `set -u` is safe when unset.
API_KEY="${HERMES_AGENT_MODEL_API_KEY:-}"
SLACK_TOKEN="${SLACK_BOT_TOKEN:-}"
SLACK_USER="${SLACK_ALLOWED_USERS:-}"
# Channel for brain up/down transitions. The brain being unreachable is Hermes
# itself not working, so this belongs in the issues channel rather than only in
# a DM, where it is invisible to anyone reading the channels. Same knob name and
# fallback order fabric_watchdog already uses. Empty keeps the DM-only path.
SLACK_ALERT_CHANNEL="${SLACK_ALERT_CHANNEL:-}"

# --- Probe: a tiny real completion, mirroring what the crons actually do ------
# THREE states, not two: up | busy | down. Busy is the one that matters — see
# "Saturation is not an outage" below.
#
# Healthy iff HTTP 200 AND the body carries a real finish_reason. HTTP code
# alone is NOT health: when the MLX engine's batch scheduler wedges (2026-07-16
# broadcast_shapes incident) every completion returns HTTP 200 with
# `"finish_reason":"error"` and zero tokens — the code-only probe stayed green
# for hours while every cron failed. A connection error, a 5xx, an auth 4xx, or
# a 200-wrapped error body all read as DOWN — the same failures that fail a cron.
#
# SATURATION IS NOT AN OUTAGE. The serving host admits one request at a time
# (proxy.concurrencyLimit) and rejects the rest with an instant 429 — measured
# at 18.8us, i.e. a live server declining work, not a dead one. Over 2026-08-01
# .. 08-05, 57% of all gate requests were 429 and the watchdog counted every one
# of them as DOWN, so ordinary contention paused the whole cron fleet and paged.
# Meanwhile the REAL work path tolerates exactly this for ~320s
# (llm_router rate_limit_retries x retry_after), so the watchdog was declaring
# outages in conditions where every job it protects succeeds. That asymmetry —
# not the 429 — was the defect. Same classification the MLX-side watchdog
# already uses (nix-ai modules/mlx/mlx-watchdog.sh: `429 -> busy`).
#
# curl rc 28 (our own deadline) is ALSO busy, and is in fact the common case:
# the router sleeps retry_after between rate-limit retries, so a saturated brain
# usually starves the probe of a reply rather than handing it a 429. Every other
# curl failure (7 refused, 6 DNS, 35 TLS) is a genuine reachability fault.
#
# Busy is NOT free: it holds state rather than clearing it, and the caller
# escalates a sustained busy run to DOWN (BUSY_GRACE_PROBES) — a brain that
# cannot serve one 1-token probe for that long is failing real work too.
# ponytail: grep on the body, no jq and no temp file on the guest.
probe_state() {
  local response code body rc
  # Body and status code in one call: -w appends the code on its own line
  # after the body, so no temp file is needed on this cadence.
  # max_tokens 1 = the cheapest reply that still proves completion_tokens >= 1;
  # it finishes on "length", which the finish_reason set below accepts.
  response="$(curl -sS -w '\n%{http_code}' --max-time "${PROBE_TIMEOUT}" \
    -X POST "${PROBE_URL}" \
    -H "Authorization: Bearer ${API_KEY}" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"${MODEL}\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}]}" \
    2>/dev/null)"
  rc=$?
  if (( rc != 0 )); then
    (( rc == 28 )) && { printf 'busy'; return; }
    printf 'down'; return
  fi
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  # The gate answered and declined work: proof of life. Never an outage.
  [[ "${code}" == "429" ]] && { printf 'busy'; return; }
  # stop|length|tool_calls = the model really generated; "error" (or a body
  # with no finish_reason at all) = broken regardless of the 200. The
  # finish_reason check alone is not enough: LiteLLM can remap an upstream
  # finish_reason "error" to "stop" (core_helpers "Unmapped finish_reason
  # 'error', defaulting to 'stop'", seen live 2026-07-16), so also require
  # completion_tokens >= 1 — a wedged engine always reports 0.
  if [[ "${code}" == "200" ]] \
    && grep -Eq '"finish_reason"[[:space:]]*:[[:space:]]*"(stop|length|tool_calls)"' <<< "${body}" \
    && grep -Eq '"completion_tokens"[[:space:]]*:[[:space:]]*[1-9]' <<< "${body}"; then
    printf 'up'; return
  fi
  printf 'down'
}

# --- Cron fleet control (best-effort; idempotent) ----------------------------
# HERMES_HOME comes from the unit's Environment=. Track command outcomes so
# recovery alerts cannot claim the static desired-job count as a live result.
CRON_SUCCEEDED=0
CRON_FAILED=0
# Assert what was DONE, never what was RUN. `hermes cron pause <missing>` prints
# "Job ... not found" and still exits 0, so a return code cannot tell "paused it"
# from "there is no such job". Trusting it let this loop count a name that no
# longer exists as a pause: 8 of the 21 seeded names have no job behind them, so
# every alert claimed 21 pauses over a fleet of 13. Read the state back off the
# board instead — a job missing from it, or in the wrong state, is a FAILURE,
# which is what surfaces a list that has drifted from the live fleet.
#
# --all is REQUIRED: a bare `cron list` omits paused jobs entirely, so without it
# a pause could never be confirmed (and, worse, a paused job would be
# indistinguishable from a deleted one).
cron_do() {
  local verb="$1" job want board
  CRON_SUCCEEDED=0
  CRON_FAILED=0
  if [[ "${verb}" == "pause" ]]; then want="paused"; else want="active"; fi
  for job in "${SEEDED_JOBS[@]}"; do
    "${HERMES_BIN}" cron "${verb}" "${job}" >/dev/null 2>&1 || true
  done
  board="$("${HERMES_BIN}" cron list --all 2>/dev/null)"
  for job in "${SEEDED_JOBS[@]}"; do
    # `cron list` prints the state on the id line, one line ABOVE its Name line.
    if grep -B1 -E "^ *Name: +${job}\$" <<< "${board}" | grep -q "\[${want}\]"; then
      CRON_SUCCEEDED=$(( CRON_SUCCEEDED + 1 ))
      logger -t hermes-brain-watchdog "${verb}d ${job}"
    else
      CRON_FAILED=$(( CRON_FAILED + 1 ))
      logger -t hermes-brain-watchdog "${verb} FAILED (missing from board or not ${want}): ${job}"
    fi
  done
}

# --- Alerting: one Slack DM + one urgent ntfy per transition -----------------
# Messages are kept JSON-safe (no double quotes / backslashes) so the Slack body
# can be built with printf — the guest has no jq, and adding one for two strings
# is not worth a dependency (ponytail).
slack_post() {
  local text="$1" channel
  # Channel wins when set; else the first member id, i.e. channel=<user id> DMs
  # them. Requires a token either way, but only requires SLACK_USER when there
  # is no channel to fall back from.
  channel="${SLACK_ALERT_CHANNEL:-${SLACK_USER%%,*}}"
  [[ -n "${SLACK_TOKEN}" && -n "${channel}" ]] || return 0
  curl -fsS --max-time 10 -X POST https://slack.com/api/chat.postMessage \
    -H "Authorization: Bearer ${SLACK_TOKEN}" \
    -H "Content-Type: application/json; charset=utf-8" \
    --data "$(printf '{"channel":"%s","text":"%s"}' "${channel}" "${text}")" \
    >/dev/null 2>&1 || true
}

ntfy_push() {
  local kind="$1" text="$2" prio tags title
  [[ -n "${NTFY_URL}" ]] || return 0
  if [[ "${kind}" == "down" ]]; then
    prio="urgent"; tags="rotating_light"; title="{{ hermes_agent_id }} brain down"
  else
    prio="default"; tags="white_check_mark"; title="{{ hermes_agent_id }} brain recovered"
  fi
  curl -fsS --max-time 8 -H "Title: ${title}" -H "Priority: ${prio}" \
    -H "Tags: ${tags}" -d "${text}" "${NTFY_URL}" >/dev/null 2>&1 || true
}

# --- External deadman OK-ping ------------------------------------------------
# The ntfy + Slack paths above only page on a DETECTED brain outage, and they run
# ON this LXC: a powered-off LXC, a masked timer, or a wedged systemd silences
# them with no page. So every healthy probe pings an external healthchecks-style
# deadman. When the ping STOPS — this host gone, timer dead, or the brain
# unreachable (which includes a silent Mac serving host) — the external service
# pages on its own. Empty URL = no-op. ponytail: OK-ping only, no /fail; a
# detected-down is already paged by ntfy/Slack, and the deadman exists for the
# SILENT/absence case those pages structurally cannot cover.
hc_ping() {
  [[ -n "${HEALTHCHECK_URL}" ]] || return 0
  curl -fsS --max-time 8 "${HEALTHCHECK_URL}" >/dev/null 2>&1 || true
}

alert() {
  local kind="$1" msg now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "${kind}" == "down" ]]; then
    msg=":warning: {{ hermes_agent_display_name }} brain unreachable (${MODEL} via ${BASE_URL}) since ${now} -- pause verified succeeded=${CRON_SUCCEEDED} failed=${CRON_FAILED} desired=${JOB_COUNT}; this does not verify Kanban queue health."
  else
    msg=":white_check_mark: {{ hermes_agent_display_name }} brain recovered at ${now} -- resume verified succeeded=${CRON_SUCCEEDED} failed=${CRON_FAILED} desired=${JOB_COUNT}; Slack delivery still requires queue verification."
  fi
  logger -t hermes-brain-watchdog "${msg}"
  slack_post "${msg}"
  ntfy_push "${kind}" "${msg}"
}

# --- Flap coalescing: one summary instead of dozens of up/down DM pairs ------
# The debounce above rides brief bounces, but a genuinely UNSTABLE backend
# (rotation flapping for hours) still produces one clean alert per edge --
# confirmed live as dozens of DM pairs over 31h. Fix: the first down/up cycle
# alerts normally (unchanged UX for the common case), and completing it opens
# a cooldown window. Any further edge inside that window is coalesced (counted,
# window extended) instead of alerting; once the window finally elapses with
# the brain stable, one summary covers everything that was coalesced.
FLAP_COOLDOWN_FILE="${STATE_DIR}/flap_cooldown_until"
FLAP_COUNT_FILE="${STATE_DIR}/flap_count"
FLAP_SINCE_FILE="${STATE_DIR}/flap_since"
FLAP_SINCE_EPOCH_FILE="${STATE_DIR}/flap_since_epoch"
SUSTAINED_REARM_FILE="${STATE_DIR}/sustained_rearm_until"

# --- Sustained-flap escalation -----------------------------------------------
# The coalescer only emits a summary on STABILIZE (flap_summary_check). A wedge
# that flaps for hours never stabilizes -> the summary never fires and the
# instability is SILENT (INC-17083: 15 flaps over ~2.5h, zero operator alert).
# This fires ONE loud page WHILE STILL FLAPPING once the episode crosses either
# threshold, then re-arms for SUSTAINED_FLAP_REARM so a long wedge pages at most
# hourly (not per-flap). The coalescer's Splunk-visible edge logging is
# unchanged. Disabled when SUSTAINED_FLAP_THRESHOLD is 0.
maybe_escalate_sustained_flap() {
  local flap_count="$1" now_epoch rearm_until since_epoch elapsed mins msg
  (( SUSTAINED_FLAP_THRESHOLD > 0 )) || return 0
  now_epoch="$(date -u +%s)"
  rearm_until="$(cat "${SUSTAINED_REARM_FILE}" 2>/dev/null || echo 0)"
  [[ "${rearm_until}" =~ ^[0-9]+$ ]] || rearm_until=0
  (( now_epoch < rearm_until )) && return 0   # already paged this window
  since_epoch="$(cat "${FLAP_SINCE_EPOCH_FILE}" 2>/dev/null || echo "${now_epoch}")"
  [[ "${since_epoch}" =~ ^[0-9]+$ ]] || since_epoch="${now_epoch}"
  elapsed=$(( now_epoch - since_epoch ))
  if (( flap_count >= SUSTAINED_FLAP_THRESHOLD )) || (( elapsed >= SUSTAINED_FLAP_SECONDS )); then
    mins=$(( elapsed / 60 ))
    msg=":rotating_light: {{ hermes_agent_display_name }} brain UNSTABLE for ~${mins} min and still flapping (${flap_count} coalesced flaps) -- ${MODEL} via ${BASE_URL}. Seeded crons pause during down phases but resume into brief-recovery windows; probable serving-stack wedge, needs operator attention (INC-17083 class)."
    logger -t hermes-brain-watchdog "${msg}"
    slack_post "${msg}"
    ntfy_push down "${msg}"
    printf '%s\n' "$(( now_epoch + SUSTAINED_FLAP_REARM ))" > "${SUSTAINED_REARM_FILE}"
  fi
}

handle_edge() {
  local kind="$1" now_epoch cooldown_until flap_count
  now_epoch="$(date -u +%s)"
  cooldown_until="$(cat "${FLAP_COOLDOWN_FILE}" 2>/dev/null || echo 0)"
  [[ "${cooldown_until}" =~ ^[0-9]+$ ]] || cooldown_until=0
  if (( now_epoch < cooldown_until )); then
    # Inside an active cooldown from a just-completed cycle: coalesce this
    # edge silently -- count it and extend the window.
    flap_count="$(cat "${FLAP_COUNT_FILE}" 2>/dev/null || echo 0)"
    [[ "${flap_count}" =~ ^[0-9]+$ ]] || flap_count=0
    flap_count=$(( flap_count + 1 ))
    printf '%s\n' "${flap_count}" > "${FLAP_COUNT_FILE}"
    printf '%s\n' "$(( now_epoch + FLAP_COOLDOWN_SECONDS ))" > "${FLAP_COOLDOWN_FILE}"
    logger -t hermes-brain-watchdog "coalesced ${kind} edge during cooldown (flap #${flap_count})"
    # Break the silence on a genuinely sustained (never-stabilizing) flap.
    maybe_escalate_sustained_flap "${flap_count}"
  else
    # No active cooldown: either the very first down of a fresh episode, or
    # the up that completes a cycle -- both alert normally.
    alert "${kind}"
    if [[ "${kind}" == "up" ]]; then
      # A down->up cycle just completed cleanly. Open the cooldown window so
      # near-term flapping gets coalesced instead of spamming.
      printf '%s\n' "$(( now_epoch + FLAP_COOLDOWN_SECONDS ))" > "${FLAP_COOLDOWN_FILE}"
      printf '0\n' > "${FLAP_COUNT_FILE}"
      printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${FLAP_SINCE_FILE}"
      # Fresh episode: stamp its epoch start and re-arm sustained escalation so
      # a NEW instability can page again (independent of a prior episode's page).
      printf '%s\n' "${now_epoch}" > "${FLAP_SINCE_EPOCH_FILE}"
      rm -f "${SUSTAINED_REARM_FILE}"
    fi
  fi
}

# Runs every invocation (not just on a transition): once a cooldown window
# elapses with the brain stable, report anything that was coalesced during it
# in ONE summary, then clear the episode. A clean single cycle (nothing
# coalesced) clears silently -- its two normal alerts already told the story.
flap_summary_check() {
  local cooldown_until now_epoch flap_count since msg
  cooldown_until="$(cat "${FLAP_COOLDOWN_FILE}" 2>/dev/null || echo 0)"
  [[ "${cooldown_until}" =~ ^[0-9]+$ ]] || cooldown_until=0
  (( cooldown_until > 0 )) || return 0
  now_epoch="$(date -u +%s)"
  (( now_epoch >= cooldown_until )) || return 0
  # An episode ends when the brain is UP, not when a timer expires. While it is
  # still down the episode is open: extend the window and keep every gate armed.
  # Clearing here instead (the prior behaviour) reset the cooldown, the flap
  # count and the sustained-page re-arm mid-outage, so the next edge was no
  # longer inside a cooldown and alerted as a fresh outage -- one down + one up
  # message per flap cycle, for as long as the wedge lasted, which is exactly
  # the spam the coalescer exists to prevent.
  if [[ "${state}" != "up" ]]; then
    printf '%s\n' "$(( now_epoch + FLAP_COOLDOWN_SECONDS ))" > "${FLAP_COOLDOWN_FILE}"
    return 0
  fi
  flap_count="$(cat "${FLAP_COUNT_FILE}" 2>/dev/null || echo 0)"
  [[ "${flap_count}" =~ ^[0-9]+$ ]] || flap_count=0
  if (( flap_count > 0 )); then
    since="$(cat "${FLAP_SINCE_FILE}" 2>/dev/null || echo unknown)"
    msg=":large_yellow_circle: {{ hermes_agent_display_name }} brain was unstable since ${since} (${flap_count} additional flap(s) after the initial recovery) -- stabilized at $(date -u +%Y-%m-%dT%H:%M:%SZ)."
    logger -t hermes-brain-watchdog "${msg}"
    slack_post "${msg}"
    ntfy_push up "${msg}"
  fi
  rm -f "${FLAP_COOLDOWN_FILE}" "${FLAP_COUNT_FILE}" "${FLAP_SINCE_FILE}" \
        "${FLAP_SINCE_EPOCH_FILE}" "${SUSTAINED_REARM_FILE}"
}

# --- Reconcile the fleet to "running" whenever the brain is healthy -----------
# Edge-triggered resume alone is not enough, because the pause and the state
# write are SEPARATE operations in the DOWN branch below:
#
#     cron_do pause            <- the fleet is paused here
#     handle_edge down
#     state="down"
#     ...
#     printf '%s\n' "${state}" > "${STATE_FILE}"   <- persisted only here
#
# Kill the process anywhere in that window (SIGKILL, OOM, host reset, container
# stop) and the fleet is paused while the persisted state still reads "up". The
# resume branch is gated on state == "down", so it can never fire: the fleet
# stays paused until a NEW outage happens to complete a full down->up cycle. If
# the brain never goes down again, it stays paused forever, silently, with every
# brain-dependent job simply not running.
#
# The same hole is reached by an entirely routine path: cluster-hermes-pause.yml
# pauses via ansible and never touches the state file at all.
#
# Converging to desired state repairs both without needing the write to be
# atomic. Deliberate maintenance pauses are NOT undone, because that playbook
# also stops this timer — no timer, no reconcile. That interlock is what makes
# this safe; if a future pause path leaves the timer running, it must set the
# state file too or this will fight it.
#
# Silent by design (logger only, no Slack/ntfy): this is repair, not an
# incident, and paging on it would re-create the noise this watchdog exists to
# suppress.
reconcile_fleet() {
  local board job stuck=0
  [[ "${RECONCILE_PAUSED}" == "1" ]] || return 0
  board="$("${HERMES_BIN}" cron list --all 2>/dev/null)" || return 0
  [[ -n "${board}" ]] || return 0
  for job in "${SEEDED_JOBS[@]}"; do
    if grep -B1 -E "^ *Name: +${job}\$" <<< "${board}" | grep -q "\[paused\]"; then
      stuck=$(( stuck + 1 ))
    fi
  done
  (( stuck > 0 )) || return 0
  logger -t hermes-brain-watchdog \
    "reconcile: ${stuck} seeded job(s) paused while the brain is healthy and state=up; resuming"
  cron_do resume
  logger -t hermes-brain-watchdog \
    "reconcile: resumed ${CRON_SUCCEEDED}, failed ${CRON_FAILED}"
}

# --- Debounced state machine -------------------------------------------------
# state: up|down (default up so a fresh start never emits a spurious recovery).
# streak: signed run of consecutive same-result probes (+ok / -fail). A DOWN edge
# needs DOWN_AFTER consecutive fails, an UP edge UP_AFTER consecutive oks — this
# rides brief bounces (rotation flips, cold reloads) so the watchdog never becomes
# a new source of spam.
#
# The resume is RECONCILED, not only edge-triggered — see reconcile_fleet below.
# This comment used to claim "the next real down->up cycle or a converge
# re-resumes"; the second half was FALSE. There is no `hermes cron resume`
# anywhere in this role's tasks (only two comments mention the word), so a
# converge never un-paused anything.
mkdir -p "${STATE_DIR}"
STATE_FILE="${STATE_DIR}/state"
STREAK_FILE="${STATE_DIR}/streak"
state="$(cat "${STATE_FILE}" 2>/dev/null || echo up)"
[[ -n "${state}" ]] || state=up
streak="$(cat "${STREAK_FILE}" 2>/dev/null || echo 0)"
[[ "${streak}" =~ ^-?[0-9]+$ ]] || streak=0
# Consecutive busy (429 / probe-deadline) probes. Separate from `streak` so
# contention neither trips a DOWN edge nor counts as recovery.
BUSY_FILE="${STATE_DIR}/busy"
busy="$(cat "${BUSY_FILE}" 2>/dev/null || echo 0)"
[[ "${busy}" =~ ^[0-9]+$ ]] || busy=0

result="$(probe_state)"
# Sustained saturation IS a fault: nothing has been able to serve a 1-token
# probe for BUSY_GRACE_PROBES cycles, which real jobs cannot survive either
# (the router gives up after ~320s). Escalate to the normal DOWN path rather
# than staying quiet forever — this is what stops "busy" from becoming a mute
# switch. Cleared by any single up or down verdict.
if [[ "${result}" == "busy" ]] && (( BUSY_GRACE_PROBES > 0 && busy + 1 >= BUSY_GRACE_PROBES )); then
  result="down"
fi

case "${result}" in
  up)
    busy=0
    hc_ping   # external deadman OK: brain reachable this cycle (silent-Mac / LXC-down backstop)
    if (( streak < 0 )); then streak=1; else streak=$(( streak + 1 )); fi
    if [[ "${state}" == "down" ]] && (( streak >= UP_AFTER )); then
      cron_do resume
      handle_edge up
      state="up"; streak=0
    else
      reconcile_fleet
    fi
    ;;
  busy)
    # Alive but declining work. Hold state and streak untouched: this is
    # neither evidence of failure nor evidence of recovery.
    busy=$(( busy + 1 ))
    ;;
  *)
    busy=0
    if (( streak > 0 )); then streak=-1; else streak=$(( streak - 1 )); fi
    if [[ "${state}" == "up" ]] && (( streak <= -DOWN_AFTER )); then
      cron_do pause
      handle_edge down
      state="down"; streak=0
    fi
    ;;
esac

printf '%s\n' "${state}" > "${STATE_FILE}"
printf '%s\n' "${streak}" > "${STREAK_FILE}"
printf '%s\n' "${busy}" > "${BUSY_FILE}"
flap_summary_check
exit 0
