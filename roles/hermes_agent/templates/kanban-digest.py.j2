#!/usr/bin/env python3
{{ ansible_managed | comment }}
"""Deterministic, no-LLM master digest of everything the Kanban board did.

STDOUT is delivered verbatim to Slack (cron runs `--no-agent --deliver slack:<ch>`),
so everything printed here must be TRUE. No model sits in the fact path, which is
the point: this digest is what tells the operator the board is wedged, so it has
to keep working when the brain is unloaded, throttled or crash-looping — exactly
the conditions that produce the failures it reports.

It is the MASTER report: one run covers every card that finished, failed, retried,
exited open or overran since the previous run of this same digest. Duplicating it
per workload is what it exists to retire.

SINCE THE PREVIOUS RUN. A schema-versioned state file under the Hermes state
directory carries the last run's wall clock (same location and shape as the
Splunk digests' state). A missing or corrupt state file degrades to the last
INTERVAL_MIN minutes — one scheduling interval — and SAYS SO in the output; it
never crashes and never silently reports nothing.

Source of truth is kanban.db, opened READ-ONLY. `hermes kanban` has no query for
"every run that ended since T": `list --json` carries task rows whose `result`
column is null on all 413 tasks currently on the board, and the per-attempt
outcome and summary live in `runs --json <task_id>`, which takes one task id at a
time. Fanning that out would be one subprocess per card per run. One read-only
SQL query over task_runs is the whole job.

ponytail: read-only sqlite against another program's schema. The ceiling is a
Hermes upgrade renaming a column — which surfaces as an explicit FAILED line
here, never as a quiet empty digest. Upgrade path if that gets annoying: ask
upstream for `kanban runs --since`.
"""
import datetime as dt
import json
import os
import re
import sqlite3
import subprocess
import sys

# --- config (rendered from roles/hermes_agent/defaults/main.yml) ---------------
DB_PATH = "{{ hermes_agent_hermes_home }}/kanban.db"
# Same directory as DB_PATH; read for the board-alarm cap check below.
CONFIG_PATH = "{{ hermes_agent_hermes_home }}/config.yaml"
PROFILES_DIR = "{{ hermes_agent_hermes_home }}/profiles"
# Where worker-failure lines go instead of the work log. Empty disables the
# split entirely and restores the single-post behaviour.
ISSUES_CHANNEL = "{{ hermes_agent_kanban_digest_issues_channel }}"
# Where the "no board activity" heartbeat post goes instead of the work log.
# Empty disables the split and restores the single-post behaviour.
NOISE_CHANNEL = "{{ hermes_agent_kanban_digest_noise_channel }}"
HERMES_BIN = "{{ hermes_agent_bin }}"
# Prefix that tells the cron scheduler this run's own observation path
# failed, so the post is routed to the issues channel instead of the work
# surface. This script exits 0 and prints its failure (so it is delivered
# rather than lost), which the runner reads as success — the marker is how
# it says otherwise. Value comes from Ansible: one definition, two consumers.
ISSUES_MARKER = "{{ hermes_agent_cron_issues_marker }}"
STATE_PATH = "{{ hermes_agent_hermes_home }}/state/{{ hermes_agent_kanban_digest_state_name }}"
TITLE = "{{ hermes_agent_kanban_digest_title }}"
# One scheduling interval. Doubles as the no-state fallback window, so the
# schedule and the fallback can never drift apart — they are the same number.
INTERVAL_MIN = {{ hermes_agent_kanban_digest_interval_minutes }}
# Heartbeat ceiling for the fully-quiet case (nothing completed, failed, retried
# or overran since the previous run). Same gate splunk-status-digest carries: a
# post whose ENTIRE content is "nothing happened" is suppressed until this many
# hours have passed, so silence stays distinguishable from the cron itself being
# dead without spending 96 posts a day saying so. Operator decision 2026-07-28:
# at a 15-minute cadence the quiet branch fired most of those 96 times with
# identical board counts. Real board activity is NEVER subject to this gate — a
# failure, an overrun or a completion posts every run, immediately.
HEARTBEAT_HOURS = {{ hermes_agent_kanban_digest_heartbeat_hours }}
# --- board alarms: board-not-draining, timeout rate, blocked growth ---------
# All three route to the issues channel (send_to_issues) like the failure
# split above, never the work log, and are never heartbeat-suppressed — a
# stalled or growing-blocked board is exactly what "everything looks green"
# means here.
# Consecutive digest ticks of "ready work waiting, nothing finished" before
# alarm (a) fires. Sustained, not single-tick: a single legitimate run can
# span longer than one window, so one quiet tick must never page — only a
# streak of them, long enough that a normal run would have finished by then.
STALL_TICKS_THRESHOLD = {{ hermes_agent_kanban_digest_stall_ticks_threshold }}
# Escalate-then-quiet for alarm (a) once it holds (Vikunja 1853: the same
# stalled-board line 427 ticks in a row). It posts when the streak reaches
# the threshold, again at three times it, then once every STALL_REPEAT_TICKS
# ticks — one reminder a day at the hourly cadence — and posts a loud
# all-clear the first tick the board drains again. Detection is unchanged;
# only the posting cadence is.
STALL_REPEAT_TICKS = 24
# Count of task_runs.outcome == 'timed_out' within one digest window (alarm b).
TIMEOUT_RATE_THRESHOLD = {{ hermes_agent_kanban_digest_timeout_threshold }}
# Rise in the blocked-card count since the previous tick (alarm c) — a delta,
# never the raw count, so a long-standing blocked card does not page forever.
BLOCKED_GROWTH_THRESHOLD = {{ hermes_agent_kanban_digest_blocked_growth_threshold }}
# Bumped when the state shape changes. An older/absent value is treated as no
# usable state, which takes the announced fallback path rather than erroring.
# 2: carries last_post_epoch alongside last_run_epoch for the heartbeat gate.
# stall_ticks/last_blocked_count (alarms a/c) are additive fields under this
# same schema: a state file missing them just starts each counter at 0, which
# needs no fallback note of its own (see load_counters()).
STATE_SCHEMA = 2
# Upstream's `hermes cron` executor skips Slack delivery when a --script cron's
# STDOUT is exactly this string — the same contract the Splunk digests use.
SILENT = "[SILENT]"
# ponytail: presentation calibration, deliberately module constants and not
# Ansible variables — they only mean anything against each other and want tuning
# against real Slack posts, not templating.
# Per-section cap. An overflowing section says how many it did not name.
MAX_ITEMS = 10
# A worker summary is a paragraph; Slack wants a line. Enough to carry the
# finding, not the whole evidence block.
SUMMARY_CHARS = 400
# Every run outcome that is not this one is a failure of some kind.
OK = "completed"
# Where a card is allowed to be once its run ended. Anything else means the run
# stopped but the card did not finish — the "exits open" failure mode.
SETTLED = ("done", "archived")
# A worker that already delivered its own full report to Slack says so in its
# own summary (the report-generating crons all end with some phrasing of this).
# Quoting that summary here would restate the same finding a second time in the
# same 15-minute window — one message from the worker, one from this digest.
# When the summary says the report already went out, point at it instead.
REPORT_ALREADY_POSTED = re.compile(r"report\s+(?:was\s+)?(?:delivered|posted)\s+to\s+slack", re.I)
# Streak length (tasks.consecutive_failures, which already spans every prior
# window — no new state needed) at which a failing card's line switches from
# the plain marker to the same ESCALATING treatment splunk-triage.py.j2 gives a
# worsening error signature: a card still failing on its Nth consecutive tick
# is not new information delivered the same way as its first failure.
ESCALATE_AT = 2

RUNS_SQL = """
SELECT r.task_id, r.outcome, r.started_at, r.ended_at, r.summary, r.error,
       t.title, t.status, t.consecutive_failures, t.max_retries
  FROM task_runs r
  JOIN tasks t ON t.id = r.task_id
 WHERE r.ended_at IS NOT NULL AND r.ended_at > ? AND r.ended_at <= ?
 ORDER BY r.ended_at
"""
# current_run_id pins the ATTEMPT in flight; tasks.started_at is the first
# attempt's start, which would overstate the elapsed time of a retry.
RUNNING_SQL = """
SELECT t.id, t.title, t.max_runtime_seconds, t.last_heartbeat_at,
       COALESCE(r.started_at, t.started_at) AS run_started
  FROM tasks t
  LEFT JOIN task_runs r ON r.id = t.current_run_id
 WHERE t.status = 'running'
"""
BOARD_SQL = "SELECT status, COUNT(*) FROM tasks GROUP BY status"
# Cards that have sat unsettled longer than STUCK_HOURS, by status, with the
# age of the oldest. "Touched" is the newest of the worker heartbeat, the
# start and the creation — the table has no updated_at — so a card nothing
# ever ran ages from its creation. A raw blocked count never changes and so
# never tells anyone anything; "44 blocked, oldest 9d" does.
STUCK_HOURS = 48
STUCK_SQL = """
SELECT status, COUNT(*) AS n,
       MIN(COALESCE(NULLIF(last_heartbeat_at, 0), NULLIF(started_at, 0),
                    NULLIF(created_at, 0))) AS oldest
  FROM tasks
 WHERE status IN ('todo', 'ready', 'blocked', 'in_progress', 'running')
   AND COALESCE(NULLIF(last_heartbeat_at, 0), NULLIF(started_at, 0),
                NULLIF(created_at, 0)) < ?
 GROUP BY status
 ORDER BY status
"""
# Who the ready cards wait on. An assignee that isn't a real profile is bucketed
# `skipped_nonspawnable` silently, every tick — 238 of them in the 2026-08-11 P1,
# while the alarm reported only a concurrency number.
READY_ASSIGNEE_SQL = """
SELECT COALESCE(NULLIF(TRIM(assignee), ''), '') AS assignee, COUNT(*) AS n
  FROM tasks
 WHERE status = 'ready'
 GROUP BY 1
 ORDER BY n DESC, assignee
"""


def fmt_dur(seconds):
    """Duration for prose. None is stated as unknown, never guessed at."""
    if seconds is None:
        return "unknown"
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 5400:
        return f"{seconds // 60}m"
    return f"{seconds / 3600:.1f}h"


def clip(text, limit=SUMMARY_CHARS):
    """One-line, length-capped. Truncation is marked, never silent."""
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def load_state():
    """(since_epoch, last_post_epoch, note).

    `note` is non-empty when the fallback window was used. Missing, unreadable,
    wrong-schema and nonsense-timestamp all take the same announced fallback
    path. A state file from the future (clock step) is not trusted either: it
    would silence the digest until the clock caught up.

    `last_post_epoch` is None when unknown, which makes the heartbeat DUE — an
    unreadable state file must never be able to suppress a post.
    """
    fallback = f"no usable state file — reporting the last {INTERVAL_MIN} min instead"
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None, None, fallback
    if not isinstance(state, dict) or state.get("schema") != STATE_SCHEMA:
        return None, None, fallback
    last = state.get("last_run_epoch")
    if not isinstance(last, (int, float)) or last <= 0:
        return None, None, fallback
    posted = state.get("last_post_epoch")
    if not isinstance(posted, (int, float)) or posted <= 0:
        posted = None
    return float(last), posted, ""


def save_state(now_epoch, last_post_epoch, stall_ticks=0, last_blocked_count=0):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"schema": STATE_SCHEMA, "last_run_epoch": now_epoch,
                   "last_post_epoch": last_post_epoch,
                   "stall_ticks": stall_ticks,
                   "last_blocked_count": last_blocked_count}, f)
    os.replace(tmp, STATE_PATH)


def load_counters():
    """(stall_ticks, blocked_count) baselines for alarms (a) and (c).

    Independent of load_state()'s interval-fallback semantics: these counters
    have no "fallback window" to reason about, so any read failure or missing
    key just resets to 0 — the correct "not alarming yet" starting point for
    both a stall streak and a blocked-count baseline.
    """
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return 0, 0
    if not isinstance(state, dict):
        return 0, 0
    stall = state.get("stall_ticks")
    blocked = state.get("last_blocked_count")
    return (stall if isinstance(stall, int) else 0,
            blocked if isinstance(blocked, int) else 0)


def heartbeat_due(now_epoch, last_post_epoch):
    """Has the quiet-post ceiling elapsed?

    Unknown or future-dated last post => DUE. Erring towards posting is the only
    safe direction: a suppressed heartbeat is indistinguishable from a dead cron,
    which is the exact failure this digest exists to announce.
    """
    if last_post_epoch is None:
        return True
    elapsed_h = (now_epoch - last_post_epoch) / 3600.0
    return elapsed_h < 0 or elapsed_h >= HEARTBEAT_HOURS


def connect(db_path):
    """Read-only handle. mode=ro is enforced by SQLite, not by convention: this
    digest must never be able to mutate the board it reports on."""
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def read_max_in_progress():
    """Configured `kanban.max_in_progress` cap, or None if it cannot be read.

    A regex against config.yaml.j2's single rendered line, not a YAML parser —
    pulling in a YAML dependency to read one integer is not worth it, and the
    line shape (`  max_in_progress: N`) is Ansible's own template, not board
    data that could vary in shape. None (never a guessed number) is what lets
    the stall alarm say the cause is undetermined instead of asserting one.
    """
    try:
        text = open(CONFIG_PATH).read()
    except OSError:
        return None
    match = re.search(r"^\s*max_in_progress:\s*(\d+)\s*$", text, re.M)
    return int(match.group(1)) if match else None


def group_runs(rows):
    """Fold per-attempt rows into one entry per card.

    A card retried three times in the window is one line saying it was retried
    three times, not three lines. Ordering follows the newest attempt.
    """
    by_task = {}
    for row in rows:
        entry = by_task.setdefault(row["task_id"], {
            "title": row["title"], "status": row["status"],
            "consecutive_failures": row["consecutive_failures"],
            "max_retries": row["max_retries"], "attempts": [],
        })
        entry["title"] = row["title"]
        entry["status"] = row["status"]
        entry["attempts"].append(row)
    return by_task


def completed_lines(by_task):
    """Cards that finished, each with enough of its result to be useful."""
    out = []
    for task_id, e in by_task.items():
        wins = [a for a in e["attempts"] if a["outcome"] == OK]
        if not wins:
            continue
        last = wins[-1]
        elapsed = None
        if last["started_at"] and last["ended_at"]:
            elapsed = last["ended_at"] - last["started_at"]
        retried = len(e["attempts"]) - len(wins)
        retry_note = f", after {retried} failed attempt(s)" if retried else ""
        summary_raw = last["summary"] or ""
        if REPORT_ALREADY_POSTED.search(summary_raw):
            summary = "posted its own full report to Slack — see that message"
        else:
            summary = clip(summary_raw) or "(the worker recorded no summary)"
        out.append(f":white_check_mark: *{e['title']}* [{task_id}] "
                   f"{fmt_dur(elapsed)}{retry_note} — {summary}")
    return out


def failed_lines(by_task):
    """Cards whose attempts ended in anything but completion.

    Names the outcomes, the attempt count, the error, and — the failure mode
    this board actually has — where the card was left sitting.
    """
    out = []
    for task_id, e in by_task.items():
        bad = [a for a in e["attempts"] if a["outcome"] != OK]
        if not bad or any(a["outcome"] == OK for a in e["attempts"]):
            continue
        last = bad[-1]
        outcomes = ", ".join(sorted({(a["outcome"] or "unknown") for a in bad}))
        tries = f" x{len(bad)}" if len(bad) > 1 else ""
        # A card that exits open is a known failure mode here: the run stopped
        # and the card never reached a settled column, so nothing retries it and
        # nothing reports it. Saying WHERE it stopped is the actionable half.
        landed = (f"card left *{e['status']}*" if e["status"] not in SETTLED
                  else f"card {e['status']}")
        detail = clip(last["error"] or last["summary"], 200)
        streak = e["consecutive_failures"] or 0
        streak_note = f", {streak} consecutive failures" if streak > 1 else ""
        marker = (":rotating_light: *ESCALATING*" if streak >= ESCALATE_AT else ":x:")
        out.append(f"{marker} *{e['title']}* [{task_id}] {outcomes}{tries}, {landed}"
                   f"{streak_note}" + (f" — {detail}" if detail else ""))
    return out


def overrun_lines(rows, now_epoch):
    """Cards still running past their own max_runtime.

    Unlike the sections above these are NOT window-scoped: an overrun repeats
    every run for as long as it holds, because a card wedged for six hours is
    not stale news. A card with no max_runtime recorded is skipped rather than
    judged against an invented limit.
    """
    out = []
    for row in rows:
        limit, started = row["max_runtime_seconds"], row["run_started"]
        if not limit or not started:
            continue
        elapsed = now_epoch - started
        if elapsed <= limit:
            continue
        beat = row["last_heartbeat_at"]
        beat_note = (f", last heartbeat {fmt_dur(now_epoch - beat)} ago"
                     if beat else ", no heartbeat recorded")
        out.append(f":hourglass: *{row['title']}* [{row['id']}] running "
                   f"{fmt_dur(elapsed)}, past its {fmt_dur(limit)} max_runtime{beat_note}")
    return out


def known_profiles():
    """Assignees the dispatcher can spawn: PROFILES_DIR entries carrying a
    config.yaml, plus the implicit 'default'.

    Scanned, not imported. This script runs as a --no-agent --script cron under
    system python, which cannot import the agent package — an import-based
    lookup returned nothing and silently suppressed the note (measured against
    the deployed script, 2026-08-15). Mirrors the dispatcher's own discovery
    rule; if that rule ever changes, this must follow.
    """
    names = {"default"}
    try:
        for e in os.scandir(PROFILES_DIR):
            if e.is_dir() and os.path.isfile(os.path.join(e.path, "config.yaml")):
                names.add(e.name)
    except OSError:
        return set()
    return names


def unspawnable_note(ready_assignee_rows):
    """Name ready-card assignees the dispatcher won't spawn, or ''."""
    known = known_profiles()
    bad = [(r["assignee"] or "(unassigned)", r["n"])
           for r in ready_assignee_rows if known and (r["assignee"] or "") not in known]
    if not bad:
        return ""
    return (f" {sum(n for _, n in bad)} ready card(s) name a non-profile assignee, "
            f"skipped every tick: {', '.join(f'{a} x{n}' for a, n in bad)}. "
            f"Known: {', '.join(sorted(known))}.")


def stall_alarm(board, run_rows, running_rows, now_epoch, prior_ticks, threshold,
                max_in_progress, ready_assignee_rows=()):
    """(new_streak, alarm_line_or_None) — alarm (a): the board is not draining.

    NOT "nothing is running" — a single wedged run at max_in_progress=1 shows
    running=1 forever and that condition would never fire. The real signal is
    "nothing FINISHED": ready cards are waiting AND no run in this window
    reached ANY terminal outcome. RUNS_SQL already filters to `ended_at IS NOT
    NULL`, so a non-empty run_rows already means something finished — no new
    query, no outcome enum to hardcode. This one condition catches all three
    shapes: nothing running at all, one run wedged forever at the cap, and
    workers churning and failing without the queue moving.

    The streak counts CONSECUTIVE ticks with ready cards and zero finishes;
    anything else resets it to 0, so one busy tick clears the alarm rather
    than requiring a cool-down. Once it fires it repeats every tick while the
    condition holds — like overrun_lines(), a stalled board is not stale news.

    The gateway's own dispatcher warning ("0 workers spawned. Check profile
    health...") has asserted a cause the data does not establish — it fired on
    a configured max_in_progress=1 cap and sent an operator hunting through
    venv and credentials for an hour. This alarm never repeats that mistake:
    when the cap is readable it states the fact (`in_progress N/M`, N being
    the CURRENT running count, useful context either way) and stops there;
    when it is not, it says the cause is undetermined and names the live
    possibilities rather than guessing.

    `running_rows`/`now_epoch` are the same RUNNING_SQL rows overrun_lines()
    already reaches — reused here (no new query) to name how long the oldest
    running occupant has been going, which is what separates "legitimately
    long task" from "wedged" at a glance.
    """
    ready, running = board.get("ready", 0), board.get("running", 0)
    if not (ready > 0 and not run_rows):
        if prior_ticks >= threshold:
            # The alarm was live and the board moved: say so once, loudly.
            return 0, (f":white_check_mark: Board draining again after {prior_ticks} "
                       f"stalled digest tick(s) — {ready} ready, {running} running, "
                       f"{len(run_rows)} run(s) finished this window.")
        return 0, None
    streak = prior_ticks + 1
    if streak < threshold:
        return streak, None
    if streak != threshold and streak != 3 * threshold and streak % STALL_REPEAT_TICKS:
        return streak, None
    if max_in_progress is None:
        cause = ("cause undetermined: could be the configured max_in_progress "
                 "cap, a run that is wedged rather than progressing, or a "
                 "genuine worker spawn failure")
    else:
        cause = f"in_progress {running}/{max_in_progress} (cap)"
    started = [r["run_started"] for r in running_rows if r["run_started"]]
    age_note = f", oldest running {fmt_dur(now_epoch - min(started))}" if started else ""
    line = (f":rotating_light: Stalled board — {ready} ready card(s), {running} "
            f"running but nothing finished{age_note}, for {streak} consecutive "
            f"digest ticks. {cause}."
            f"{unspawnable_note(ready_assignee_rows)}")
    return streak, line


def timeout_alarm(run_rows, threshold):
    """Alarm (b): task-timeout rate. A count over rows RUNS_SQL already fetched
    — no new query — so this is window-scoped like completed/failed, not a
    running streak: a burst of timeouts in one window is worth flagging even
    if the next window is clean.
    """
    count = sum(1 for r in run_rows if r["outcome"] == "timed_out")
    if count < threshold:
        return None
    return (f":alarm_clock: {count} task run(s) timed out in this digest "
            f"window (threshold {threshold}).")


def blocked_growth_alarm(board, prior_blocked, threshold):
    """(new_blocked_count, alarm_line_or_None) — alarm (c): blocked pile-up.

    Alarms on a RISING delta since the previous tick, never the raw count — a
    long-standing blocked card must not page forever, only a fresh pile-up.
    The returned count is always the current board count (alarm or not), so
    the caller has a baseline to persist for the next tick either way.
    """
    current = board.get("blocked", 0)
    delta = current - prior_blocked
    if delta < threshold:
        return current, None
    line = (f":chart_with_upwards_trend: Blocked cards grew by {delta} since "
            f"the previous tick (now {current}, threshold {threshold}).")
    return current, line


def send_to_issues(text):
    """Post `text` to the issues channel. True on success, False on any failure.

    Uses the native sender, which already owns the configured Slack credentials
    — the same path the Kanban card footer instructs workers to use. No token
    handling and no curl here on purpose.

    Never raises: the caller falls back to inlining the text, so a send problem
    degrades the routing rather than losing the failure report.
    """
    if not ISSUES_CHANNEL:
        return False
    try:
        return subprocess.run(
            [HERMES_BIN, "send", "--to", f"slack:{ISSUES_CHANNEL}", "--quiet", text],
            capture_output=True, timeout=30, check=False,
        ).returncode == 0
    except Exception:  # noqa: BLE001 - any failure means "fall back to inline"
        return False


def send_to_noise(text):
    """Post `text` to the noise channel. True on success, False on any failure.

    Same contract as send_to_issues: never raises, caller falls back to
    inlining the text so a send problem degrades routing, not delivery.
    """
    if not NOISE_CHANNEL:
        return False
    try:
        return subprocess.run(
            [HERMES_BIN, "send", "--to", f"slack:{NOISE_CHANNEL}", "--quiet", text],
            capture_output=True, timeout=30, check=False,
        ).returncode == 0
    except Exception:  # noqa: BLE001 - any failure means "fall back to inline"
        return False


def section(lines, heading):
    """Rendered section, capped, honest about what the cap hid."""
    if not lines:
        return []
    shown, extra = lines[:MAX_ITEMS], len(lines) - MAX_ITEMS
    out = ["", f"*{heading} ({len(lines)}):*"] + [f"• {line}" for line in shown]
    if extra > 0:
        out.append(f"• …and {extra} more not shown (cap {MAX_ITEMS}).")
    return out


def stuck_line(stuck_rows, now_epoch):
    """One line naming what has sat unsettled past STUCK_HOURS, or None."""
    parts = []
    for row in stuck_rows:
        status, n, oldest = row[0], row[1], row[2]
        if oldest:
            age_s = now_epoch - float(oldest)
            age = f", oldest {age_s / 86400:.0f}d" if age_s >= 2 * 86400 else f", oldest {fmt_dur(age_s)}"
        else:
            age = ""
        parts.append(f"{n} {status}{age}")
    if not parts:
        return None
    return f":hourglass: Stuck >{STUCK_HOURS}h: " + "; ".join(parts) + "."


def build_digest(run_rows, running_rows, board, now, since, note, due=True,
                 split_failures=False, extra_issue_lines=(), stuck_rows=()):
    """Return (slack_text, issues_text, heartbeat_text).

    slack_text is SILENT when a quiet run is heartbeat-suppressed, and also
    SILENT on the heartbeat-DUE quiet branch (that text moves to
    heartbeat_text instead — see below).

    `due` is the heartbeat verdict and gates ONLY the fully-quiet branch. Any
    real board activity — a completion, a failure, an overrun — returns text
    regardless, because those are the reason the digest exists.

    When `split_failures`, the "Failed / retried / left open" section is peeled
    off into issues_text for the issues channel instead of the work log. Those
    lines are always Hermes' own workers dying (turn-budget exhaustion, judge
    timeouts, max_runtime overruns) — Hermes being broken, not board activity.
    The peel happens BEFORE the heartbeat gate so a run whose only content was
    failures counts as quiet for the work log rather than posting a bare header.

    `extra_issue_lines` carries the already-rendered board-alarm lines (stall,
    timeout rate, blocked growth — computed by the caller in main(), which
    owns the state/config reads those alarms need). Like the failure peel
    above, these land ONLY in issues_text and are never heartbeat-gated: a
    stalled or growing-blocked board is exactly the "everything looks green"
    failure mode this digest exists to catch.

    The "no board activity" heartbeat note (due, nothing else to report) is a
    work log by neither definition above — it belongs on the noise channel
    (heartbeat_text), same split shape as the failure peel.
    """
    now_epoch = now.timestamp()
    span = fmt_dur(now_epoch - since)
    by_task = group_runs(run_rows)
    done = completed_lines(by_task)
    failed = failed_lines(by_task)
    overrun = overrun_lines(running_rows, now_epoch)

    issues_blocks = []
    if split_failures and failed:
        issues_blocks.append("\n".join(
            [f"*{TITLE} — worker failures* — {now.strftime('%Y-%m-%d %H:%M UTC')} "
             f"(since {dt.datetime.fromtimestamp(since, dt.timezone.utc).strftime('%H:%M UTC')}, {span})"]
            + section(failed, "Failed / retried / left open")
        ))
        failed = []
    if extra_issue_lines:
        issues_blocks.append("\n".join(
            [f"*{TITLE} — board alarms* — {now.strftime('%Y-%m-%d %H:%M UTC')}"]
            + [f"• {line}" for line in extra_issue_lines]
        ))
    issues_text = "\n\n".join(issues_blocks)

    # NEVER post a message whose entire content is "nothing happened" unless the
    # heartbeat interval has elapsed. Decided before any text is built so the
    # quiet path cannot leak a header-only post.
    if not (done or failed or overrun) and not due:
        return SILENT, issues_text, ""

    header = (f"*{TITLE}* — {now.strftime('%Y-%m-%d %H:%M UTC')} "
              f"(since {dt.datetime.fromtimestamp(since, dt.timezone.utc).strftime('%H:%M UTC')}, {span})")

    if not (done or failed or overrun):
        # Fully-quiet-but-due: this is the heartbeat itself, not a work-log
        # entry, so it goes to the noise channel instead of `lines` below.
        board_text = ", ".join(f"{v} {k}" for k, v in sorted(board.items())) or "empty"
        heartbeat_lines = [header]
        if note:
            heartbeat_lines.append(f":information_source: {note}.")
        heartbeat_lines.append(
            f":mag: No board activity in the last {span} — no card completed, "
            f"failed, was retried or exceeded its max_runtime. Board holds: "
            f"{board_text}. (heartbeat — quiet runs stay silent for the next "
            f"{HEARTBEAT_HOURS}h unless the board does something)")
        stuck = stuck_line(stuck_rows, now_epoch)
        if stuck:
            heartbeat_lines.append(stuck)
        return SILENT, issues_text, "\n".join(heartbeat_lines)

    lines = [header]
    if note:
        lines.append(f":information_source: {note}.")
    stuck = stuck_line(stuck_rows, now_epoch)
    if stuck:
        lines.append(stuck)

    lines += section(overrun, "Overrunning — repeats every run while it holds")
    lines += section(failed, "Failed / retried / left open")
    lines += section(done, "Completed")

    return "\n".join(lines), issues_text, ""


def main():
    now = dt.datetime.now(dt.timezone.utc)
    now_epoch = now.timestamp()
    # fail loud, never fabricate: a broken read is DELIVERED as a failure, never
    # smoothed into "nothing happened" — silence here would read as a healthy
    # board. State is left untouched so the next run re-covers this window.
    try:
        since, last_post, note = load_state()
        if since is None:
            since = now_epoch - INTERVAL_MIN * 60
        stall_ticks_prior, blocked_prior = load_counters()
        conn = connect(DB_PATH)
        try:
            run_rows = list(conn.execute(RUNS_SQL, (since, now_epoch)))
            running_rows = list(conn.execute(RUNNING_SQL))
            board = {row[0]: row[1] for row in conn.execute(BOARD_SQL)}
            ready_assignee_rows = list(conn.execute(READY_ASSIGNEE_SQL))
            stuck_rows = list(conn.execute(STUCK_SQL, (now_epoch - STUCK_HOURS * 3600,)))
        finally:
            conn.close()

        new_stall, stall_line = stall_alarm(board, run_rows, running_rows, now_epoch,
                                            stall_ticks_prior, STALL_TICKS_THRESHOLD,
                                            read_max_in_progress(),
                                            ready_assignee_rows)
        timeout_line = timeout_alarm(run_rows, TIMEOUT_RATE_THRESHOLD)
        new_blocked, blocked_line = blocked_growth_alarm(
            board, blocked_prior, BLOCKED_GROWTH_THRESHOLD)
        alarms = [line for line in (stall_line, timeout_line, blocked_line) if line]

        text, issues_text, heartbeat_text = build_digest(
            run_rows, running_rows, board, now, since, note,
            heartbeat_due(now_epoch, last_post),
            split_failures=bool(ISSUES_CHANNEL),
            extra_issue_lines=alarms, stuck_rows=stuck_rows)
    except Exception as e:  # noqa: BLE001 - deliberately broad; failure must be delivered
        print(f"{ISSUES_MARKER} :warning: {TITLE} FAILED: {type(e).__name__}: {str(e)[:200]}")
        return 0

    # Failures go to the issues channel. If that send fails for ANY reason the
    # lines are appended to this post instead — a dropped failure report is far
    # worse than one landing on the wrong surface, so the split degrades back to
    # the old inline behaviour rather than losing data.
    if issues_text and not send_to_issues(issues_text):
        text = issues_text if text == SILENT else f"{text}\n\n{issues_text}"

    # Heartbeat goes to the noise channel, same degrade-to-inline contract.
    if heartbeat_text and not send_to_noise(heartbeat_text):
        text = heartbeat_text if text == SILENT else f"{text}\n\n{heartbeat_text}"

    # The window always advances — a suppressed run still covered it, and
    # re-covering it would double-report the next real activity. Only
    # last_post_epoch is held back, and only when nothing was delivered —
    # including a heartbeat that went to the noise channel rather than
    # `text`, or the gate above would never see the next tick as suppressed
    # and the heartbeat would fire every run instead of every HEARTBEAT_HOURS.
    # The two alarm counters always advance too, regardless of what got
    # posted — they track board state across ticks, not delivery.
    delivered = text != SILENT or bool(heartbeat_text)
    save_state(now_epoch, now_epoch if delivered else last_post,
              new_stall, new_blocked)
    print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
