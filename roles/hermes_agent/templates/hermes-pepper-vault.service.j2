{{ ansible_managed | comment }}
[Unit]
Description=Refresh Pepper evidence checkout
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pepper-evidence
Group=pepper-evidence
UMask=0022
EnvironmentFile={{ hermes_agent_proxy_environment_file | mandatory('Prepare Pepper service proxy wiring before the runtime') }}
EnvironmentFile={{ hermes_agent_pepper_vault_env_path }}
Environment="GIT_CONFIG_GLOBAL=/dev/null" "GIT_CONFIG_NOSYSTEM=1" "GIT_TERMINAL_PROMPT=0"
WorkingDirectory={{ hermes_agent_pepper_vault_path | to_json }}
ExecStart={{ hermes_agent_pepper_vault_refresh_script_path }}
NoNewPrivileges=true
PrivateTmp=true
# Authentication must never be emitted by Git into the journal.
StandardOutput=null
StandardError=null
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ hermes_agent_pepper_vault_path | to_json }}
