{{ ansible_managed | comment }}
[Unit]
Description=Refresh Pepper evidence checkout
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pepper-evidence
Group=pepper-evidence
UMask=0022
LoadCredential=git-auth:/etc/hermes-pepper-vault.gitconfig
Environment="GIT_CONFIG_GLOBAL=%d/git-auth" "GIT_CONFIG_NOSYSTEM=1" "GIT_TERMINAL_PROMPT=0"
WorkingDirectory={{ hermes_agent_pepper_vault_path | to_json }}
ExecStart=/usr/bin/git -c core.hooksPath=/dev/null fetch --no-recurse-submodules {{ hermes_agent_pepper_vault_repo_url | to_json }} HEAD
ExecStart=/usr/bin/git -c core.hooksPath=/dev/null merge --ff-only FETCH_HEAD
NoNewPrivileges=true
PrivateTmp=true
# Authentication must never be emitted by Git into the journal.
StandardOutput=null
StandardError=null
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ hermes_agent_pepper_vault_path | to_json }}
