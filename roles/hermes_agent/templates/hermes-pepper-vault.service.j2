{{ ansible_managed | comment }}
[Unit]
Description=Refresh Pepper evidence checkout
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0022
EnvironmentFile=/etc/hermes-pepper-vault.env
WorkingDirectory={{ hermes_agent_pepper_vault_path | to_json }}
ExecStart=/usr/bin/git pull --ff-only
# Authentication must never be emitted by Git into the journal.
StandardOutput=null
StandardError=null
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ hermes_agent_pepper_vault_path | to_json }}
