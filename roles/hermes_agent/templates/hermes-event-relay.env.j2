{{ ansible_managed | comment }}
# Root-only (0600) inputs for hermes-event-relay.service (AppRole secret_id,
# webhook secret). No static queue credentials.
RELAY_QUEUE_SERVICE={{ hermes_agent_event_relay_queue_service }}
RELAY_QUEUE_URL={{ hermes_agent_event_relay_queue_url }}
RELAY_DLQ_URL={{ hermes_agent_event_relay_dlq_url }}
RELAY_QUEUE_REGION={{ hermes_agent_event_relay_queue_region }}
RELAY_BAO_ADDR={{ hermes_agent_event_relay_bao_addr }}
RELAY_BAO_ROLE_ID={{ hermes_agent_event_relay_bao_role_id }}
RELAY_BAO_SECRET_ID={{ hermes_agent_event_relay_bao_secret_id }}
RELAY_BAO_CREDS_PATH={{ hermes_agent_event_relay_bao_creds_path }}
RELAY_WEBHOOK_SECRET={{ hermes_agent_webhook_secret }}
RELAY_TARGET_BASE={{ hermes_agent_event_relay_target_base }}
RELAY_ROUTE_PUBLIC={{ hermes_agent_event_relay_route_public }}
RELAY_ROUTE_PRIVATE={{ hermes_agent_event_relay_route_private }}
RELAY_HEALTHCHECK_URL={{ hermes_agent_event_relay_healthcheck_url }}
RELAY_STATS_SECONDS={{ hermes_agent_event_relay_stats_seconds }}
