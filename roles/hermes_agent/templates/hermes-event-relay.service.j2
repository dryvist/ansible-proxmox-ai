{{ ansible_managed | comment }}
[Unit]
Description=Hermes event relay (queue to local webhook receiver)
After=network-online.target hermes-gateway.service
Wants=network-online.target
StartLimitIntervalSec={{ hermes_agent_unit_restart_interval_sec }}
StartLimitBurst={{ hermes_agent_unit_restart_burst }}
OnFailure=hermes-unit-alert@%n.service

[Service]
Type=simple
DynamicUser=true
EnvironmentFile={{ hermes_agent_event_relay_env_path }}
ExecStart={{ hermes_agent_event_relay_venv }}/bin/python {{ hermes_agent_event_relay_script_path }}
Restart=always
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
