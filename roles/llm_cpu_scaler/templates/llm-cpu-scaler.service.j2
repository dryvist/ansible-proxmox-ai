{{ ansible_managed | comment }}
[Unit]
Description=CPU LLM pool demand scaler (oneshot)
After=network-online.target

[Service]
Type=oneshot
Environment=PROXMOX_API_HOST={{ llm_cpu_scaler_proxmox_api_host }}
EnvironmentFile=-{{ llm_cpu_scaler_cfg.env_file }}
ExecStart={{ llm_cpu_scaler_cfg.install_dir }}/{{ llm_cpu_scaler_cfg.script }} --config {{ llm_cpu_scaler_cfg.config_file }}
